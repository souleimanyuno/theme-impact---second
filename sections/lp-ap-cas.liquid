{{ 'ap-reviews.css' | asset_url | stylesheet_tag }}
{% render 'ap-reviews', section: section, design_mode: request.design_mode, kind: 'photos' %}
<script src="{{ 'ap-reviews.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "AP Avis avec photos",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Ajoutez des blocs Avis pour afficher vos témoignages authentiques. Sans bloc, les contenus existants sont conservés sans notation."
    },
    {
      "type": "text",
      "id": "reviews_heading",
      "label": "Titre des avis",
      "default": "Elles partagent leur expérience"
    },
    {
      "type": "text",
      "id": "average",
      "label": "Note moyenne réelle (facultatif)"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Nombre réel d’avis (facultatif)"
    },
    {
      "type": "url",
      "id": "all_reviews_url",
      "label": "Lien vers tous les avis"
    },
    {
      "type": "header",
      "content": "Contenu existant (sans bloc Avis)"
    },
    {
      "type": "text",
      "id": "t01",
      "label": "Texte existant 01",
      "default": "Tu te reconnais ? Chaque zone a son cercle vicieux."
    },
    {
      "type": "text",
      "id": "t02",
      "label": "Texte existant 02",
      "default": "Tu te détournes dès qu'il approche la main de ton menton, de peur qu'il sente ce qui pique ? La pince n'y peut rien : le signal de pousse continue en dessous."
    },
    {
      "type": "text",
      "id": "t03",
      "label": "Texte existant 03",
      "default": "Menton & mâchoire"
    },
    {
      "type": "text",
      "id": "t04",
      "label": "Texte existant 04",
      "default": "Le SOPK te donne l’impression d’être"
    },
    {
      "type": "text",
      "id": "t05",
      "label": "Texte existant 05",
      "default": "un homme dans un corps de femme"
    },
    {
      "type": "text",
      "id": "t06",
      "label": "Texte existant 06",
      "default": ". Ce n'est pas ta faute : ce sont tes hormones qui envoient le signal de pousse. Le rasoir, lui, ne fait que couper."
    },
    {
      "type": "text",
      "id": "t07",
      "label": "Texte existant 07",
      "default": "Ce que fait Sorelya :"
    },
    {
      "type": "text",
      "id": "t08",
      "label": "Texte existant 08",
      "default": "il agit sur ce signal, à la racine, chaque soir, sans hormones."
    },
    {
      "type": "text",
      "id": "t09",
      "label": "Texte existant 09",
      "default": "Le poil revient plus fin, plus clair, plus lentement."
    },
    {
      "type": "text",
      "id": "t10",
      "label": "Texte existant 10",
      "default": "Lèvre supérieure (SOPK)"
    },
    {
      "type": "text",
      "id": "t11",
      "label": "Texte existant 11",
      "default": "Tu as déjà tout essayé et tu n'y crois plus ? Normal : tout ce que tu as testé agissait en surface. Sorelya, lui, vise la racine du poil."
    },
    {
      "type": "text",
      "id": "t12",
      "label": "Texte existant 12",
      "default": "Jambes & bras"
    },
    {
      "type": "text",
      "id": "t13",
      "label": "Texte existant 13",
      "default": "Short par-dessus le maillot, serviette qu’on ne lâche pas, petits points rouges après chaque rasage ? Le panthénol apaise, la repousse ralentit."
    },
    {
      "type": "text",
      "id": "t14",
      "label": "Texte existant 14",
      "default": "Maillot"
    },
    {
      "type": "text",
      "id": "t15",
      "label": "Texte existant 15",
      "default": "Le laser t’est interdit à cause d’un tatouage ? Sorelya ne chauffe pas et ne brûle pas : il s’applique sur la peau tatouée comme un soin."
    },
    {
      "type": "text",
      "id": "t16",
      "label": "Texte existant 16",
      "default": "Peau tatouée"
    },
    {
      "type": "text",
      "id": "t17",
      "label": "Texte existant 17",
      "default": "Cette « ombre » foncée sur le cou qui revient quelques heures après le rasage ? L’extrait de citron éclaircit les marques, le Cyperus affine la repousse."
    },
    {
      "type": "text",
      "id": "t18",
      "label": "Texte existant 18",
      "default": "Cou & ombre foncée"
    },
    {
      "type": "image_picker",
      "id": "img01",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "img02",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "img03",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "img04",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "img05",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "img06",
      "label": "Image 6"
    }
  ],
  "class": "shopify-section",
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Témoignage authentique"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Signature réelle"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo correspondant au témoignage"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Description de la photo"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Note (0 = ne pas afficher)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0
        },
        {
          "type": "text",
          "id": "source",
          "label": "Provenance (facultatif)"
        },
        {
          "type": "url",
          "id": "source_url",
          "label": "Lien vers la provenance"
        }
      ]
    }
  ],
  "max_blocks": 24
}
{% endschema %}
