<style>
  .thp-s1 * { box-sizing: border-box; margin: 0; padding: 0; }
  .thp-s1 { font-family: 'Inter', -apple-system, sans-serif; color: #000; background: #fff; }
  .thp-s1 h2, .thp-s1 h3, .thp-s1 h4, .thp-s1 h5 { font-family: 'Montserrat', sans-serif; }
  .thp-s1 .blue { color: #2795fe; }

  .thp-bleed {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
  }
  .thp-bleed-wave {
    position: relative;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    line-height: 0;
    display: block;
    margin-top: -1px;
    margin-bottom: -1px;
  }
  .thp-bleed-wave svg {
    display: block;
    width: 100%;
    height: 60px;
  }

  /* Trust strip */
  .thp-mini-strip {
    display: flex; justify-content: center; gap: 24px; flex-wrap: wrap;
    padding: 16px; border-top: 1px solid #eee;
  }
  .thp-mini-item {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; color: #333;
  }
  .thp-mini-ico {
    width: 26px; height: 26px; background: #eef6ff; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; flex-shrink: 0;
  }

  /* Rating */
  .thp-rating { text-align: center; padding: 20px 16px 6px; font-size: 15px; color: #555; }
  .thp-rating .stars { color: #2795fe; font-size: 18px; letter-spacing: 2px; }

  /* Carousel */
  .thp-carousel-inner { overflow: hidden; padding: 24px 0; }
  .thp-carousel-track {
    display: flex; gap: 14px;
    animation: thp-scroll 30s linear infinite;
    width: max-content;
  }
  .thp-carousel-track:hover { animation-play-state: paused; }
  @keyframes thp-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .thp-mini-rev {
    flex-shrink: 0; width: 280px;
    background: #f8f9fa; border-radius: 10px; padding: 16px 18px;
  }
  .thp-mini-rev .rev-stars { color: #2795fe; font-size: 12px; letter-spacing: 1px; margin-bottom: 6px; }
  .thp-mini-rev p { font-size: 13px; line-height: 1.5; color: #333; font-style: italic; margin-bottom: 8px; }
  .thp-mini-rev .rev-who { font-size: 12px; font-weight: 700; color: #000; }
  .thp-mini-rev .rev-who .rev-city { font-weight: 400; color: #999; }
  .thp-mini-rev .rev-badge {
    display: inline-block; background: #eef6ff; color: #2795fe;
    font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 3px; margin-top: 4px;
  }

  /* One size band */
  .thp-onesize-inner {
    background: #000 !important; color: #fff !important;
    padding: 28px 20px; text-align: center;
  }
  .thp-onesize-inner h3 { font-size: 20px; font-weight: 800; color: #fff !important; margin-bottom: 8px; }
  .thp-onesize-inner p { font-size: 14px; color: #aaa !important; line-height: 1.6; max-width: 500px; margin: 0 auto; }
  .thp-onesize-inner strong { color: #2795fe !important; }
  .thp-onesize-pills { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
  .thp-onesize-pill {
    display: flex; align-items: center; gap: 6px;
    background: #111; border: 1px solid #333; padding: 8px 14px; border-radius: 8px;
    font-size: 12px; font-weight: 600; color: #ccc;
  }
  .thp-onesize-pill .ico { font-size: 14px; }

  /* Blue src-section */
  .thp-blue-inner { background: #eef6ff !important; padding: 40px 20px; }

  /* Benefits */
  .thp-benefits { display: flex; justify-content: center; gap: 20px; max-width: 900px; margin: 0 auto; flex-wrap: wrap; }
  .thp-benefit {
    flex: 1; min-width: 240px; max-width: 280px; text-align: center;
    padding: 20px 14px; background: #fff; border-radius: 12px;
  }
  .thp-benefit-icon {
    width: 50px; height: 50px; background: #2795fe; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; margin: 0 auto 12px;
  }
  .thp-benefit h4 { font-size: 15px; font-weight: 800; margin-bottom: 6px; }
  .thp-benefit p { font-size: 13px; line-height: 1.6; color: #555; }

  /* Hook */
  .thp-hook { max-width: 780px; margin: 0 auto; padding: 40px 20px 10px; text-align: center; }
  .thp-eyebrow {
    display: inline-block; background: #eef6ff; color: #2795fe;
    font-family: 'Montserrat', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 6px 16px; border-radius: 20px; margin-bottom: 16px;
  }
  .thp-hook h2 { font-size: clamp(24px, 5vw, 38px); font-weight: 800; line-height: 1.15; margin-bottom: 16px; }
  .thp-hook > p { font-size: 16px; line-height: 1.7; color: #444; max-width: 600px; margin: 0 auto; }

  /* Quote */
  .thp-quote {
    max-width: 680px; margin: 30px auto; padding: 24px 26px;
    background: #f8f9fa; border-left: 4px solid #2795fe; border-radius: 0 10px 10px 0;
    font-size: 16px; line-height: 1.7; color: #333; font-style: italic;
  }
  .thp-quote .author { font-style: normal; font-weight: 700; color: #000; margin-top: 10px; font-size: 14px; }
  .thp-quote .author span { color: #2795fe; font-size: 12px; font-weight: 600; }

  /* Checklist */
  .thp-checks { max-width: 600px; margin: 30px auto; padding: 0 20px; }
  .thp-chk {
    display: flex; align-items: flex-start; gap: 12px; padding: 11px 0;
    border-bottom: 1px solid #f0f0f0; font-size: 15px; line-height: 1.5; color: #333;
  }
  .thp-chk:last-child { border-bottom: none; }
  .thp-chk-ico {
    flex-shrink: 0; width: 22px; height: 22px; background: #2795fe; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; margin-top: 2px;
  }
  .thp-chk-ico svg { width: 12px; height: 12px; }
  .thp-chk strong { color: #000; }
</style>

