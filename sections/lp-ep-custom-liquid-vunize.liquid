  .thp-vs-col { flex: 1; min-width: 280px; border-radius: 14px; overflow: hidden; }
  .thp-vs-hdr { padding: 14px 20px; text-align: center; font-family: 'Montserrat', sans-serif; font-size: 15px; font-weight: 800; }
  .thp-vs-good .thp-vs-hdr { background: #2795fe; color: #fff; }
  .thp-vs-bad .thp-vs-hdr { background: #f0f0f0; color: #888; }
  .thp-vs-body { padding: 6px 0; }
  .thp-vs-good .thp-vs-body { background: #f0f7ff; border: 1px solid #2795fe; border-top: none; border-radius: 0 0 14px 14px; }
  .thp-vs-bad .thp-vs-body { background: #fafafa; border: 1px solid #e8e8e8; border-top: none; border-radius: 0 0 14px 14px; }
  .thp-vs-row { display: flex; align-items: flex-start; gap: 10px; padding: 11px 16px; font-size: 14px; line-height: 1.5; color: #333; }
  .thp-vs-row + .thp-vs-row { border-top: 1px solid rgba(0,0,0,0.04); }
  .thp-vs-ico { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; margin-top: 1px; }
  .thp-vs-good .thp-vs-ico { background: #2795fe; color: #fff; }
  .thp-vs-bad .thp-vs-ico { background: #ddd; color: #999; }

  .thp-guar-inner { background: #eef6ff !important; padding: 40px 20px; }
  .thp-guars { display: flex; justify-content: center; gap: 14px; max-width: 880px; margin: 0 auto; flex-wrap: wrap; }
  .thp-guar { flex: 1; min-width: 180px; max-width: 210px; background: #fff; border-radius: 12px; padding: 22px 16px; text-align: center; }
  .thp-guar-ico { font-size: 28px; margin-bottom: 8px; display: block; }
  .thp-guar h5 { font-size: 14px; font-weight: 800; margin-bottom: 4px; }
  .thp-guar p { font-size: 12px; line-height: 1.5; color: #666; }

  .thp-rev-head { text-align: center; padding: 40px 20px 20px; }
  .thp-rev-head h2 { font-size: clamp(22px, 4vw, 30px); font-weight: 800; }
  .thp-rev-head p { font-size: 14px; color: #888; margin-top: 6px; }
  .thp-revs { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; max-width: 900px; margin: 0 auto; padding: 0 20px 20px; }
  .thp-rev { background: #f8f9fa; border-radius: 12px; padding: 20px 18px; }
  .thp-rev .stars { color: #2795fe; font-size: 13px; letter-spacing: 2px; margin-bottom: 8px; }
  .thp-rev p { font-size: 14px; line-height: 1.6; color: #444; font-style: italic; margin-bottom: 10px; }
  .thp-rev .who { font-size: 13px; font-weight: 700; color: #000; }
  .thp-rev .who span { font-weight: 400; color: #999; font-size: 12px; }

  .thp-cond-inner { background: #000 !important; color: #fff !important; padding: 40px 20px; text-align: center; }
  .thp-cond-inner h3 { font-size: clamp(18px, 3.5vw, 24px); font-weight: 800; margin-bottom: 20px; line-height: 1.3; color: #fff !important; }
  .thp-cond-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 680px; margin: 0 auto; }
  .thp-cond-tag { background: rgba(39,149,254,0.15); color: #2795fe; border: 1px solid rgba(39,149,254,0.3); padding: 8px 16px; border-radius: 8px; font-size: 13px; font-weight: 600; }
</style>

