{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
#Slide-{{ section.id }}-1 .banner__media::after {
          opacity: 0.0;
        }

.color-scheme-{{ section.id }}-{{ section.id }}.color-custom {
          --color-background: 255, 255, 255;
          --gradient-background: #ffffff;
          --color-foreground: 46, 42, 57;
          --color-button: 221, 29, 29;
          --color-button-text: 255, 255, 255;
          --color-base-outline-button-labels: 221, 29, 29;
        }
</style>

<slideshow-component
  class="slider-mobile-gutter mobile-text-below always-display"
  role="region"
  aria-roledescription="Carrousel"
  aria-label="Diaporama sur notre marque"
><div
    class="slideshow banner banner--medium src-grid grid--1-col slider slider--everywhere banner--mobile-bottom"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="false"
    data-speed="5"
  ><style>
        #Slide-{{ section.id }}-1 .banner__media::after {
          opacity: 0.0;
        }
        .color-scheme-{{ section.id }}-{{ section.id }}.color-custom {
          --color-background: 255, 255, 255;
          --gradient-background: #ffffff;
          --color-foreground: 46, 42, 57;
          --color-button: 221, 29, 29;
          --color-button-text: 255, 255, 255;
          --color-base-outline-button-labels: 221, 29, 29;
        }
      </style>
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-1"
        
        role="group"
        aria-roledescription="Diapositive"
        aria-label="1 de 1"
        tabindex="-1"
      >
        <div class="slideshow__media banner__media src-media">
            <img src="{% if section.settings.img01 != blank %}{{ section.settings.img01 | image_url: width: 1400 }}{% else %}{{ 'ap-home-hero.jpg' | asset_url }}{% endif %}" alt="" height="559" loading="eager" fetchpriority="high" class="mobile-hidden">
            
              
              <img src="{% if section.settings.img02 != blank %}{{ section.settings.img02 | image_url: width: 1400 }}{% else %}{{ 'ap-home-hero-mobile.jpg' | asset_url }}{% endif %}" alt="" height="1024" loading="eager" fetchpriority="high" class="desktop-hidden">
            
</div>
        <div class="slideshow__text-wrapper banner__content banner__content--middle-center page-width">
          <div class="slideshow__text banner__box banner--transparent-white content-container content-container--full-width-mobile color-background-1 color-scheme-{{ section.id }}-{{ section.id }} gradient slideshow__text--center slideshow__text-mobile--left"><h2 class="banner__heading h1 title-with-highlight" style='--hightlight-color:#6d388b'>
                {{ section.settings.t01 }}
              </h2><div class="banner__text" >
                <span>{{ section.settings.t02 }}</span>
              </div><div class="banner__buttons">
                <a
                  
                    href="{{ section.settings.lien | default: routes.all_products_collection_url }}"
                  
                  class="src-button button--primary"
                >{{ section.settings.t03 }}</a>
              </div></div>
        </div>
      </div></div></slideshow-component>

