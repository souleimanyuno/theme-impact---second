{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
.section-{{ section.id }}-padding {
    padding-top: 30px;
    padding-bottom: 0px;
  }

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 0px;
    }
}

.section-{{ section.id }}-padding .rating-stars-and-text {
      justify-content: center;
    }

.color-scheme-{{ section.id }}.color-custom {
    --color-background: 255, 255, 255;
    --gradient-background: #ffffff;
    
    --color-foreground: 46, 42, 57;
    --color-button: 221, 29, 29;
    --color-button-text: 255, 255, 255;
    --color-base-outline-button-labels: 221, 29, 29;
  }
</style>

<style data-shopify>.section-{{ section.id }}-padding {
    padding-top: 30px;
    padding-bottom: 0px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 0px;
    }
  }
  
    .section-{{ section.id }}-padding .rating-stars-and-text {
      justify-content: center;
    }
  

  .color-scheme-{{ section.id }}.color-custom {
    --color-background: 255, 255, 255;
    --gradient-background: #ffffff;
    
    --color-foreground: 46, 42, 57;
    --color-button: 221, 29, 29;
    --color-button-text: 255, 255, 255;
    --color-base-outline-button-labels: 221, 29, 29;
  }
  
</style><div class="isolate content-for-grouping animate-section animate--hidden always-display">
  
  <div class="rich-text content-container color-background-1 color-scheme-{{ section.id }} gradient rich-text--full-width content-container--full-width section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--center page-width">
      <div class="rich-text__blocks center animate-item"><h2 class="rich-text__heading rte h1 title-with-highlight" style='--hightlight-color:#6d388b' >
                {{ section.settings.t01 }}
              </h2>
            <div class="rich-text__text rte" >
                <p>{{ section.settings.t02 }}<br/></p>
              </div></div>
    </div>
  </div>
</div>

