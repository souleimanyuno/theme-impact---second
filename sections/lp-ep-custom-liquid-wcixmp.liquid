<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .thp-s2 * { box-sizing: border-box; margin: 0; padding: 0; }
  .thp-s2 { font-family: 'Inter', -apple-system, sans-serif; color: #000; background: #fff; }
  .thp-s2 h2, .thp-s2 h3, .thp-s2 h4, .thp-s2 h5 { font-family: 'Montserrat', sans-serif; }
  .thp-s2 .blue { color: #2795fe; }

  .thp-bleed2 { position: relative; left: 50%; transform: translateX(-50%); width: 100vw; }
  .thp-bleed-wave2 { position: relative; left: 50%; transform: translateX(-50%); width: 100vw; line-height: 0; display: block; margin-top: -1px; margin-bottom: -1px; }
  .thp-bleed-wave2 svg { display: block; width: 100%; height: 60px; }

  .thp-sec-head { text-align: center; max-width: 720px; margin: 0 auto; padding: 50px 20px 24px; }
  .thp-tag2 { display: inline-block; background: #eef6ff; color: #2795fe; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 6px 16px; border-radius: 20px; margin-bottom: 14px; }
  .thp-sec-head h2 { font-size: clamp(24px, 4.5vw, 36px); font-weight: 800; line-height: 1.2; margin-bottom: 12px; }
  .thp-sec-head p { font-size: 15px; line-height: 1.7; color: #555; max-width: 600px; margin: 0 auto; }

  .thp-steps { display: flex; justify-content: center; gap: 16px; max-width: 880px; margin: 20px auto 10px; padding: 0 20px; flex-wrap: wrap; }
  .thp-step { flex: 1; min-width: 250px; max-width: 275px; background: #fff; border: 2px solid #eee; border-radius: 14px; padding: 26px 20px; text-align: center; transition: border-color 0.2s; }
  .thp-step:hover { border-color: #2795fe; }
  .thp-step-num { width: 38px; height: 38px; background: #2795fe; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 16px; margin: 0 auto 12px; }
  .thp-step h4 { font-size: 15px; font-weight: 800; margin-bottom: 6px; }
  .thp-step p { font-size: 13px; line-height: 1.6; color: #555; }

  .thp-mech-inner { background: #000 !important; color: #fff !important; padding: 50px 20px; }
  .thp-mechanism { max-width: 760px; margin: 0 auto; text-align: center; }
  .thp-mechanism h3 { font-size: clamp(20px, 4vw, 30px); font-weight: 800; line-height: 1.25; margin-bottom: 16px; color: #fff !important; }
  .thp-mechanism p { font-size: 15px; line-height: 1.7; color: #aaa !important; max-width: 580px; margin: 0 auto; }
  .thp-stats { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-top: 32px; }
  .thp-stat { text-align: center; }
  .thp-stat-num { font-family: 'Montserrat', sans-serif; font-size: 40px; font-weight: 900; color: #2795fe !important; display: block; }
  .thp-stat-lbl { font-size: 12px; color: #777 !important; margin-top: 4px; line-height: 1.4; }

  .thp-feat-inner { background: #eef6ff !important; padding: 40px 20px 50px; }
  .thp-feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; max-width: 880px; margin: 0 auto; }
  .thp-feat-item { background: #fff; border-radius: 12px; padding: 20px 18px; display: flex; align-items: flex-start; gap: 12px; }
  .thp-feat-ico { flex-shrink: 0; width: 38px; height: 38px; background: #2795fe; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
  .thp-feat-ico svg { width: 18px; height: 18px; }
  .thp-feat-item h5 { font-size: 14px; font-weight: 800; margin-bottom: 3px; }
  .thp-feat-item p { font-size: 13px; line-height: 1.5; color: #555; }

  .thp-disc { text-align: center; font-size: 12px; color: #aaa; max-width: 560px; margin: 0 auto; padding: 20px 20px 40px; line-height: 1.5; }
</style>

