{%- comment -%}Tokens de la page anti-poil (Veluna) : portes a ce seul modele.{%- endcomment -%}
<style>
  body { background: #F4ECFA; }
  .scroll-trigger, [class*="animate--"] { opacity: 1 !important; transform: none !important; }
  #shopify-section-{{ section.id }} { display: none; }
  .shopify-section[id*="__ap_"]:not([id$="__main"]) { background: transparent; }
  [id$="__main"] .product-info__title, [id$="__main"] .product-info .h2 { font-weight: 800; letter-spacing: -0.3px; line-height: 1.1; }
  @media (min-width: 1000px) { [id$="__main"] .product-info__title { font-size: 46px; } }
  [id$="__main"] .product-info__quantity-selector, [id$="__main"] [class*="quantity-selector"] { display: none !important; }
  [id$="__main"] .accordion__toggle, [id$="__main"] .collapsible-toggle { font-weight: 800; font-size: 17px; }
  [id$="__main"] .stock-badge { margin: 4px 0 2px; }
  [id$="__main"] .product-info__block-item[data-block-type="buy-buttons"] .button { border-radius: 10px; }

  /* ===== Échelle commune de la page (2026-10-12) : mobile d'abord =====
     Titres de section : Poppins 700, 24 px (32 px desktop) · titres de carte / d'étape : 17 px (19 px)
     Texte : Barlow 15 px (16 px), comme les 4 bénéfices du haut · espace vertical entre sections : 28 px (48 px) */
  :root { --ap-h2: 24px; --ap-h3: 17px; --ap-body: 15px; --ap-small: 13px; --ap-pad: 22px; --ap-gap: 12px; }
  @media (min-width: 750px) { :root { --ap-h2: 32px; --ap-h3: 19px; --ap-body: 16px; --ap-pad: 40px; --ap-gap: 16px; } }

  /* Titres de section */
  [id*="__ap_titre_"] .rich-text__heading,
  [id$="__ap_avant_apres"] [class*="tabs-heading"] h1,
  [id$="__ap_faq"] .rb-faq-shopify-section > h1,
  [id$="__ap_cas"] .ap-reviews h2 {
    font-family: Poppins, sans-serif !important; font-weight: 700 !important; font-size: var(--ap-h2) !important;
    line-height: 1.22 !important; letter-spacing: 0 !important; margin: 0 0 var(--ap-gap) !important; padding: 0 !important;
  }
  /* Titres de carte / d'étape */
  [id$="__ap_timeline"] .timeline-title, [id$="__ap_mecanisme"] .text-content h3,
  [id$="__ap_avant_apres"] [class*="tabs-title"] {
    font-family: Barlow, sans-serif !important; font-weight: 700 !important; font-size: var(--ap-h3) !important;
    line-height: 1.3 !important; letter-spacing: 0 !important; margin: 0 0 6px !important;
  }
  /* Texte courant : Barlow 15 px, comme les bénéfices */
  [id*="__ap_titre_"] .rich-text__text p, [id$="__ap_timeline"] .timeline-desc, [id$="__ap_mecanisme"] .text-content p,
  [id$="__ap_avant_apres"] [class*="tabs-text"] p, [id$="__ap_cas"] .ap-reviews__copy, [id$="__ap_faq"] .rb-faq-answer p {
    font-family: Barlow, sans-serif !important; font-size: var(--ap-body) !important; line-height: 1.5 !important;
    font-weight: 500 !important; letter-spacing: 0 !important;
  }
  [id$="__ap_comparatif"] .cw-wrapper, [id$="__ap_comparatif"] [class^="cw-"], [id$="__ap_comparatif"] [class*=" cw-"] { font-family: Barlow, sans-serif !important; }
  [id$="__ap_faq"] .rb-faq-question { font-family: Barlow, sans-serif !important; font-size: var(--ap-body) !important; }
  [id$="__ap_cas"] .ap-reviews__author { font-family: Barlow, sans-serif !important; font-size: 14px !important; font-weight: 700 !important; margin-top: 10px !important; }

  /* Espaces : titre collé à son contenu, 28 px (48 px) entre deux blocs */
  [id*="__ap_titre_"] .rich-text.content-container { padding-top: var(--ap-pad) !important; padding-bottom: var(--ap-gap) !important; }
  [id*="__ap_titre_"] .rich-text__text { margin-top: 8px !important; }
  [id$="__ap_timeline"] [class*="-padding"], [id$="__ap_mecanisme"] [class*="-padding"], [id$="__ap_comparatif"] [class*="-padding"] { padding-top: 4px !important; padding-bottom: var(--ap-pad) !important; }
  [id$="__ap_timeline"] .timeline-box { padding-top: 18px !important; padding-bottom: 6px !important; }
  [id$="__ap_timeline"] .timeline-item { margin-bottom: 22px !important; }
  [id$="__ap_timeline"] .timeline-item:last-child { margin-bottom: 0 !important; }
  [id$="__ap_timeline"] .timeline-badge { margin-bottom: 8px !important; }
  [id$="__ap_mecanisme"] .premium-serum-timeline { padding-top: 0 !important; padding-bottom: 0 !important; margin-top: 0 !important; margin-bottom: 0 !important; }
  [id$="__ap_mecanisme"] .timeline-step { padding-bottom: 20px !important; }
  [id$="__ap_mecanisme"] .timeline-step:last-child { padding-bottom: 0 !important; }
  [id$="__ap_comparatif"] .cw-header { margin-bottom: 16px !important; }
  [id$="__ap_banniere"] .banner__box { display: none !important; }
  [id$="__ap_banniere"] .banner, [id$="__ap_banniere"] .slideshow { margin-bottom: 0 !important; }
  [id$="__ap_banniere"] .shopify-section, [id$="__ap_banniere"] > * { padding-bottom: 0 !important; }
  [id$="__ap_cas"] .ap-reviews { padding: var(--ap-pad) 0 !important; }
  [id$="__ap_cas"] .ap-reviews__track { padding-bottom: 8px !important; }
  [id$="__ap_cas"] .ap-reviews--photos .ap-reviews__card { padding: 12px 12px 16px !important; }
  [id$="__ap_cas"] .ap-reviews__image { margin-bottom: 12px !important; }
  [id$="__ap_avant_apres"] > [class*="section"] { padding-top: 0 !important; padding-bottom: 0 !important; }
  [id$="__ap_avant_apres"] [class*="-settings"] { padding-top: var(--ap-pad) !important; padding-bottom: var(--ap-pad) !important; }
  [id$="__ap_avant_apres"] [class*="tabs-text"] { margin-top: 10px !important; }
  [id$="__ap_avant_apres"] [class*="tabs-tabs-wrapper"] { margin-top: 14px !important; }
  [id$="__ap_avant_apres"] [class*="tabs-content"] { margin-top: 16px !important; }
  [id*="__ap_video_"] .sp-sa-video { padding-top: 0 !important; padding-bottom: var(--ap-pad) !important; }
  [id$="__ap_faq"] .rb-faq-shopify-section { margin-bottom: var(--ap-pad) !important; }
  [id$="__ap_faq"] .rb-faq-shopify-section > h1 { padding-top: var(--ap-pad) !important; }
  [id$="__ap_cta"] [class*="-padding"] { padding-top: var(--ap-pad) !important; padding-bottom: var(--ap-pad) !important; }
  [id$="__ap_garantie"] [class*="-padding"] { padding-top: 8px !important; padding-bottom: var(--ap-pad) !important; }
  [id$="__ap_garantie"] [class*="-padding"] > div { padding-top: 16px !important; padding-bottom: 16px !important; }

  /* priorités : le titre de l'onglet avant/après reste un titre ; paragraphes serrés */
  [id$="__ap_avant_apres"] p[class*="tabs-title"] { font-family: Barlow, sans-serif !important; font-weight: 700 !important; font-size: var(--ap-h3) !important; line-height: 1.3 !important; margin: 0 0 6px !important; }
  [id$="__ap_avant_apres"] [class*="tabs-text"] p { margin: 0 0 6px !important; }
  [id$="__ap_cas"] .ap-reviews { background: transparent !important; }
</style>
{% schema %}
{ "name": "AP Tokens", "settings": [] }
{% endschema %}
