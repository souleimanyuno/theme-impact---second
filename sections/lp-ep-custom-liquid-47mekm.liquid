  </div>

  <div class="thp-photo-grid-wrap">
    <div class="thp-photo-grid">

      {%- if section.settings.t05 != blank -%}<div class="thp-photo-card">
        {%- if section.settings.img01 != blank -%}<img src="{{ section.settings.img01 | image_url: width: 1400 }}" alt="Cliente Triple Th&#233;rapie Sorelya" loading="lazy">{%- endif -%}
        <div class="thp-photo-card-body">
          <div class="card-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <div class="card-quote">{{ section.settings.t05 }}</div>
          <div class="card-name">{{ section.settings.t06 }} <span class="card-city">{{ section.settings.t07 }}</span></div>
          <span class="card-badge">{{ section.settings.t08 }}</span>
        </div>
