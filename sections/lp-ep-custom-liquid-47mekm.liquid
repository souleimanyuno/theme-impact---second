  <!-- SORELYA EPAULE : SEZIONE CLIENTI SODDISFATTI (GRIGLIA STATICA) -->

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .thp-social * { box-sizing: border-box; margin: 0; padding: 0; }
  .thp-social { font-family: 'Inter', -apple-system, sans-serif; color: #000; background: #fff; }
  .thp-social h2, .thp-social h3 { font-family: 'Montserrat', sans-serif; }
  .thp-social .blue { color: #2795fe; }

  .thp-social-header {
    position: relative; left: 50%; transform: translateX(-50%); width: 100vw;
    background: #EDF6FC !important; padding: 32px 20px 24px; text-align: center;
  }
  .thp-social-header .thp-social-tag {
    display: inline-block; background: #fff; color: #2795fe;
    font-family: 'Montserrat', sans-serif;
    font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;
    padding: 5px 14px; border-radius: 20px; margin-bottom: 12px;
  }
  .thp-social-header h2 {
    font-size: clamp(22px, 5vw, 32px); font-weight: 900;
    color: #000 !important; line-height: 1.2; margin-bottom: 6px;
  }
  .thp-social-header p { font-size: 14px; color: #555 !important; }
  .thp-social-header .stars-row { color: #2795fe; font-size: 20px; letter-spacing: 3px; margin-bottom: 8px; }

  .thp-photo-grid-wrap {
    position: relative; left: 50%; transform: translateX(-50%); width: 100vw;
    background: #EDF6FC !important;
    padding: 0 20px 32px;
  }
  .thp-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .thp-photo-card {
    background: #fff !important;
    border-radius: 14px; overflow: hidden;
    border: 1px solid #dce8f0;
    transition: border-color 0.3s;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .thp-photo-card:hover { border-color: #2795fe; }
  .thp-photo-card img {
    width: 100%; height: 260px;
    object-fit: cover; display: block;
  }
  .thp-photo-card-body { padding: 14px 16px 18px; }
  .thp-photo-card-body .card-stars { color: #2795fe; font-size: 13px; letter-spacing: 2px; margin-bottom: 6px; }
  .thp-photo-card-body .card-quote {
    font-size: 13px; line-height: 1.5; color: #333 !important;
    font-style: italic; margin-bottom: 10px; min-height: 40px;
  }
  .thp-photo-card-body .card-name { font-size: 12px; font-weight: 700; color: #000 !important; }
  .thp-photo-card-body .card-city { font-weight: 400; color: #999 !important; }
  .thp-photo-card-body .card-badge {
    display: inline-block; background: rgba(39,149,254,0.15);
    color: #2795fe; font-size: 10px; font-weight: 700;
    padding: 2px 8px; border-radius: 4px; margin-top: 6px;
  }
</style>

{%- if section.settings.t05 != blank or section.settings.t09 != blank or section.settings.t12 != blank or section.settings.t15 != blank -%}
