          <div class="card-name">{{ section.settings.t13 }} <span class="card-city">{{ section.settings.t14 }}</span></div>
          <span class="card-badge">{{ section.settings.t08 }}</span>
        </div>
      </div>{%- endif -%}

      {%- if section.settings.t15 != blank -%}<div class="thp-photo-card">
        {%- if section.settings.img04 != blank -%}<img src="{{ section.settings.img04 | image_url: width: 1400 }}" alt="Cliente Triple Th&#233;rapie Sorelya" loading="lazy">{%- endif -%}
        <div class="thp-photo-card-body">
          <div class="card-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <div class="card-quote">{{ section.settings.t15 }}</div>
          <div class="card-name">{{ section.settings.t16 }} <span class="card-city">{{ section.settings.t17 }}</span></div>
          <span class="card-badge">{{ section.settings.t08 }}</span>
        </div>
      </div>{%- endif -%}

    </div>
  </div>

</div>
