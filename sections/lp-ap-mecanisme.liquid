<style>
:root {
  --brand-accent: #A855F7;
  --brand-bg: #F4ECFA;
  --brand-text: #2d2d2d; /* Etwas weicheres Schwarz f\fc r Eleganz */
}

.premium-serum-timeline {
  max-width: 650px;
  margin: 20px auto;
  padding: 40px 20px;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background-color: var(--brand-bg);
  border-radius: 20px;
}

.timeline-step {
  display: flex;
  position: relative;
  padding-bottom: 40px; /* Abstand zwischen den Schritten */
}

/* Letzter Schritt braucht kein Padding nach unten */
.timeline-step:last-child {
  padding-bottom: 0;
}

/* Die feine Verbindungslinie */
.timeline-step::before {
  content: '';
  position: absolute;
  left: 26px; /* Exakt die Mitte der 52px breiten Icons */
  top: 52px;  /* Startet genau unter dem Icon */
  bottom: 0;  /* Geht bis zum Ende des Steps */
  width: 1px; /* Sehr d\fc nne, elegante Linie */
  background-color: var(--brand-accent);
  opacity: 0.4; /* Leicht transparent wie im Bild */
  z-index: 1;
}

/* Keine Linie nach dem letzten Icon */
.timeline-step:last-child::before {
  display: none;
}

.icon-column {
  margin-right: 20px;
  position: relative;
  z-index: 2; /* Icon liegt \dc BER der Linie */
}

.step-icon {
  width: 52px;
  height: 52px;
  background-color: #ffffff;
  border: 1.5px solid var(--brand-accent); /* D\fc nnerer Rahmen */
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-accent);
  /* Box-Shadow ENTFERNT f\fc r den "Clean" Look */
}

.text-content {
  flex: 1;
  padding-top: 3px; /* Minimal nach unten ger\fc ckt f\fc r perfekte Zentrierung zum Icon */
}

.text-content h3 {
  font-size: 19px; 
  color: var(--brand-accent);
  margin: 0 0 6px 0;
  font-weight: 700;
  line-height: 1.3;
}

.text-content p {
  font-size: 15px;
  line-height: 1.6; /* Mehr Zeilenabstand macht es lesbarer und luftiger */
  color: var(--brand-text);
  margin: 0;
}

.text-content strong {
  color: #000; /* Hebt die Inhaltsstoffe dezent hervor */
  font-weight: 700;
}

@media (max-width: 480px) {
  .premium-serum-timeline { padding: 30px 15px; }
  .step-icon { width: 46px; height: 46px; }
  .timeline-step::before { left: 23px; top: 46px; } /* Linie an neues Icon anpassen */
  .text-content h3 { font-size: 17px; }
  .text-content p { font-size: 14px; }
}
</style>
