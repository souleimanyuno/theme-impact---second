{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
}
</style>

<style data-shopify>.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
  }</style><div class="color-background-1 gradient content-for-grouping always-display">
  
  <div class="section-{{ section.id }}-padding">
    <style>
  /* Container und Allgemeine Settings */
  .timeline-box {
    background-color: #F4ECFA; /* Dein helllila Hintergrund (optional, falls gew\fc nscht) */
    padding: 30px 20px;
    max-width: 800px;
    margin: 0 auto;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    color: #1a1a1a;
    box-sizing: border-box;
    /* Damit das Bild unten b\fc ndig abschlie\df t */
    overflow: hidden; 
    border-radius: 10px; /* Runde Ecken f\fc r die ganze Box */
  }

  /* Die Timeline Struktur */
  .timeline-container {
    position: relative;
    padding-left: 80px;
    /* WICHTIG: Padding unten wegnehmen, damit die Linie bis zum Bild geht */
    padding-bottom: 0; 
  }

  /* Die durchgehende Linie (Hintergrund) */
  .timeline-container::before {
    content: '';
    position: absolute;
    left: 28.5px;
    top: 10px;
    /* HIER GE\c4 NDERT: Linie viel l\e4 nger gemacht */
    bottom: -100px; 
    width: 3px;
    background: #A855F7;
    opacity: 0.6;
    z-index: 1;
  }

  /* Einzelnes Item */
  .timeline-item {
    position: relative;
    margin-bottom: 50px;
  }

  .timeline-item:last-child {
    /* Letztes Item braucht weniger Abstand nach unten */
    margin-bottom: 20px;
  }

  /* DER PUNKT */
  .timeline-item::after {
    content: '';
    position: absolute;
    left: -62px; 
    top: 2px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 5px solid #A855F7;
    z-index: 5;
    box-sizing: border-box;
    animation: glowing-pulse 2s infinite;
  }

  @keyframes glowing-pulse {
    0% { box-shadow: 0 0 0 0px rgba(168, 85, 247, 0.8); }
    70% { box-shadow: 0 0 0 15px rgba(168, 85, 247, 0); }
    100% { box-shadow: 0 0 0 0px rgba(168, 85, 247, 0); }
  }

  .timeline-badge {
    display: inline-block;
    background-color: #A855F7;
    color: #ffffff;
    font-size: 15px;
    font-weight: 900;
    padding: 8px 18px;
    border-radius: 50px;
    margin-bottom: 12px;
    box-shadow: 0 2px 5px rgba(168, 85, 247, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .timeline-title {
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 10px 0;
    line-height: 1.3;
    color: #000;
  }

  .timeline-desc {
    font-size: 16px;
    line-height: 1.6;
    color: #333;
    margin: 0;
  }

  /* --- NEU: Das Bild Styling --- */
  .timeline-footer-image {
    /* Negative Margins ziehen das Bild \fc ber das Padding der Box */
    margin-left: -20px;
    margin-right: -20px;
    margin-bottom: -35px; /* Zieht es ganz nach unten */
    margin-top: 30px;
    position: relative;
    z-index: 2; /* Bild liegt \fc ber der Linie, falls sie zu lang ist */
  }

  .timeline-footer-image img {
    width: 100%;
    display: block;
    /* Damit das Bild die runden Ecken der Box \fc bernimmt */
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
  }

  /* Responsive Anpassungen */
  @media (max-width: 600px) {
    .timeline-container { padding-left: 60px; }
    .timeline-container::before { left: 24px; width: 2px; }
    .timeline-item::after { left: -45px; width: 20px; height: 20px; border-width: 4px; }
    .timeline-badge { font-size: 13px; padding: 6px 14px; }
    .timeline-title { font-size: 18px; }
  }
</style>

