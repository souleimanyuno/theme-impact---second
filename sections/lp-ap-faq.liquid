  <style data-shopify>

    .rb-faq-shopify-section {
      padding-right:30px;
      padding-left:30px;
      margin-bottom:50px
    }

    .rb-faq-container {
        margin:auto;
        max-width:1000px;
    }

    .rb-faq-container-item {
          border-radius: 8px;
          margin-bottom:10px;
          overflow: hidden;
    }

    .rb-faq-question::after{
          color: #ffffff;
          content: '\276F';
          transition: all 0.2s ease;
      }

    .rb-faq-question {
        border-radius: 8px;
        display:flex !important;
        justify-content: space-between;
        background-color:#a855f7;
        padding:15px 20px;
        font-weight: bold;
        color: #ffffff;
        font-size: 15px;
    }

    .rb-faq-question:hover {
          color: #efefef;
      }
    .rb-faq-answer {
          padding: 0px 20px;
          position: relative;
          width: 100%;
          height: 0;
          opacity: 0;
          overflow: hidden;
          visibility: hidden;
          will-change: height;
          transform: translateY(25px);
          transition: all .2s ease;
          -webkit-backface-visibility: hidden;
          backface-visibility: hidden;
    }
    .tab-toggle:checked ~ .rb-faq-answer {
      transform: translateY(0);
      padding: 15px 20px;
      height:auto;
      opacity: 1;
      overflow: unset;
      visibility: visible;
      transition: all .3s ease,opacity 1s ease,height .3s ease;
      color: #000000;
      background-color: #ffffff;
    }
    .tab-toggle:checked ~ .rb-faq-question::after {
          transform: rotate(90deg);
    }
    .tab-toggle{
          display:none;
    }
  </style>

<style>
/* css-applique : regles de la source */
#shopify-section-{{ section.id }} .rb-faq-shopify-section, #shopify-section-{{ section.id }}:is(.rb-faq-shopify-section) { padding-right: 30px; padding-left: 30px; margin-bottom: 50px; }
#shopify-section-{{ section.id }} .rb-faq-container, #shopify-section-{{ section.id }}:is(.rb-faq-container) { margin: auto; max-width: 1000px; }
#shopify-section-{{ section.id }} .rb-faq-container-item, #shopify-section-{{ section.id }}:is(.rb-faq-container-item) { border-radius: 8px; margin-bottom: 10px; overflow: hidden; }
#shopify-section-{{ section.id }} .rb-faq-question::after { color: rgb(255, 255, 255); content: "\276f "; transition: 0.2s; }
#shopify-section-{{ section.id }} .rb-faq-question, #shopify-section-{{ section.id }}:is(.rb-faq-question) { border-radius: 8px; justify-content: space-between; background-color: rgb(168, 85, 247); padding: 15px 20px; font-weight: bold; color: rgb(255, 255, 255); font-size: 15px; display: flex !important; }
#shopify-section-{{ section.id }} .rb-faq-question:hover, #shopify-section-{{ section.id }}:is(.rb-faq-question:hover) { color: rgb(239, 239, 239); }
#shopify-section-{{ section.id }} .rb-faq-answer, #shopify-section-{{ section.id }}:is(.rb-faq-answer) { padding: 0px 20px; position: relative; width: 100%; height: 0px; opacity: 0; overflow: hidden; visibility: hidden; will-change: height; transform: translateY(25px); transition: 0.2s; backface-visibility: hidden; }
#shopify-section-{{ section.id }} .tab-toggle:checked ~ .rb-faq-answer, #shopify-section-{{ section.id }}:is(.tab-toggle:checked ~ .rb-faq-answer) { transform: translateY(0px); padding: 15px 20px; height: auto; opacity: 1; overflow: unset; visibility: visible; transition: 0.3s, opacity 1s, height 0.3s; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255); }
#shopify-section-{{ section.id }} .tab-toggle:checked ~ .rb-faq-question::after { transform: rotate(90deg); }
#shopify-section-{{ section.id }} .tab-toggle, #shopify-section-{{ section.id }}:is(.tab-toggle) { display: none; }
</style>
