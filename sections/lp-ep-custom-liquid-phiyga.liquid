<style>
  .thp-s4 * { box-sizing: border-box; margin: 0; padding: 0; }
  .thp-s4 { font-family: 'Inter', -apple-system, sans-serif; color: #000; background: #fff; }
  .thp-s4 h2, .thp-s4 h3, .thp-s4 h4, .thp-s4 h5 { font-family: 'Montserrat', sans-serif; }
  .thp-s4 .blue { color: #2795fe; }

  .thp-bleed4 { position: relative; left: 50%; transform: translateX(-50%); width: 100vw; }
  .thp-bleed-wave4 { position: relative; left: 50%; transform: translateX(-50%); width: 100vw; line-height: 0; display: block; margin-top: -1px; margin-bottom: -1px; }
  .thp-bleed-wave4 svg { display: block; width: 100%; height: 60px; }

  .thp-tag4 { display: inline-block; background: #eef6ff; color: #2795fe; font-family: 'Montserrat', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 6px 16px; border-radius: 20px; margin-bottom: 14px; }

  .thp-faq-wrap { max-width: 720px; margin: 0 auto; padding: 40px 20px 50px; }
  .thp-faq-head { text-align: center; margin-bottom: 28px; }
  .thp-faq-item { border-bottom: 1px solid #e8e8e8; }
  .thp-faq-q { width: 100%; background: none; border: none; padding: 18px 40px 18px 0; font-family: 'Montserrat', sans-serif; font-size: 15px; font-weight: 700; color: #000; text-align: left; cursor: pointer; position: relative; line-height: 1.4; }
  .thp-faq-q:hover { color: #2795fe; }
  .thp-faq-q::after { content: '+'; position: absolute; right: 0; top: 50%; transform: translateY(-50%); font-size: 22px; font-weight: 400; color: #2795fe; }
  .thp-faq-item.open .thp-faq-q::after { content: '&#8722;'; }
  .thp-faq-a { max-height: 0; overflow: hidden; transition: max-height 0.3s ease, padding 0.3s ease; }
  .thp-faq-item.open .thp-faq-a { max-height: 500px; padding-bottom: 18px; }
  .thp-faq-a p { font-size: 14px; line-height: 1.7; color: #555; }
  .thp-faq-a p + p { margin-top: 8px; }

  .thp-cta-inner { background: #eef6ff !important; padding: 60px 20px; text-align: center; }
  .thp-cta-inner h2 { font-size: clamp(24px, 5vw, 36px); font-weight: 900; line-height: 1.2; margin-bottom: 14px; }
  .thp-cta-inner p { font-size: 16px; color: #555; line-height: 1.6; max-width: 540px; margin: 0 auto 28px; }
  .thp-cta-btn { display: inline-block; background: #2795fe; color: #fff !important; font-family: 'Montserrat', sans-serif; font-size: 16px; font-weight: 800; padding: 16px 48px; border-radius: 10px; text-decoration: none !important; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 16px rgba(39,149,254,0.3); transition: background 0.2s, transform 0.1s; }
  .thp-cta-btn:hover { background: #1a7de0; transform: translateY(-1px); text-decoration: none !important; }
  .thp-sub-cta { margin-top: 16px; font-size: 13px; color: #888; }
  .thp-sub-cta strong { color: #2795fe; }

  .thp-bot-trust { display: flex; justify-content: center; gap: 28px; flex-wrap: wrap; padding: 28px 20px; }
  .thp-bot-item { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #555; }
  .thp-bot-ico { width: 30px; height: 30px; background: #eef6ff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 15px; }
  .thp-final { text-align: center; padding: 20px 20px 40px; }
  .thp-final p { font-family: 'Montserrat', sans-serif; font-size: 17px; font-weight: 800; line-height: 1.5; }
  .thp-final .sub { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 400; color: #999; margin-top: 6px; }
</style>

