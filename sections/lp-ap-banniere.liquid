{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
#Banner-{{ section.id }}::after {
    opacity: 0.0;
  }
</style>

<style data-shopify>#Banner-{{ section.id }}::after {
    opacity: 0.0;
  }</style>

  <div
    id="Banner-{{ section.id }}"
    class="banner banner--content-align-center banner--content-align-mobile-center banner--medium banner--mobile-bottom content-for-grouping always-display"
  ><div class="banner__media src-media always-display"><img src="{% if section.settings.img01 != blank %}{{ section.settings.img01 | image_url: width: 1400 }}{% else %}{{ 'ap-banniere-duo.webp' | asset_url }}{% endif %}" alt="" width="2048" height="2048.0" loading="lazy">
      </div><div class="banner__content banner__content--middle-center page-width">
      <div class="banner__box banner--transparent-white content-container content-container--full-width-mobile color-background-1 gradient"></div>
    </div>
  </div>

