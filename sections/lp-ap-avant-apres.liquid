{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
.section-{{ section.id }} {
    border-top: solid #000000 0px;
    border-bottom: solid #000000 0px;
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 0px;
    margin-right: 0px;
    border-radius: 0px;
    overflow: hidden;
  }

.section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: 27px;
    padding-bottom: 27px;
    padding-left: 15px;
    padding-right: 15px;
  }

.tabs-heading-{{ section.id }} {
    text-align: center;
  }

.tabs-heading-{{ section.id }} * {
    margin: 0px;
    font-size: 36px;
    color: #000000;
    line-height: 130%;
    text-transform: unset;
    word-wrap: break-word;
    font-weight: 700;
  }

.tabs-tabs-wrapper-{{ section.id }} {
    max-width: 320px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    display: flex;
    align-items: center;
    margin-top: 24px;
    border-radius: 100px;
    border: 2px solid #000000;
    height: 54px;
  }

.tabs-tab-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    margin: 0;
    flex: 1;
    text-transform: unset;
    word-wrap: break-word;
    font-size: 14px;
    line-height: 100%;
    color: #000000;
    cursor: pointer;
    position: relative;
    z-index: 2;
    transition: all 0.25s ease 0s;
  }

.tabs-tab-{{ section.id }}.active {
    color: #ffffff;
    transition: all 0.25s ease 0s;
  }

.tabs-active-bg-{{ section.id }} {
    display: block !important;
    position: absolute;
    width: calc((100% / 3) + 4px);
    height: 100%;
    border-radius: 100px;
    top: 0;
    background: #a855f7;
    z-index: 1;
    margin-left: -2px;
    transition: all 0.5s ease 0s;
  }

.tabs-content-{{ section.id }} {
    display: none;
    margin-top: 30px;   
    grid-template-columns: 1fr;
    align-items: center;
    gap: 30px;
  }

.tabs-content-{{ section.id }}.active {
    display: grid;  
  }

.tabs-title-{{ section.id }} {
    margin: 0;    
    text-align: left;
    text-transform: unset;
    word-wrap: break-word;
    font-size: 24px;
    line-height: 130%;
    color: #000000;
    font-weight: 700;
  }

.tabs-subtext-{{ section.id }} {
    text-align: left;
    margin-top: 10px;    
  }

.tabs-subtext-{{ section.id }} * {
    margin: 0;    
    text-transform: unset;
    word-wrap: break-word;
    font-size: 20px;
    line-height: 130%;
    color: #b3b3b3;  
  }

.tabs-text-{{ section.id }} {
    text-align: left;
    margin-top: 30px;    
  }

.tabs-text-{{ section.id }} * {
    margin: 0;    
    text-transform: unset;
    word-wrap: break-word;
    font-size: 18px;
    line-height: 150%;
    color: #000000;  
  }

.tabs-button-{{ section.id }} {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid #ffffff;
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    box-shadow: rgba(0, 0, 0, 0.35) 0px 0px 7px;
    display: flex !important;
    align-items: center;
    justify-content: center;
    z-index: 3;
    position: relative;
  }

.tabs-button-{{ section.id }}::after {
    content: '';
    padding: 3px;
    display: inline-block;
    border: solid ;
    border-width: 0 2px 2px 0;
    transform: rotate(-45deg) scale(100%) translateY(-50%);
  }

.tabs-button-{{ section.id }}::before {
    content: '';
    padding: 3px;
    display: inline-block;
    border: solid ;
    border-width: 0 2px 2px 0;
    transform: rotate(135deg) scale(100%) translateX(-50%);
  }

.tabs-button-{{ section.id }}:before {
    content: '';
    height: calc(50% - 28px);
    top: 50%;
    left: 15%;
    width: 3px;
    color: #ffffff;
    z-index: -1;
    position: absolute;
  }

.tabs-button-{{ section.id }}:after {
    content: '';
    height: calc(50% - 28px);
    top: 50%;
    right: 15%;
    width: 3px;
    color: #ffffff;
    z-index: -1;
    position: absolute;
  }

.tabs-image-relative-{{ section.id }} {
    position: relative;
    height: 100%;
  }

.tabs-image-relative-{{ section.id }} img,
  .tabs-image-relative-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

.tabs-image-relative-{{ section.id }} svg {
    background-color: #AFAFAF;
  }

.tabs-image-wrapper-{{ section.id }} {    
    position: relative;
    border: 0px solid #000000;  
    border-radius: 0px;
    --text-primary: 26 26 26;
    --shadow: 0 5px 15px rgb(var(--text-primary) / 0.1);
    filter: drop-shadow(var(--shadow));
    user-select: none;
    overflow: hidden;
  }

.tabs-image-cursor-{{ section.id }} {
    height: 100%;
    width: max-content;
    touch-action: none;
    --transform-logical-flip: 1;
    transform: translate(calc(var(--transform-logical-flip) * -50% + var(--clip-path-offset, 0px)),-50%);
    cursor: grab;
    will-change: transform;
    place-items: center;
    display: grid;
    position: relative;
    top: 50%;
    left: var(--before-after-initial-drag-position, 0px);
  }

.tabs-image-cursor-{{ section.id }}:before {
    content: '';
    height: calc(50% - 28px);
    top: 0;
    width: 2px;
    background: #ffffff;
    z-index: -1;
    position: absolute;
  }

.tabs-image-cursor-{{ section.id }}:after {
    content: '';
    height: calc(50% - 28px);
    bottom: 0;
    width: 2px;
    background: #ffffff;
    z-index: -1;
    position: absolute;
  }

.tabs-before-badge-{{ section.id }},
  .tabs-after-badge-{{ section.id }} {
    position: absolute;
    top: 10px;
    padding: 10px 16px;
    border-radius: 0px;
    background-color: rgba(0,0,0,0.4);
    margin: 0;    
    text-align: center;
    text-transform: unset;
    word-wrap: break-word;
    font-size: 14px;
    line-height: 100%;
    color: #ffffff;  
  }

.tabs-before-badge-{{ section.id }} {
    left: 10px;
  }

.tabs-after-badge-{{ section.id }} {
    right: 10px;
  }

.tabs-media-text-{{ section.id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
  }

.tabs-media-text-{{ section.id }} * {
    margin: 0;    
    text-align: center;
    text-transform: unset;
    word-wrap: break-word;
    font-size: 12px;
    line-height: 150%;
    color: #ffffff;  
  }

@media(min-width: 1024px) {
  .section-{{ section.id }} {
      margin-top: 0px;
      margin-bottom: 0px;
