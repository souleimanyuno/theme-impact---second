    }
  .tabs-before-badge-{{ section.id }},
    .tabs-after-badge-{{ section.id }} {
      padding: 10px 16px;
      font-size: 14px; 
    }
  .tabs-media-text-{{ section.id }} {
      width: 70%;
    }
  .tabs-media-text-{{ section.id }} * {
      font-size: 12px;
    }
}

.section-{{ section.id }}-settings {
      max-width: 1200px;
    }

.tabs-text-wrap-{{ section.id }} {
      order: 2;
    }

.tabs-image-right-{{ section.id }} {
      order: 1;
    }

@media(min-width: 1024px) {
