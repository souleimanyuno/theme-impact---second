#shopify-section-{{ section.id }} .color-background-1, #shopify-section-{{ section.id }}:is(.color-background-1), #shopify-section-{{ section.id }} :root, #shopify-section-{{ section.id }}:is(:root) { --color-foreground: var(--color-base-text); --color-background: var(--color-base-background-1); --gradient-background: var(--gradient-base-background-1); --color-link: var(--color-base-outline-button-labels); --alpha-link: .85; --color-button: var(--color-base-accent-1); --color-button-text: var(--color-base-solid-button-labels); --alpha-button-background: 1; --alpha-button-border: 1; --color-badge-background: var(--color-background); --color-badge-border: var(--color-foreground); --alpha-badge-border: .1; --accent-color: var(--color-base-accent-1); --border-color: var(--color-foreground); }
#shopify-section-{{ section.id }} .color-background-1, #shopify-section-{{ section.id }}:is(.color-background-1), #shopify-section-{{ section.id }} .color-background-2, #shopify-section-{{ section.id }}:is(.color-background-2), #shopify-section-{{ section.id }} :root, #shopify-section-{{ section.id }}:is(:root) { --color-card-hover: var(--color-base-text); }
