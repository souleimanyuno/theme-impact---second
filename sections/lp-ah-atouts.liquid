{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
}
</style>

<style data-shopify>.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
  }</style><div class="color-background-1 gradient content-for-grouping always-display">
  
  <div class="section-{{ section.id }}-padding">
    <style>
  /* Haupt-Container: Abstand verringert */
  .v-brand-wrapper {
    padding: 15px 20px;
    text-align: center;
    background-color: transparent;
    color: #333333;
    font-family: inherit;
  }

  /* Social Proof / Trust Bar */
  .v-trust-section {
    margin-bottom: 30px; /* Abstand zum n\e4 chsten Block verringert */
    padding-bottom: 15px;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    display: inline-block;
    width: 100%;
    max-width: 500px;
  }
  
  .v-stars-wrap {
    color: #F4B400;
    font-size: 22px; /* Sterne etwas gr\f6 \df er */
    margin-bottom: 8px;
    display: block;
  }

  .v-trust-headline {
    font-weight: 700;
    font-size: 16px; /* Gr\f6 \df ere Schrift wie gew\fc nscht */
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin: 0;
    line-height: 1.4;
  }

  /* USP Grid */
  .v-usp-layout {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .v-usp-card {
    flex: 1;
    min-width: 200px;
    padding: 10px;
  }

  .v-usp-img {
    font-size: 32px; /* Emojis/Icons etwas pr\e4 senter */
    margin-bottom: 12px;
    display: block;
  }

  .v-usp-header {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 6px;
    color: #000;
  }

  .v-usp-body {
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.85;
    margin: 0;
    max-width: 250px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Mobile Anpassung */
  @media (max-width: 768px) {
    .v-brand-wrapper { padding: 10px 15px; }
    .v-usp-layout { flex-direction: column; gap: 15px; }
    .v-usp-card { margin-bottom: 10px; }
    .v-trust-headline { font-size: 14px; } /* Mobil etwas skaliert */
  }
</style>

<div class="v-brand-wrapper">
  <div class="v-trust-section">
    
    <p class="v-trust-headline">{{ section.settings.t01 }}</p>
  </div>

  <div class="v-usp-layout">
    
    <div class="v-usp-card">
      <span class="v-usp-img">&#10024;</span>
      <h3 class="v-usp-header">{{ section.settings.t02 }}</h3>
      <p class="v-usp-body">{{ section.settings.t03 }}</p>
    </div>

    <div class="v-usp-card">
      <span class="v-usp-img">&#129516;</span>
      <h3 class="v-usp-header">{{ section.settings.t04 }}</h3>
      <p class="v-usp-body">{{ section.settings.t05 }}</p>
    </div>

    <div class="v-usp-card">
      <span class="v-usp-img">&#127807;</span>
      <h3 class="v-usp-header">{{ section.settings.t06 }}</h3>
      <p class="v-usp-body">{{ section.settings.t07 }}</p>
    </div>

  </div>
</div>
  </div>
</div>

<style>
/* css-applique : regles de la source */
