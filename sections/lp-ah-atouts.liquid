}
</style>
<!-- scripts-inline : repris de la source -->
<script>
    
      function checkBtnVisibility() {
        const scrollToTopBtn = document.querySelector('.scroll-to-top-btn');
        if (scrollToTopBtn) {
          if (window.scrollY > 400) {
            scrollToTopBtn.style.display = '';
          } else {
            scrollToTopBtn.style.display = 'none';
          }
        }
      }
      checkBtnVisibility()
    
      window.addEventListener('scroll', checkBtnVisibility)
    
  
    function handleScrollToTop() {
      window.scrollTo({
        top: 0,
        behavior: "smooth"
      })
    }
  </script>
<style>
  /* typo Veluna : Poppins, interlettrage 0.96 px */
  #shopify-section-{{ section.id }}, #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} div { font-family: Poppins, sans-serif; letter-spacing: .96px; }
</style>
{% schema %}
{
  "name": "Accueil atouts",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "t01",
      "label": "PLUS DE 10 000 FEMMES ADORENT LEUR NOUVE",
      "default": "LA ROUTINE ANTI-REPOUSSE QUI AGIT &#192; LA RACINE"
    },
    {
      "type": "text",
      "id": "t02",
      "label": "Douce comme de la soie",
      "default": "Douce comme de la soie"
    },
    {
      "type": "text",
      "id": "t03",
      "label": "Fini la peau de fraise et le feu du raso",
      "default": "Fini la peau de fraise et le feu du rasoir &#8211; juste une peau parfaitement lisse."
    },
    {
      "type": "text",
      "id": "t04",
      "label": "Stoppe la pousse",
      "default": "Stoppe la pousse"
    },
    {
      "type": "text",
      "id": "t05",
      "label": "Ralentit visiblement la repousse, direct",
      "default": "Ralentit visiblement la repousse, directement &#224; la racine."
    },
    {
      "type": "text",
      "id": "t06",
      "label": "100 % naturel",
      "default": "100 % naturel"
    },
    {
      "type": "text",
      "id": "t07",
      "label": "Formule sans hormones. Sans risque pour ",
      "default": "Formule sans hormones, douce pour le visage, le corps et la zone intime."
    }
  ],
  "class": "shopify-section src-section"
}
{% endschema %}
