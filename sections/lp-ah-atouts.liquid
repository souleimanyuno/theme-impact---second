#shopify-section-{{ section.id }} .gradient, #shopify-section-{{ section.id }}:is(.gradient) { background: var(--gradient-background); }
#shopify-section-{{ section.id }} .section-{{ section.id }}, #shopify-section-{{ section.id }}:is(.section-{{ section.id }}) { padding-top: calc(30px); padding-bottom: calc(39px); }
#shopify-section-{{ section.id }} .v-brand-wrapper, #shopify-section-{{ section.id }}:is(.v-brand-wrapper) { padding: 15px 20px; text-align: center; background-color: transparent; color: rgb(51, 51, 51); font-family: inherit; }
#shopify-section-{{ section.id }} .v-trust-section, #shopify-section-{{ section.id }}:is(.v-trust-section) { margin-bottom: 30px; padding-bottom: 15px; border-bottom: 1px solid rgba(0, 0, 0, 0.08); display: inline-block; width: 100%; max-width: 500px; }
#shopify-section-{{ section.id }} .v-stars-wrap, #shopify-section-{{ section.id }}:is(.v-stars-wrap) { color: rgb(244, 180, 0); font-size: 22px; margin-bottom: 8px; display: block; }
#shopify-section-{{ section.id }} .v-trust-headline, #shopify-section-{{ section.id }}:is(.v-trust-headline) { font-weight: 700; font-size: 16px; text-transform: uppercase; letter-spacing: 1.2px; margin: 0px; line-height: 1.4; }
#shopify-section-{{ section.id }} .v-usp-layout, #shopify-section-{{ section.id }}:is(.v-usp-layout) { display: flex; justify-content: center; flex-wrap: wrap; gap: 20px; max-width: 1000px; margin: 0px auto; }
#shopify-section-{{ section.id }} .v-usp-card, #shopify-section-{{ section.id }}:is(.v-usp-card) { flex: 1 1 0%; min-width: 200px; padding: 10px; }
#shopify-section-{{ section.id }} .v-usp-img, #shopify-section-{{ section.id }}:is(.v-usp-img) { font-size: 32px; margin-bottom: 12px; display: block; }
