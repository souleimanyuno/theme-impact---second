#shopify-section-{{ section.id }} .v-usp-body, #shopify-section-{{ section.id }}:is(.v-usp-body) { font-size: 14px; line-height: 1.5; opacity: 0.85; margin: 0px auto; max-width: 250px; }
@media screen and (min-width: 750px) {
#shopify-section-{{ section.id }} .src-section + .src-section, #shopify-section-{{ section.id }}:is(.src-section + .src-section) { margin-top: var(--spacing-sections-desktop); }
#shopify-section-{{ section.id }} .gradient, #shopify-section-{{ section.id }}:is(.gradient) { background-attachment: fixed; }
