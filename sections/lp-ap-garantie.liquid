{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
}
</style>

<style data-shopify>.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
  }</style><div class="color-background-1 gradient content-for-grouping always-display">
  
  <div class="section-{{ section.id }}-padding">
    <div style="display:flex;justify-content:center;padding:1.5rem 1rem;">
  <div style="
    display:inline-flex;
    align-items:center;
    gap:20px;
    background:#F4ECFA;
    border:1.5px solid #B57EDC;
    border-radius:20px;
    padding:20px 28px;
    max-width:460px;
    width:100%;
  ">

    <div style="
      flex-shrink:0;
      width:68px;
      height:68px;
      border-radius:50%;
      background:#F4ECFA;
      border:2px solid #A855F7;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
    ">
      <span style="font-size:20px;font-weight:600;color:#6B21A8;line-height:1;">{{ section.settings.t01 }}</span>
      <span style="font-size:7px;font-weight:500;color:#7E22CE;letter-spacing:0.06em;line-height:1.4;">{{ section.settings.t02 }}</span>
      <div style="width:30px;height:0.5px;background:#B57EDC;margin:2px 0;"></div>
      <span style="font-size:6px;font-weight:500;color:#7E22CE;letter-spacing:0.06em;">{{ section.settings.t03 }}</span>
    </div>

    <div style="flex:1;">
      <p style="margin:0 0 4px;font-size:14px;font-weight:600;color:#1A1A1A;line-height:1.3;">
        {{ section.settings.t04 }}
      </p>
      <p style="margin:0;font-size:13px;color:#5a5a5a;line-height:1.5;">
        {{ section.settings.t05 }}
      </p>
    </div>

  </div>
</div>
  </div>
</div>

<style>
/* css-applique : regles de la source */
#shopify-section-{{ section.id }} { --color-base-text: 26, 26, 26; --color-base-background-1: 244, 236, 250; --gradient-base-background-1: #f4ecfa; --color-base-outline-button-labels: 181, 126, 220; --color-base-accent-1: 168, 85, 247; --color-base-solid-button-labels: 255, 255, 255; --color-background: 244, 236, 250; --color-foreground: 26, 26, 26; --spacing-sections-mobile: 0px; --spacing-sections-desktop: 0px; --gradient-background: #f4ecfa; }
#shopify-section-{{ section.id }} .color-background-1, #shopify-section-{{ section.id }}:is(.color-background-1), #shopify-section-{{ section.id }} :root, #shopify-section-{{ section.id }}:is(:root) { --color-foreground: var(--color-base-text); --color-background: var(--color-base-background-1); --gradient-background: var(--gradient-base-background-1); --color-link: var(--color-base-outline-button-labels); --alpha-link: .85; --color-button: var(--color-base-accent-1); --color-button-text: var(--color-base-solid-button-labels); --alpha-button-background: 1; --alpha-button-border: 1; --color-badge-background: var(--color-background); --color-badge-border: var(--color-foreground); --alpha-badge-border: .1; --accent-color: var(--color-base-accent-1); --border-color: var(--color-foreground); }
#shopify-section-{{ section.id }} .color-background-1, #shopify-section-{{ section.id }}:is(.color-background-1), #shopify-section-{{ section.id }} .color-background-2, #shopify-section-{{ section.id }}:is(.color-background-2), #shopify-section-{{ section.id }} :root, #shopify-section-{{ section.id }}:is(:root) { --color-card-hover: var(--color-base-text); }
#shopify-section-{{ section.id }} .src-section + .src-section, #shopify-section-{{ section.id }}:is(.src-section + .src-section) { margin-top: var(--spacing-sections-mobile); }
#shopify-section-{{ section.id }} .color-accent-1, #shopify-section-{{ section.id }}:is(.color-accent-1), #shopify-section-{{ section.id }} .color-accent-2, #shopify-section-{{ section.id }}:is(.color-accent-2), #shopify-section-{{ section.id }} .color-background-1, #shopify-section-{{ section.id }}:is(.color-background-1), #shopify-section-{{ section.id }} .color-background-2, #shopify-section-{{ section.id }}:is(.color-background-2), #shopify-section-{{ section.id }} .color-inverse, #shopify-section-{{ section.id }}:is(.color-inverse), #shopify-section-{{ section.id }} .color-custom, #shopify-section-{{ section.id }}:is(.color-custom), #shopify-section-{{ section.id }} body, #shopify-section-{{ section.id }}:is(body) { color: rgba(var(--color-foreground),.9); background-color: rgb(var(--color-background)); }
#shopify-section-{{ section.id }} .gradient, #shopify-section-{{ section.id }}:is(.gradient) { background: var(--gradient-background); }
#shopify-section-{{ section.id }} .section-{{ section.id }}, #shopify-section-{{ section.id }}:is(.section-{{ section.id }}) { padding-top: calc(30px); padding-bottom: calc(39px); }
@media screen and (min-width: 750px) {
#shopify-section-{{ section.id }} .src-section + .src-section, #shopify-section-{{ section.id }}:is(.src-section + .src-section) { margin-top: var(--spacing-sections-desktop); }
#shopify-section-{{ section.id }} .gradient, #shopify-section-{{ section.id }}:is(.gradient) { background-attachment: fixed; }
#shopify-section-{{ section.id }} .section-{{ section.id }}, #shopify-section-{{ section.id }}:is(.section-{{ section.id }}) { padding-top: 40px; padding-bottom: 52px; }
}
</style>
{% schema %}
{
  "name": "AP Garantie",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "t01",
      "label": "90",
      "default": "90"
    },
    {
      "type": "text",
      "id": "t02",
      "label": "JOURS",
      "default": "JOURS"
    },
    {
      "type": "text",
      "id": "t03",
      "label": "GARANTIE",
      "default": "GARANTIE"
    },
    {
      "type": "text",
      "id": "t04",
      "label": "Satisfaite ou rembours&#233;e",
      "default": "Tu as d&#233;j&#224; pay&#233; pour des m&#233;thodes qui n&#8217;ont rien chang&#233;."
    },
    {
      "type": "text",
      "id": "t05",
      "label": "Teste Sorelya pendant 90 jours. Pas de r",
      "default": "Cette fois, tu as 90 jours pour juger. Pas de r&#233;sultat ? On te rembourse jusqu&#8217;au dernier centime, sans discussion."
    }
  ],
  "class": "shopify-section src-section"
}
{% endschema %}
