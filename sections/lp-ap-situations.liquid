#shopify-section-{{ section.id }} .testimonials-slide-{{ section.id }}.swiper-slide-visible.swiper-slide-prev, #shopify-section-{{ section.id }}:is(.testimonials-slide-{{ section.id }}.swiper-slide-visible.swiper-slide-prev) { opacity: 0.5; transition-duration: 250ms; transition-property: transform, opacity; }
