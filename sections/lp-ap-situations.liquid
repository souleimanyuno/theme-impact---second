<style>
.section-{{ section.id }} {
    border-top: solid #000000 0px;
    border-bottom: solid #000000 0px;
    margin-top: 0px;
    margin-bottom: 0px;
    overflow: hidden;
  }

.section-{{ section.id }}-settings {
    margin: 0 auto;
    padding-top: 45px;
    padding-bottom: 45px;
    padding-left: 15px;
    padding-right: 15px;
  }

.testimonials-heading-{{ section.id }} {
    margin: 0;
    font-size: 24px;
    color: #000000;
    line-height: 130%;
    text-align: center;
    text-transform: unset;
  }

.testimonials-stars-{{ section.id }} {
    display: flex;
    align-items: end;
    gap: 5px;
  }

.testimonials-stars-{{ section.id }} svg,
  .testimonials-stars-{{ section.id }} img {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: cover;
  }

.testimonials-stars-{{ section.id }} svg {
    background-color: #00b67a; 
  }

.testimonials-rating-{{ section.id }} {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    flex-wrap: wrap;
  }

.testimonials-rating-text-{{ section.id }},
  .testimonials-rating-{{ section.id }} span {
    margin: 0;
    font-size: 20px;
    color: #000000;
    line-height: 130%;
  }

.testimonials-rating-{{ section.id }} span {
    font-size: 25px;
    font-weight: 700;
  }

.testimonials-rating-{{ section.id }} .testimonials-stars-{{ section.id }} {
    padding-left: 5px;
  }

.testimonials-text-{{ section.id }} {
    margin-top: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

.testimonials-text-{{ section.id }} * {
    margin: 0;
    font-size: 16px;
    color: #000000;
    line-height: 130%;
    text-transform: unset;
  }

.testimonials-text-{{ section.id }} strong {
    text-decoration: underline;
  }

.testimonials-image-{{ section.id }} {
    width: 100px;
    height: 32px;
  }

.testimonials-image-{{ section.id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

.testimonials-slider-wrapper-{{ section.id }} {
    margin-top: 27px;
  }

.testimonials-slider-{{ section.id }} {
    overflow: visible !important;
  }

.testimonials-slide-{{ section.id }}.swiper-slide {
    opacity: 0.5;
    transition-duration: 250ms;
    transition-property: transform, opacity;
  }

.testimonials-slide-{{ section.id }}.swiper-slide-active {
    opacity: 1;
    transition-duration: 250ms;
    transition-property: transform, opacity;
  }

.testimonials-slide-{{ section.id }} {
    display: flex !important;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding: 24px 24px;
    border-radius: 16px;
    border: 0px solid #000000;
    background-color: #ffffff;
    box-sizing: border-box !important; 
    height: auto !important;
  }

.testimonials-slide-top-{{ section.id }} .testimonials-stars-{{ section.id }} {
    justify-content: center;
  }

.testimonials-slide-heading-{{ section.id }} {
    margin: 0;
    margin-top: 12px;
    font-size: 20px;
    color: #000000;
    line-height: 130%;
    text-align: center;
    font-weight: 700;
    text-transform: unset;
  }

.testimonials-slide-text-{{ section.id }} {
    margin: 0;
    margin-top: 12px;
    font-size: 14px;
    color: #000000;
    line-height: 150%;
    text-align: center;
    text-transform: unset;
  }

.testimonials-slide-text-{{ section.id }} span:first-child {
    display: none;
  }

.testimonials-slide-text-small-{{ section.id }}.active {
    display: none;
  }

.testimonials-slide-text-big-{{ section.id }} {
    display: none;
  }

.testimonials-slide-text-big-{{ section.id }}.active {
    display: inline;
  }

.testimonials-slide-text-btn-{{ section.id }} {
    display: block;
    max-width: fit-content;
    width: 100%;
    background-color: transparent;
    box-shadow: none;
    border: 0px;
    font-size: 14px;
    line-height: 150%;
    font-weight: 700;
    margin-top: 10px;
  }

.testimonials-slide-author-date-{{ section.id }} {
    margin: 0;
    font-size: 16px;
    color: #000000;
    line-height: 130%;
    text-align: center;
    text-transform: unset;
  }

.testimonials-btn-prev-{{ section.id }},
  .testimonials-btn-next-{{ section.id }} {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border: 0px solid #ffffff;
    border-radius: 50%;
    background: #ffffff;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease 0s;
    cursor: pointer;
    -webkit-appearance: none;
    box-shadow: 0px 0px 10px 0px rgba(0,0,0,.15);
  }

.testimonials-btn-prev-{{ section.id }} {
    left: 0px !important;
  }

.testimonials-btn-next-{{ section.id }} {
    right: 0px !important;
  }

.testimonials-btn-prev-{{ section.id }} svg,
  .testimonials-btn-next-{{ section.id }} svg {
    height: 28px;
    width: 28px;
  }

.testimonials-btn-next-{{ section.id }} svg {
    transform: rotate(180deg);
    margin-left: 2px;
  }

.testimonials-btn-prev-{{ section.id }} svg {
    margin-left: -2px;
  }

.testimonials-btn-prev-{{ section.id }} svg path,
  .testimonials-btn-next-{{ section.id }} svg path {
    fill: #000000;
    transition: all 0.3s ease 0s;
  }

.testimonials-btn-prev-{{ section.id }}:hover ,
  .testimonials-btn-next-{{ section.id }}:hover {
    transition: all 0.3s ease 0s;
    border: 0px solid #ffffff;
    background: #ffffff;
  }

.testimonials-btn-prev-{{ section.id }}:hover svg path,
  .testimonials-btn-next-{{ section.id }}:hover svg path {
    fill: #000000;
    transition: all 0.3s ease 0s;
  }

.testimonials-btn-prev-{{ section.id }}.swiper-button-disabled,
  .testimonials-btn-next-{{ section.id }}.swiper-button-disabled {
    opacity: 0.3;
  }

.testimonials-pagination-{{ section.id }} {
    margin-top: 20px;
    position: static !important;
    width: 100%;
    justify-content: center;
    align-items: center;
  }

.testimonials-pagination-{{ section.id }} .swiper-pagination-bullet {
    width: 12px;
    height: 12px;
    border: 2px solid #000000;
    background-color: transparent;
    opacity: 0.6;
  }

.testimonials-pagination-{{ section.id }} .swiper-pagination-bullet.swiper-pagination-bullet-active {
    opacity: 1;
    background-color: #000000
  }

.testimonials-btn-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: fit-content;
    margin: 0;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    line-height: 100%;
    text-align: center;
    text-transform: unset;
    text-decoration: none;
    padding: 15px 12px;
    border-radius: 8px;
    border: 0px solid #000000;
    background-color: #000000;
    transition: all 0.25s ease 0s;
  }

.testimonials-btn-{{ section.id }}:hover {
    color: #ffffff;
    border: 0px solid #000000;
    background-color: #000000;
    transition: all 0.25s ease 0s;
  }

