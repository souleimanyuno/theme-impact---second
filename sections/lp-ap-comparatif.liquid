{%- comment -%}
  Clone verbatim - section source : {{ section.id }}
  Markup et CSS repris tels quels, identifiants rescopes sur section.id.
  Chaque texte et chaque image sont exposes en setting : le rendu par
  defaut est identique a la source, tout reste editable.
{%- endcomment -%}

<style>
.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
}
</style>

<style data-shopify>.section-{{ section.id }}-padding {
    padding-top: calc(40px * 0.75);
    padding-bottom: calc(52px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 40px;
      padding-bottom: 52px;
    }
  }</style><div class="color-background-1 gradient content-for-grouping always-display">
  
  <div class="section-{{ section.id }}-padding">
    <style>
  /* --- CSS STYLING --- */
  .serum-comparison-widget {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background-color: #F4ECFA; 
    padding: 0 20px; /* Nur seitliches Padding, oben/unten 0 */
    border-radius: 10px;
    max-width: 800px; 
    margin: 0 auto; /* Zentriert ohne vertikalen Abstand */
    text-align: center;
  }

  /* Header Bereich ohne Abstand nach oben */
  .cw-header {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding-top: 0; /* Absolut kein Platz nach oben */
    margin-bottom: 30px;
    align-items: flex-start; 
  }

  .cw-product-box {
    width: 48%; 
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cw-image-frame {
    width: 100%;
    aspect-ratio: 1 / 1; 
    background-color: #fff;
    border: 2px solid #000;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px; 
  }

  .cw-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain; 
    display: block;
  }

  .cw-product-name {
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 16px;
    padding: 12px 0; 
    height: 50px; 
    display: flex;
    align-items: center;
    justify-content: center;
    color: #111;
  }

  .cw-select {
    padding: 0 10px;
    height: 46px; 
    font-size: 13px; 
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 2px solid #000;
    border-radius: 50px;
    background-color: #fff;
    cursor: pointer;
    width: 100%;
    text-align: center;
    text-align-last: center; 
    -webkit-appearance: none; 
    appearance: none;
    background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23000000%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
    background-repeat: no-repeat;
    background-position: right 10px center;
    background-size: 10px;
    color: #111;
  }

  .cw-rows-container {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding-bottom: 0; /* Kein Platz nach unten */
  }

  .cw-row {
    display: flex;
    justify-content: space-between;
    align-items: center; 
    padding: 15px 10px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
  }

  .cw-row:last-child {
    margin-bottom: 0; /* Letzte Zeile schlie\df t b\fc ndig ab */
  }

  .cw-point {
    width: 48%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cw-icon {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 16px;
    margin-bottom: 8px;
    font-weight: bold;
    flex-shrink: 0;
  }

  .cw-icon.check {
    background-color: #dcd0ff; 
    color: #000;
    border: 1px solid #bda0e3;
  }

  .cw-icon.cross {
    background-color: #fff;
    color: #000;
    border: 1px solid #ddd;
  }

  .cw-text-bold {
    font-weight: bold;
    font-size: 14px; 
    color: #000;
    line-height: 1.3;
  }

  @media (max-width: 600px) {
    .serum-comparison-widget { padding: 0 10px; }
    .cw-header { gap: 10px; }
    .cw-text-bold { font-size: 12px; }
    .cw-icon { width: 24px; height: 24px; font-size: 14px; }
    .cw-select { 
        font-size: 12px; 
        padding: 0 25px 0 10px; 
    }
    .cw-product-box { width: 49%; }
  }
</style>

<div class="serum-comparison-widget">
  <div class="cw-header">
      <div class="cw-product-box">
          <div class="cw-image-frame">
              <img src="{% if section.settings.img01 != blank %}{{ section.settings.img01 | image_url: width: 1400 }}{% else %}{{ 'ap-flacon.jpg' | asset_url }}{% endif %}" alt="Sorelya Serum" loading="lazy" decoding="async">
          </div>
          <div class="cw-product-name">{{ section.settings.t01 }}</div>
      </div>

      <div class="cw-product-box">
          <div class="cw-image-frame">
              <img id="cw-comp-img" src="" alt="Autre m&#233;thode">
          </div>
          <div style="width: 100%; display: flex; align-items: center; justify-content: center; height: 50px;">
              <select id="cw-select" class="cw-select">
                  <option value="shaving">{{ section.settings.t02 }}</option>
                  <option value="cream">{{ section.settings.t03 }}</option>
                  <option value="waxing">{{ section.settings.t04 }}</option>
                  <option value="ipl">{{ section.settings.t05 }}</option>
                  <option value="plucking">{{ section.settings.t06 }}</option>
              </select>
          </div>
      </div>
  </div>

  <div id="cw-content" class="cw-rows-container"></div>
</div>


  </div>
</div>

