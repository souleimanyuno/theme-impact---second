<script>
  (function() {
      const comparisonData = {
          shaving: {
              img: "{{ 'ap-cmp-rasoir.webp' | asset_url }}", 
              rows: [
                  { serum: "\u00c9vite les boutons de rasage", other: "Feu du rasoir et rougeurs" },
                  { serum: "Stoppe la peau de fraise", other: "Favorise les pores noirs" },
                  { serum: "Apaise la peau tout de suite", other: "Ass\u00e8che \u00e9norm\u00e9ment la peau" },
                  { serum: "Rend les poils plus doux", other: "Repousse dure qui pique" }
              ]
          },
          cream: {
              img: "{{ 'ap-cmp-creme.webp' | asset_url }}", 
              rows: [
                  { serum: "Doux pour les peaux sensibles", other: "Souvent des br\u00fblures chimiques" },
                  { serum: "Parfum agr\u00e9able", other: "Forte odeur chimique" },
                  { serum: "Ingr\u00e9dients v\u00e9g\u00e9taux", other: "Produits chimiques agressifs" },
                  { serum: "Moins de poils sur la dur\u00e9e", other: "Les poils repoussent vite" }
              ]
          },
          waxing: {
              img: "{{ 'ap-cmp-cire.webp' | asset_url }}", 
              rows: [
                  { serum: "Totalement indolore", other: "Extr\u00eamement douloureux" },
                  { serum: "Pas de poils incarn\u00e9s", other: "Risque de poils incarn\u00e9s" },
                  { serum: "Peau lisse et douce tout de suite", other: "Peau rouge et irrit\u00e9e pendant des jours" },
                  { serum: "Calme les inflammations", other: "R\u00e9sidus collants et irritations" }
              ]
          },
          ipl: {
              img: "{{ 'ap-cmp-laser.webp' | asset_url }}", 
              rows: [
                  { serum: "Une fraction du prix", other: "Appareil / s\u00e9ances hors de prix" },
                  { serum: "Pas besoin de lunettes de protection", other: "Danger pour les yeux (flash)" },
                  { serum: "Pour tous les types de peau", other: "Pas pour toutes les peaux ni tous les poils" },
                  { serum: "Appliqu\u00e9 en quelques secondes", other: "Des s\u00e9ances qui prennent du temps" }
              ]
          },
          plucking: {
              img: "{{ 'ap-cmp-pince.webp' | asset_url }}", 
              rows: [
                  { serum: "Agit sur de grandes zones", other: "P\u00e9nible, poil par poil" },
                  { serum: "Les poils ne cassent pas", other: "Les poils cassent souvent \u00e0 la racine" },
                  { serum: "Pr\u00e9vient les inflammations", other: "Points rouges enflamm\u00e9s apr\u00e8s la pince" },
                  { serum: "Agr\u00e9able sur la peau", other: "\u00c7a tire et \u00e7a arrache" }
              ]
          }
      };

      const selectElem = document.getElementById('cw-select');
      const imgElem = document.getElementById('cw-comp-img');
      const contentElem = document.getElementById('cw-content');

      function updateWidget() {
          const key = selectElem.value;
          const data = comparisonData[key];
          
          if(!data) return;

          imgElem.src = data.img;

          let html = "";
          data.rows.forEach(row => {
              html += `
              <div class="cw-row">
                  <div class="cw-point">
                      <div class="cw-icon check">\u2713</div>
                      <div class="cw-text-bold">${row.serum}</div>
                  </div>
                  <div class="cw-point">
                      <div class="cw-icon cross">\u2715</div>
                      <div class="cw-text-bold">${row.other}</div>
                  </div>
              </div>
              `;
          });
          contentElem.innerHTML = html;
      }

      if(selectElem) {
          selectElem.addEventListener('change', updateWidget);
          updateWidget();
      }
  })();
</script>
