o;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-offer-btn {\n    display: flex;\n    width: 100%;\n    min-height: clamp(60px, 16vw, 64px);\n    padding: 10px 16px;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    gap: 5px;\n    overflow: hidden;\n    border-radius: 10px;\n    background: #FFD814;\n    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);\n    color: #121212;\n    text-align: center;\n    text-decoration: none;\n    text-transform: uppercase;\n    transition: background 0.2s ease, transform 0.2s ease;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-offer-btn:hover {\n    background: #DBB911;\n    transform: translateY(-1px);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-offer-btn:active {\n    background: #DBB911;\n    transform: translateY(1px) scale(0.99);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-offer-btn span,\n  #sorelya-pressure-balance-section .sorelya-pressure-offer-btn strong {\n    display: block;\n    color: #121212;\n    font-size: clamp(15.5px, 4.3vw, 17px);\n    line-height: 1.08;\n    font-weight: 700;\n    letter-spacing: -0.2px;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-offer-btn strong {\n    font-size: clamp(12px, 3.3vw, 13px);\n  }\n\n  /* ===== LIGNE DE RÉASSURANCE ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-mini-urgency {\n    max-width: 340px;\n    margin: 10px auto 0;\n    color: #052E57;\n    font-size: clamp(12px, 3.3vw, 12.5px);\n    line-height: 1.45;\n    font-weight: 700;\n    text-align: center;\n  }\n\n  /* ===== MOBILE : passage en 1 colonne ===== */\n  @media (max-width: 768px) {\n    #sorelya-pressure-balance-section {\n      padding-bottom: 28px;\n    }\n\n    #sorelya-pressure-balance-section .sorelya-pressure-proof-row {\n      grid-template-columns: 1fr;\n    }\n\n    #sorelya-pressure-balance-section .sorelya-pressure-variant-grid {\n      grid-template-columns: 1fr;\n    }\n\n    #sorelya-pressure-balance-section .sorelya-pressure-offer-block {\n      max-width: 360px;\n    }\n  }\n\n  /* ===== TRÈS PETITS ÉCRANS ===== */\n  @media (max-width: 350px) {\n    #sorelya-pressure-balance-section {\n      padding-left: 12px;\n      padding-right: 12px;\n    }\n\n    #sorelya-pressure-balance-section .sorelya-pressure-title {\n      font-size: 22px;\n    }\n  }\n\n  /* ===== ACCESSIBILITÉ : animations réduites ===== */\n  @media (prefers-reduced-motion: reduce) {\n    #sorelya-pressure-balance-section .sorelya-pressure-offer-btn {\n      transition: none;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function sorelyaScrollToProduct(event) {\n      event.preventDefault();\n\n      // Cibles identiques à la section avis (bloc d'achat : badges 30J + Hergestellt in Deutschland)\n      var target =\n        document.querySelector('.sorelya-conversion-block') ||\n        document.getElementById('mv-achat') ||\n        document.querySelector('form[action*=\"/cart/add\"]');\n\n      // Dernier filet de sécurité : remonter en haut de page.\n      if (!target) {\n        window.scrollTo({ top: 0, behavior: 'smooth' });\n        return;\n      }\n\n      var headerOffset = 90;\n      var targetPosition =\n        target.getBoundingClientRect().top +\n        window.pageYOffset -\n        headerOffset;\n\n      window.scrollTo({\n        top: Math.max(0, targetPosition),\n        behavior: 'smooth'\n      });\n    }\n\n    function sorelyaBindPressureCta() {\n      var btn = document.getElementById('sorelya-pressure-cta');\n      if (!btn || btn.dataset.sorelyaBound === 'true') return;\n      btn.dataset.sorelyaBound = 'true';\n      btn.addEventListener('click', sorelyaScrollToProduct);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', sorelyaBindPressureCta);\n    } else {\n      sorelyaBindPressureCta();\n    }\n  })();\n</script>\n  </div>\n</div>\n\n\n</section>",
