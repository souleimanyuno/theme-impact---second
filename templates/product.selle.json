n  .sorelya-de-flag > span:nth-child(3) {\n    background-color: #FFCE00 !important;\n  }\n\n  .sorelya-trust-ticker:hover .sorelya-trust-track {\n    animation-play-state: paused;\n  }\n\n  @keyframes sorelyaTickerScroll {\n    from {\n      transform: translateX(0);\n    }\n\n    to {\n      transform: translateX(-50%);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .sorelya-trust-ticker {\n      margin: 0 !important;\n      padding: 10px 0 !important;\n    }\n\n    .sorelya-trust-track {\n      animation-duration: 14s;\n    }\n\n    .sorelya-trust-item {\n      gap: 7px;\n      padding: 0 18px;\n\n      font-size: 11.5px;\n      line-height: 18px;\n      font-weight: 900;\n      letter-spacing: 0.25px;\n    }\n\n    .sorelya-trust-item svg {\n      width: 18px;\n      height: 18px;\n      min-width: 18px;\n      flex-basis: 18px;\n    }\n\n    .sorelya-trust-separator {\n      width: 5px !important;\n      height: 5px !important;\n      min-width: 5px !important;\n      flex-basis: 5px !important;\n    }\n\n    .sorelya-de {\n      gap: 7px;\n    }\n\n    .sorelya-de-flag {\n      width: 22px;\n      height: 15px;\n    }\n\n    .sorelya-trust-ticker::before,\n    .sorelya-trust-ticker::after {\n      width: 27px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .sorelya-trust-track {\n      animation: none;\n    }\n  }\n</style>\n  </div>\n</div>\n\n\n</section>",
