x:contain}\n.mvr-r::-webkit-scrollbar{display:none}\n.mvr-r.is-d{cursor:grabbing;scroll-behavior:auto;scroll-snap-type:none}\n.mvr-c{flex:0 0 88%;max-width:380px;scroll-snap-align:start;scroll-snap-stop:always;display:flex;flex-direction:column;\npadding:17px 16px;background:#fff;border:1.5px solid var(--bd);border-radius:14px;box-shadow:0 3px 12px rgba(5,46,87,.05)}\n/* la derniere carte s'accroche par sa droite : sans cela Safari agrandit\n   la zone defilante pour pouvoir l'aligner a gauche, d'ou un vide final */\n.mvr-c:last-child{scroll-snap-align:end}\n.mvr-c .mvr-s{margin-bottom:11px}\n.mvr-c p{margin:0 0 15px;font-size:clamp(15px,4vw,16.5px);line-height:1.6;color:#2F3742;font-weight:400}\n.mvr-w{display:flex;align-items:center;gap:11px;margin-top:auto;padding-top:13px;border-top:1px solid var(--bd)}\n.mvr-w>span:first-child{display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex:none;\nborder-radius:50%;background:var(--sf);color:var(--a);font-size:18px;font-weight:700;line-height:1}\n.mvr-w>span:last-child{display:flex;flex-direction:column;gap:3px;min-width:0}\n.mvr-w b{font-size:clamp(14.5px,3.8vw,16px);font-weight:700;line-height:1.2}\n.mvr-w em{position:relative;display:inline-block;padding-left:21px;font-style:normal;\nfont-size:clamp(12px,3.2vw,13.5px);font-weight:600;color:#1B7A45;line-height:1.25;white-space:nowrap}\n.mvr-w em::before{content:\"\";position:absolute;left:0;top:50%;width:16px;height:16px;margin-top:-8px;border-radius:50%;background:#1B7A45 url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M19.5 7L9.75 16.75 4.5 11.5' fill='none' stroke='%23ffffff' stroke-width='3.4' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E\") center/62% no-repeat}\n\n.mvr-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:2px}\n.mvr-a{width:56px;height:56px;border-radius:50%;background:#fff;border:2px solid var(--bd);color:var(--a);\ncursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s,opacity .15s}\n.mvr-a svg{width:24px;height:24px;display:block}\n.mvr-a:active{background:var(--sf)}\n.mvr-a[disabled]{opacity:.3;cursor:default}\n@media (min-width:750px){.mvr-c{flex:0 0 46% } }\n@media (prefers-reduced-motion:reduce){.mvr-r{scroll-behavior:auto}.mvr-tab,.mvr-a{transition:none} }\n</style>\n\n<script>\n(function(){\nfunction init(root){\n  if(root.dataset.ready==='1')return;root.dataset.ready='1';\n  var tabs=[].slice.call(root.querySelectorAll('[data-tab]'));\n  var panels=[].slice.call(root.querySelectorAll('[data-p]'));\n  var prev=root.querySelector('[data-prev]'),next=root.querySelector('[data-next]');\n\n  function rail(){var p=root.querySelector('[data-p]:not([hidden])');return p?p.querySelector('[data-r]'):null;}\n  function stepSize(r){var c=r.querySelector('.mvr-c');return c?c.getBoundingClientRect().width+12:r.clientWidth*.9;}\n\n  function refresh(){\n    var r=rail();if(!r)return;\n    var max=r.scrollWidth-r.clientWidth-2;\n    if(prev)prev.disabled=r.scrollLeft<=2;\n    if(next)next.disabled=r.scrollLeft>=max;\n  }\n\n  function show(i){\n    tabs.forEach(function(t){t.setAttribute('aria-selected',t.dataset.i===i?'true':'false');});\n    panels.forEach(function(p){p.hidden=p.dataset.i!==i;});\n    var r=rail();if(r)r.scrollLeft=0;\n    refresh();\n  }\n\n  tabs.forEach(function(t){\n    t.addEventListener('click',function(){\n      show(t.dataset.i);\n      if(t.scrollIntoView)t.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});\n    });\n  });\n\n  function step(d){var r=rail();if(!r)return;r.scrollBy({left:d*stepSize(r),behavior:'smooth'});}\n  if(prev)prev.addEventListener('click',function(){step(-1);});\n  if(next)next.addEventListener('click',function(){step(1);});\n\n  [].slice.call(root.querySelectorAll('[data-r]')).forEach(function(r){\n    var down=false,sx=0,sl=0,moved=0;\n    r.addEventListener('scroll',refresh,{passive:true});\n    r.addEventListener('mousedown',function(e){down=true;moved=0;sx=e.pageX;sl=r.scrollLeft;r.classList.add('is-d');});\n    window.addEventListener('mouseup',function(){if(!down)return;down=false;r.classList.remove('is-d');});\n    r.addEventListener('mousemove',function(e){\n      if(!down)return;e.preventDefault();\n      var d=e.pageX-sx;moved=Math.abs(d);r.scrollLeft=sl-d;\n    });\n    r.addEventListener('click',function(e){if(moved>6){e.preventDefault();e.stopPropagation();} },true);\n  });\n\n  window.addEventListener('resize',refresh);\n  if(tabs.length)show(tabs[0].dataset.i);\n}\nfunction boot(){[].slice.call(document.querySelectorAll('[data-mvr]')).forEach(init);}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();\ndocument.addEventListener('shopify:section:load',boot);\n})();\n</script>\n  </div>\n</div>\n\n\n</section>\n    </main>\n\n    ",
