      }
    },
    "sorelya_pression": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<section id=\"shopify-section-sorelya__custom_liquid_fQxNxW\" class=\"shopify-section section\"><style data-shopify>.section-sorelya__custom_liquid_fQxNxW-padding {\n    padding-top: calc(0px * 0.75);\n    padding-bottom: calc(0px  * 0.75);\n  }\n\n  @media screen and (min-width: 750px) {\n    .section-sorelya__custom_liquid_fQxNxW-padding {\n      padding-top: 0px;\n      padding-bottom: 0px;\n    }\n  }</style><div class=\"color-background-1 gradient content-for-grouping always-display\">\n  \n  <div class=\"section-sorelya__custom_liquid_fQxNxW-padding\">\n    <section id=\"sorelya-pressure-balance-section\">\n  <div class=\"sorelya-pressure-wrap\">\n\n    <!-- IMAGE 1 : preuve médicale / répartition de la pression -->\n    <div class=\"sorelya-pressure-image-shell\">\n      <img\n        src=\"{{ 'sorelya_rueckenschmerzen.jpg' | asset_url }}\"\n        alt=\"Druckverteilung auf einem Sorelya Sattel\"\n        class=\"sorelya-pressure-image\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"sorelya-pressure-content\">\n\n      <div class=\"sorelya-pressure-top-badge\">\n        PATENTIERTE KONSTRUKTION · BEGLEITET VON ÄRZTEN &amp; PHYSIOTHERAPEUTEN\n      </div>\n\n      <h2 class=\"sorelya-pressure-title\">\n        DRUCK, BESCHWERDEN, TAUBHEITSGEFÜHLE…<br>\n<span>BREMST SIE IHR SATTEL AUS?</span>\n      </h2>\n\n      <p class=\"sorelya-pressure-intro\">\n        Sorelya setzt genau dort an, wo Ihnen die Tour verdorben wird.\n      </p>\n\n      <div class=\"sorelya-pressure-pain-grid\">\n        <div class=\"sorelya-pressure-pain-item\">\n          <strong>STEISSBEIN</strong>\n          <span>Druck besser verteilt</span>\n        </div>\n\n        <div class=\"sorelya-pressure-pain-item\">\n          <strong>DAMMBEREICH</strong>\n          <span>Entlastungskanal frei</span>\n        </div>\n\n        <div class=\"sorelya-pressure-pain-item\">\n          <strong>GESÄSS</strong>\n          <span>Fester, stabiler Halt</span>\n        </div>\n\n        <div class=\"sorelya-pressure-pain-item\">\n          <strong>TAUBHEITSGEFÜHLE</strong>\n          <span>Weniger direkter Druck</span>\n        </div>\n      </div>\n\n      <div class=\"sorelya-pressure-highlight-card\">\n        <div class=\"sorelya-pressure-made-de\">\n          <span class=\"sorelya-pressure-de-flag\" aria-hidden=\"true\">\n            <span></span><span></span><span></span>\n          </span>\n          <span>DEUTSCHE FERTIGUNG</span>\n        </div>\n\n        <span class=\"sorelya-pressure-highlight-label\">EINE ECHTE LÖSUNG FÜRS SITZEN</span>\n        <strong>Ergonomische Form. Entlastungskanal. Stabiler Halt.</strong>\n        <p>\n          Besser verteilter Druck, der Steißbein, Dammbereich und die empfindlichen Zonen entlastet.\n        </p>\n      </div>\n\n      <div class=\"sorelya-pressure-proof-row\">\n        <div class=\"sorelya-pressure-proof-item\">\n          <strong>DRUCK BESSER VERTEILT</strong>\n          <span>Damit nicht ein einziger Punkt die ganze Last trägt.</span>\n        </div>\n\n        <div class=\"sorelya-pressure-proof-item\">\n          <strong>KOMFORT, DER BLEIBT</strong>\n          <span>3D+ Schaum und festes Gel – auch auf langen Touren.</span>\n        </div>\n      </div>\n\n      <!-- IMAGE 2 : visuel comparaison -->\n      <div class=\"sorelya-pressure-choice-image\">\n        <img\n          src={{ 'sorelya_3_schichten.jpg' | asset_url }}\"\n          alt=\"Sorelya 3 Komfortschichten\"\n          class=\"sorelya-pressure-choice-image__media\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"sorelya-pressure-choice-head\">\n        <span>ZWEI SITZFLÄCHEN. EINE EINFACHE WAHL.</span>\n        <h3>WÄHLEN SIE NACH IHRER SITZPOSITION</h3>\n      </div>\n\n      <!-- IMAGE 3 : comparatif Sport Pro / Confort Pro -->\n      <div class=\"sorelya-pressure-choice-image\">\n        <img\n          src=\"{{ 'sorelya_modellvergleich.jpg' | asset_url }}\"\n          alt=\"Welcher Sorelya Sattel passt zu Ihnen: Sport Pro und Komfort Pro im Vergleich\"\n          class=\"sorelya-pressure-choice-image__media\"\n          loading=\"lazy\"\n        >\n      </div>\n\n      <div class=\"sorelya-pressure-variant-grid\">\n\n        <div class=\"sorelya-pressure-variant-card sorelya-pressure-variant-comfort\">\n          <span>DIE BREITESTE SITZFLÄCHE</span>\n          <strong>KOMFORT PRO</strong>\n          <p>Aufrechtere Haltung.</p>\n          <em class=\"sorelya-pressure-variant-bikes\">E-Bike · Citybike · Touren</em>\n          <ul>\n            <li>Maximaler Komfort</li>\n            <li>Umschließender Halt</li>\n            <li>Druck auf größerer Fläche</li>\n          </ul>\n        </div>\n\n        <div class=\"sorelya-pressure-variant-card sorelya-pressure-variant-sport\">\n          <span>DIE DYNAMISCHERE SITZFLÄCHE</span>\n          <strong>SPORT PRO</strong>\n          <p>Leicht gebeugte Haltung.</p>\n          <em class=\"sorelya-pressure-variant-bikes\">MTB · Trekkingrad · Rennrad</em>\n          <ul>\n            <li>Verstärkter Halt</li>\n            <li>Dauerhafte Stabilität</li>\n            <li>Ideal für regelmäßiges Fahren</li>\n          </ul>\n        </div>\n\n      </div>\n\n      <div class=\"sorelya-pressure-compatibility\">\n        <strong>BEIDE MODELLE PASSEN AUF JEDEN FAHRRADTYP.</strong>\n        <span>Die richtige Wahl hängt von Ihrer Haltung ab, nicht von Ihrem Fahrrad.</span>\n      </div>\n\n      <div class=\"sorelya-pressure-offer-block\">\n        <a\n          href=\"#\"\n          id=\"sorelya-pressure-cta\"\n          class=\"sorelya-pressure-offer-btn\"\n        >\n          <span>MEINEN SORELYA SATTEL WÄHLEN</span>\n          <strong>30 TAGE ZUM TESTEN</strong>\n        </a>\n\n        <p class=\"sorelya-pressure-mini-urgency\">\n          Lieferung in 1–3 Werktagen · 30 Tage Geld-zurück-Garantie · 5 Jahre Garantie\n        </p>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  #sorelya-pressure-balance-section {\n    width: 100%;\n    padding: 0 14px 32px;\n    overflow-x: hidden;\n    box-sizing: border-box;\n    background: #ffffff;\n    color: #111111;\n    font-family: Poppins, Arial, sans-serif;\n    -webkit-text-size-adjust: 100%;\n  }\n\n  #sorelya-pressure-balance-section * {\n    box-sizing: border-box;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-wrap {\n    max-width: 760px;\n    margin: 0 auto;\n    background: #ffffff;\n  }\n\n  /* ===== IMAGE PLEINE LARGEUR ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-image-shell {\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-bottom: clamp(12px, 3.5vw, 16px);\n    overflow: hidden;\n    background: #052E57;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-image {\n    display: block;\n    width: 100%;\n    object-fit: cover;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-content {\n    width: 100%;\n    max-width: 640px;\n    margin: 0 auto;\n  }\n\n  /* ===== BADGE HAUT ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-top-badge {\n    width: 100%;\n    margin: 0 auto clamp(12px, 3.3vw, 14px);\n    padding: clamp(9px, 2.6vw, 11px) clamp(10px, 2.8vw, 13px);\n    border-radius: 10px;\n    background: #052E57;\n    color: #ffffff;\n    box-shadow: 0 8px 20px rgba(5, 46, 87, 0.18);\n    font-size: clamp(10.8px, 3vw, 12px);\n    line-height: 1.35;\n    font-weight: 700;\n    letter-spacing: 0.2px;\n    text-align: center;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  /* ===== TITRE ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-title {\n    margin: 0 auto clamp(7px, 2vw, 9px);\n    color: #000000;\n    font-size: clamp(24px, 7vw, 32px);\n    line-height: 1.08;\n    font-weight: 700;\n    letter-spacing: -0.5px;\n    text-align: center;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-title span {\n    color: #052E57;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-intro {\n    margin: 0 auto clamp(14px, 3.9vw, 17px);\n    color: #333333;\n    font-size: clamp(14px, 3.8vw, 15px);\n    line-height: 1.45;\n    font-weight: 600;\n    text-align: center;\n  }\n\n  /* ===== GRILLE DES DOULEURS ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-pain-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: clamp(8px, 2.2vw, 9px);\n    margin-bottom: clamp(10px, 2.8vw, 12px);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-pain-item {\n    padding: clamp(11px, 3vw, 13px) clamp(8px, 2.2vw, 11px);\n    border: 1px solid rgba(5, 46, 87, 0.13);\n    border-radius: 12px;\n    background: #f7faff;\n    box-shadow: 0 5px 14px rgba(5, 46, 87, 0.05);\n    text-align: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-pain-item strong {\n    display: block;\n    margin-bottom: 4px;\n    color: #052E57;\n    font-size: clamp(12.5px, 3.4vw, 13.5px);\n    line-height: 1.15;\n    font-weight: 700;\n    overflow-wrap: break-word;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-pain-item span {\n    display: block;\n    color: #222222;\n    font-size: clamp(12.2px, 3.3vw, 13px);\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  /* ===== CARTE SOLUTION ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-highlight-card {\n    position: relative;\n    margin-bottom: clamp(11px, 3vw, 13px);\n    padding: clamp(15px, 4.2vw, 18px) clamp(13px, 3.6vw, 17px) clamp(14px, 3.9vw, 17px);\n    overflow: hidden;\n    border: 1px solid rgba(5, 46, 87, 0.16);\n    border-radius: 14px;\n    background: linear-gradient(180deg, #ffffff 0%, #f4f8fc 100%);\n    box-shadow: 0 8px 22px rgba(5, 46, 87, 0.08);\n    text-align: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-highlight-card::before {\n    position: absolute;\n    top: 0;\n    left: 50%;\n    width: 72px;\n    height: 4px;\n    border-radius: 0 0 999px 999px;\n    background: #052E57;\n    content: \"\";\n    transform: translateX(-50%);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-made-de {\n    display: inline-flex;\n    margin: 0 auto 10px;\n    padding: 7px 11px;\n    align-items: center;\n    justify-content: center;\n    gap: 7px;\n    border: 1px solid rgba(5, 46, 87, 0.14);\n    border-radius: 999px;\n    background: #ffffff;\n    box-shadow: 0 4px 12px rgba(5, 46, 87, 0.06);\n    color: #052E57;\n    font-size: clamp(9.5px, 2.6vw, 10px);\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: 0.35px;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-de-flag {\n    display: inline-grid;\n    width: 24px;\n    height: 16px;\n    min-width: 24px;\n    overflow: hidden;\n    grid-template-rows: repeat(3, 1fr);\n    border: 1px solid rgba(0, 0, 0, 0.08);\n    border-radius: 3px;\n    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-de-flag span:nth-child(1) {\n    background: #000000;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-de-flag span:nth-child(2) {\n    background: #DD0000;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-de-flag span:nth-child(3) {\n    background: #FFCE00;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-highlight-label {\n    display: block;\n    margin: 0 auto 7px;\n    color: #052E57;\n    font-size: clamp(10px, 2.7vw, 10.5px);\n    line-height: 1.15;\n    font-weight: 700;\n    letter-spacing: 0.45px;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-highlight-card strong {\n    display: block;\n    max-width: 470px;\n    margin: 0 auto 5px;\n    color: #111111;\n    font-size: clamp(13.8px, 3.8vw, 15.5px);\n    line-height: 1.35;\n    font-weight: 700;\n    text-align: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-highlight-card p {\n    max-width: 500px;\n    margin: 0 auto;\n    color: #333333;\n    font-size: clamp(13.2px, 3.6vw, 14px);\n    line-height: 1.45;\n    font-weight: 600;\n    text-align: center;\n  }\n\n  /* ===== PREUVES ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-proof-row {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: clamp(8px, 2.2vw, 9px);\n    margin-bottom: clamp(16px, 4.4vw, 19px);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-proof-item {\n    padding: clamp(12px, 3.3vw, 13px) clamp(10px, 2.8vw, 12px);\n    border: 1px solid rgba(5, 46, 87, 0.14);\n    border-radius: 12px;\n    background: #ffffff;\n    box-shadow: 0 6px 16px rgba(5, 46, 87, 0.06);\n    text-align: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-proof-item strong {\n    display: block;\n    margin-bottom: 4px;\n    color: #052E57;\n    font-size: clamp(11.8px, 3.2vw, 12.5px);\n    line-height: 1.25;\n    font-weight: 700;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-proof-item span {\n    display: block;\n    color: #222222;\n    font-size: clamp(12.5px, 3.4vw, 13px);\n    line-height: 1.4;\n    font-weight: 500;\n  }\n\n  /* ===== IMAGES COMPARAISON / COMPARATIF ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-choice-image {\n    width: 100%;\n    margin: 0 auto clamp(13px, 3.6vw, 15px);\n    overflow: hidden;\n    border-radius: 14px;\n    background: #ffffff;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-choice-image__media {\n    display: block;\n    width: 100%;\n    height: auto;\n    object-fit: contain;\n  }\n\n  /* ===== TITRE CHOIX ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-choice-head {\n    margin: 0 auto clamp(10px, 2.8vw, 12px);\n    text-align: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-choice-head span {\n    display: block;\n    margin-bottom: 4px;\n    color: #052E57;\n    font-size: clamp(10.5px, 2.9vw, 11px);\n    line-height: 1.15;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-choice-head h3 {\n    margin: 0;\n    color: #111111;\n    font-size: clamp(18px, 5vw, 20px);\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: -0.3px;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  /* ===== CARTES MODÈLES ===== */\n  #sorelya-pressure-balance-section .sorelya-pressure-variant-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: clamp(9px, 2.5vw, 11px);\n    margin-bottom: clamp(10px, 2.8vw, 12px);\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-variant-card {\n    padding: clamp(14px, 3.9vw, 16px) clamp(12px, 3.3vw, 14px) clamp(13px, 3.6vw, 15px);\n    border: 1.5px solid rgba(5, 46, 87, 0.18);\n    border-radius: 14px;\n    background: #ffffff;\n    box-shadow: 0 8px 22px rgba(5, 46, 87, 0.08);\n    text-align: center;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-variant-card > span {\n    display: inline-flex;\n    margin: 0 auto 8px;\n    padding: 6px 10px;\n    border-radius: 999px;\n    background: #052E57;\n    color: #ffffff;\n    font-size: clamp(9.5px, 2.6vw, 10px);\n    line-height: 1;\n    font-weight: 700;\n    letter-spacing: 0.35px;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-variant-card > strong {\n    display: block;\n    margin-bottom: 4px;\n    color: #052E57;\n    font-size: clamp(18px, 5vw, 19px);\n    line-height: 1.12;\n    font-weight: 700;\n    text-transform: uppercase;\n  }\n\n  #sorelya-pressure-balance-section .sorelya-pressure-variant-card > p {\n    margin: 0 0 4px;\n    color: #111111;\n    font-size: clamp(13px, 3.6vw, 13.5px);\n    l