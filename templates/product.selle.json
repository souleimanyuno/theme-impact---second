        "remove_horizontal_spacing": true,
        "liquid": "<section id=\"shopify-section-sorelya__custom_liquid_XDx3tm\" class=\"shopify-section section\"><style data-shopify>.section-sorelya__custom_liquid_XDx3tm-padding {\n    padding-top: calc(0px * 0.75);\n    padding-bottom: calc(0px  * 0.75);\n  }\n\n  @media screen and (min-width: 750px) {\n    .section-sorelya__custom_liquid_XDx3tm-padding {\n      padding-top: 0px;\n      padding-bottom: 0px;\n    }\n  }</style><div class=\"color-background-1 gradient content-for-grouping always-display\">\n  \n  <div class=\"section-sorelya__custom_liquid_XDx3tm-padding\">\n    <section id=\"sorelya-install-section\">\n  <div class=\"sorelya-install-wrap\">\n\n    <div class=\"sorelya-install-video-shell\">\n      <video\n        class=\"sorelya-install-video\"\n        autoplay\n        loop\n        muted\n        playsinline\n        preload=\"metadata\"\n      >\n        <source src=\"{{ 'sorelya_montage.mp4' | asset_url }}\" type=\"video/mp4\">\n      </video>\n\n      <div class=\"sorelya-install-video-badge\">⏱ Montage in Echtzeit</div>\n    </div>\n\n    <div class=\"sorelya-install-content\">\n\n      <h2 class=\"sorelya-install-title\">\n        WENIGER ALS 2 MINUTEN<br>\n        <span>UND ER SITZT</span>\n      </h2>\n\n      <p class=\"sorelya-install-intro\">\n        Sie müssen kein Handwerker sein und brauchen keine Fahrradwerkstatt. Sehen Sie sich das Video oben an: Sorelya wird mit wenigen Handgriffen auf Ihrer vorhandenen Sattelstütze befestigt – mit Werkzeug, das Sie zu Hause schon haben.\n      </p>\n\n      <div class=\"sorelya-install-highlight-card\">\n        <strong>\n          Keinerlei technische Kenntnisse nötig: Wenn Sie eine Schraube festziehen können, können Sie Sorelya montieren.\n        </strong>\n      </div>\n\n      <div class=\"sorelya-install-steps\">\n\n        <div class=\"sorelya-install-step\">\n          <span class=\"sorelya-install-step-number\">1</span>\n          <div class=\"sorelya-install-step-text\">\n            <strong>Alten Sattel abnehmen</strong>\n            <p>\n              Lösen Sie die Klemmung der Sattelstütze und nehmen Sie den alten Sattel ab. Ein einziger Schlüssel genügt – er liegt Ihrem Sorelya Sattel bei.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"sorelya-install-step\">\n          <span class=\"sorelya-install-step-number\">2</span>\n          <div class=\"sorelya-install-step-text\">\n            <strong>Sorelya auf die Stütze setzen</strong>\n            <p>\n              Die Universalstreben von Sorelya passen auf jedes Fahrrad mit Standard-Sattelstütze: Citybike, E-Bike, MTB, Rennrad oder Gravel.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"sorelya-install-step\">\n          <span class=\"sorelya-install-step-number\">3</span>\n          <div class=\"sorelya-install-step-text\">\n            <strong>Neigung einstellen und losfahren</strong>\n            <p>\n              Stellen Sie die Neigung in Sekunden ein, ziehen Sie die Klemmung wieder fest – und sitzen Sie ab sofort stabiler und besser verteilt.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n      <div class=\"sorelya-install-compatibility\">\n        <strong>Passt auf 100 % der Fahrräder mit Standard-Sattelstütze:</strong>\n        <span>\n          kein Bohren, kein Umbau, kein Adapter, den Sie extra bestellen müssen.\n        </span>\n      </div>\n\n      <p class=\"sorelya-install-closing\">\n        <strong>Es gibt keinen Grund mehr, auf einem unbequemen Sattel zu bleiben.</strong>\n        Der Einbau dauert nur 2 Minuten und gelingt mit dem Werkzeug, das Sie schon haben. Um den Rest kümmert sich Sorelya.\n      </p>\n\n      <div class=\"sorelya-install-offer-block\">\n        <a\n          href=\"#\"\n          id=\"sorelya-install-cta\"\n          class=\"sorelya-install-offer-btn\"\n        >\n          <span>MEINEN SORELYA SATTEL WÄHLEN</span>\n          <strong>+ HANDYHALTERUNG GRATIS</strong>\n        </a>\n\n        <p class=\"sorelya-install-mini-urgency\">\n          Lieferung in 1–3 Werktagen · 30 Tage Geld-zurück-Garantie · 5 Jahre Garantie\n        </p>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  #sorelya-install-section {\n    width: 100%;\n    padding: 0 14px 32px;\n    overflow-x: hidden;\n    box-sizing: border-box;\n    background: #ffffff;\n    color: #111111;\n    font-family: Poppins, Arial, sans-serif;\n    -webkit-text-size-adjust: 100%;\n  }\n\n  #sorelya-install-section * {\n    box-sizing: border-box;\n  }\n\n  #sorelya-install-section .sorelya-install-wrap {\n    max-width: 760px;\n    margin: 0 auto;\n    background: #ffffff;\n  }\n\n  /* ===== VIDÉO ===== */\n  #sorelya-install-section .sorelya-install-video-shell {\n    position: relative;\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-bottom: clamp(12px, 3.5vw, 16px);\n    overflow: hidden;\n    background: #052E57;\n  }\n\n  #sorelya-install-section .sorelya-install-video {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n\n  #sorelya-install-section .sorelya-install-video-badge {\n    position: absolute;\n    bottom: 10px;\n    left: 12px;\n    padding: 7px 12px;\n    border-radius: 999px;\n    background: rgba(5, 46, 87, 0.92);\n    color: #ffffff;\n    font-size: clamp(11px, 3vw, 12.5px);\n    line-height: 1;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n\n  #sorelya-install-section .sorelya-install-content {\n    width: 100%;\n    max-width: 640px;\n    margin: 0 auto;\n  }\n\n  /* ===== TITRE ===== */\n  #sorelya-install-section .sorelya-install-title {\n    margin: 0 auto clamp(9px, 2.5vw, 12px);\n    color: #000000;\n    font-size: clamp(25px, 7.5vw, 32px);\n    line-height: 1.08;\n    font-weight: 700;\n    letter-spacing: -0.5px;\n    text-align: center;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  #sorelya-install-section .sorelya-install-title span {\n    colo