            "liquid": "<div class=\"sorelya-pay-img\" style=\"text-align:center;margin:10px 0 14px;\">\n  <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Capture_d_ecran_le_2026-10-04_a_00.41.04_430x.png?v=1791089027\"\n       alt=\"Sichere Zahlung: Visa, Mastercard, PayPal, American Express, Apple Pay, Google Pay, Shop Pay\"\n       width=\"430\" style=\"display:inline-block;width:100%;max-width:300px;height:auto;\" loading=\"lazy\">\n</div>\n<script>\n  /* Libellé du bouton d'achat en allemand sur cette page (la boutique est en espagnol par défaut) */\n  (function () {\n    var MAP = {\n      'añadir a la cesta':'➜ IN DEN WARENKORB','add to cart':'➜ IN DEN WARENKORB','ajouter au panier':'➜ IN DEN WARENKORB','in den warenkorb':'➜ IN DEN WARENKORB',\n      'agotado':'Ausverkauft','sold out':'Ausverkauft','épuisé':'Ausverkauft',\n      'no disponible':'Nicht verfügbar','unavailable':'Nicht verfügbar','indisponible':'Nicht verfügbar'\n    };\n    function fix(root) {\n      (root || document).querySelectorAll('buy-buttons button[type=\"submit\"]').forEach(function (btn) {\n        var el = btn.querySelector('.text-with-icon') || btn;\n        var walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);\n        var n; while ((n = walker.nextNode())) {\n          var k = n.nodeValue.trim().toLowerCase();\n          if (k && MAP[k] && n.nodeValue.trim() !== MAP[k]) { n.nodeValue = MAP[k]; }\n        }\n      });\n    }\n    function start() {\n      fix();\n      new MutationObserver(function () { fix(); }).observe(document.body, { childList: true, subtree: true, characterData: true });\n    }\n    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', start); } else { start(); }\n  })();\n</script>\n<style>\n  .srxp{max-width:560px;margin:0 auto;font-family:inherit;-webkit-text-size-adjust:100%}\n  .srxp *,.srxp *::before,.srxp *::after{box-sizing:border-box}\n  .srxp .srx-pay{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:11px}\n  .srxp .srx-pay svg{height:22px;width:auto}\n</style>\n<!-- ============================================================\n     BLOC OBJECTION — \"Vous doutez encore ?\"\n     Placement : sous le bouton d'ajout au panier, AVANT la mini-FAQ.\n\n     Harmonisation : l'encadré de garantie reprend exactement les\n     verts du bandeau \"Essai 30 jours sans risque\" du bundle, pour\n     que le client retrouve le meme code couleur de reassurance.\n     Le haut du bloc reste neutre : le vert doit signaler la sortie\n     de secours, pas le probleme.\n     ============================================================ -->\n<div class=\"sorelya-objection\">\n\n  <div class=\"sorelya-objection__title\">\n    <span class=\"sorelya-objection__icon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\">\n        <path d=\"M12 3l7 3v5.5c0 4.3-2.9 8.2-7 9.5-4.1-1.3-7-5.2-7-9.5V6l7-3z\"\n              fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"\n              stroke-linejoin=\"round\"/>\n        <path d=\"M9 12l2 2 4-4\" fill=\"none\" stroke=\"currentColor\"\n              stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </span>\n    <span>Zweifeln Sie noch am Komfort?</span>\n  </div>\n\n  <p class=\"sorelya-objection__text\">\n    Das ist normal. <strong>8 von 10 unserer Käufer</strong> hatten vorher schon etwas anderes probiert – einen anderen Sattel, einen Gel-Sattelbezug, eine gepolsterte Radhose – <strong>ohne den erhofften Komfort zu bekommen.</strong>\n  </p>\n\n  <div class=\"sorelya-objection__guarantee\">\n    <span class=\"sorelya-objection__gicon\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\">\n        <path d=\"M20 6L9 17l-5-5\" fill=\"none\" stroke=\"currentColor\"\n              stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </span>\n    <p class=\"sorelya-objection__gtext\">\n      <strong>Testen Sie Sorelya 30 Tage auf Ihrem eigenen Fahrrad,</strong> auf Ihren echten Touren. Wenn er Ihnen nicht zusagt, genügt eine einfache E-Mail: Sie bekommen Ihr Geld zurück, ohne Begründung.\n    </p>\n  </div>\n\n</div>\n\n<style>\n  .sorelya-objection,\n  .sorelya-objection * {\n    box-sizing: border-box;\n  }\n\n  .sorelya-objection {\n    width: 100%;\n    margin: 14px 0 10px;\n    padding: 16px 15px;\n    font-family: inherit;\n    color: #273746;\n    background: #ffffff;\n    border: 1px solid #dde5ec;\n    border-radius: 12px;\n    box-shadow: 0 3px 10px rgba(5, 46, 87, .05);\n  }\n\n  /* ===== Titre ===== */\n  .sorelya-objection__title {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 10px;\n    color: #052e57;\n    font-size: 17.5px;\n    font-weight: 700;\n    line-height: 1.3;\n    letter-spacing: -.2px;\n  }\n\n  .sorelya-objection__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 32px;\n    width: 32px;\n    height: 32px;\n    color: #052e57;\n    background: #eaf1f8;\n    border-radius: 50%;\n  }\n\n  /* ===== Constat ===== */\n  .sorelya-objection__text {\n    margin: 0 0 13px;\n    color: #3a4756;\n    font-size: 15.5px;\n    font-weight: 400;\n    line-height: 1.55;\n  }\n\n  .sorelya-objection__text strong {\n    color: #052e57;\n    font-weight: 700;\n  }\n\n  /* ===== Garantie — memes verts que le bandeau du bundle ===== */\n  .sorelya-objection__guarantee {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    margin: 0;\n    padding: 13px 14px;\n    background: #eff8f1;\n    border: 1px solid #a8d5b6;\n    border-left: 4px solid #2e8b57;\n    border-radius: 9px;\n  }\n\n  .sorelya-objection__gicon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 26px;\n    width: 26px;\n    height: 26px;\n    margin-top: 1px;\n    color: #ffffff;\n    background: #2e8b57;\n    border-radius: 50%;\n  }\n\n  .sorelya-objection__gtext {\n    flex: 1;\n    min-width: 0;\n    margin: 0;\n    color: #2c5c40;\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.52;\n  }\n\n  .sorelya-objection__gtext strong {\n    color: #17532f;\n    font-weight: 700;\n  }\n\n  /* ===== Mobile ===== */\n  @media screen and (max-width: 749px) {\n\n    .sorelya-objection {\n      margin: 13px 0 9px;\n      padding: 15px 14px;\n    }\n\n    .sorelya-objection__title {\n      gap: 9px;\n      font-size: 16.5px;\n    }\n\n    .sorelya-objection__icon {\n      flex: 0 0 30px;\n      width: 30px;\n      height: 30px;\n    }\n\n    .sorelya-objection__text {\n      margin-bottom: 12px;\n      font-size: 15px;\n    }\n\n    .sorelya-objection__guarantee {\n      gap: 9px;\n      padding: 12px 12px;\n    }\n\n    .sorelya-objection__gicon {\n      flex: 0 0 24px;\n      width: 24px;\n      height: 24px;\n    }\n\n    .sorelya-objection__gtext {\n      font-size: 14.5px;\n    }\n  }\n</style>\n"
