    "custom_liquid_rkNFEW": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-proof-ba\">\n  <div class=\"sor-ba-text\">\n    <h3>Wanneer de doorstroming <em>stokt</em>, voel je het</h3>\n    <p>Je voelt een trage lymfestroom terug in je huid, je energie en je dagelijkse comfort. Zie het verschil tussen een geblokkeerd lichaam en een lichaam dat weer doorstroomt.</p>\n  </div>\n\n  <div class=\"sor-ba-slider\" id=\"sorBa\">\n    <img class=\"sor-ba-img sor-ba-after\" src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_220100_8667a587-6a53-465e-bdd0-bc578cd76fc2_430x.png?v=1785612903\" alt=\"Na\" draggable=\"false\">\n    <img class=\"sor-ba-img sor-ba-before\" id=\"sorBaBefore\" src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_215708_81c996c7-e7dd-45bc-a929-2b41fea0f567_430x.png?v=1785612903\" alt=\"Voor\" draggable=\"false\">\n    <span class=\"sor-ba-tag sor-ba-tag-l\">VOOR</span>\n    <span class=\"sor-ba-tag sor-ba-tag-r\">NA</span>\n    <div class=\"sor-ba-handle\" id=\"sorBaHandle\">\n      <span class=\"sor-ba-knob\">\n        <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M10 8l-4 4 4 4M14 8l4 4-4 4\"/></svg>\n      </span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var box = document.getElementById('sorBa');\n  if(!box) return;\n  var before = document.getElementById('sorBaBefore');\n  var handle = document.getElementById('sorBaHandle');\n  var dragging = false;\n\n  function setPos(clientX){\n    var r = box.getBoundingClientRect();\n    var pct = ((clientX - r.left) / r.width) * 100;\n    if(pct < 2) pct = 2;\n    if(pct > 98) pct = 98;\n    before.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';\n    handle.style.left = pct + '%';\n  }\n\n  function start(e){ dragging = true; move(e); }\n  function stop(){ dragging = false; }\n  function move(e){\n    if(!dragging) return;\n    var x = e.touches ? e.touches[0].clientX : e.clientX;\n    setPos(x);\n  }\n\n  before.style.clipPath = 'inset(0 50% 0 0)';\n\n  box.addEventListener('mousedown', start);\n  box.addEventListener('touchstart', start, {passive:true});\n  window.addEventListener('mousemove', move);\n  window.addEventListener('touchmove', move, {passive:true});\n  window.addEventListener('mouseup', stop);\n  window.addEventListener('touchend', stop);\n})();\n</script>\n\n<style>\n.sor-proof-ba{display:flex;flex-direction:column;gap:20px;}\n.sor-ba-text h3{font-size:21px;font-weight:800;color:#1a1a1a;margin:0 0 10px;line-height:1.25;}\n.sor-ba-text h3 em{font-style:italic;}\n.sor-ba-text p{font-size:13.5px;line-height:1.55;color:#5a5a5a;margin:0;}\n\n.sor-ba-slider{\n  position:relative;\n  width:100%;\n  aspect-ratio:1/1;\n  border-radius:14px;\n  overflow:hidden;\n  user-select:none;\n  cursor:ew-resize;\n  touch-action:pan-y;\n}\n\n/* les 2 images sont strictement identiques et superposées */\n.sor-ba-img{\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  object-position:center;\n  display:block;\n  pointer-events:none;\n}\n.sor-ba-after{z-index:1;}\n.sor-ba-before{z-index:2;clip-path:inset(0 50% 0 0);}\n\n.sor-ba-tag{\n  position:absolute;\n  top:10px;\n  background:rgba(160,135,107,0.92);\n  color:#fff;\n  font-size:10.5px;\n  font-weight:800;\n  letter-spacing:0.08em;\n  padding:5px 10px;\n  border-radius:4px;\n  z-index:4;\n}\n.sor-ba-tag-l{left:10px;}\n.sor-ba-tag-r{right:10px;}\n\n.sor-ba-handle{\n  position:absolute;\n  top:0;bottom:0;\n  left:50%;\n  width:2px;\n  background:#fff;\n  transform:translateX(-1px);\n  z-index:3;\n  pointer-events:none;\n}\n.sor-ba-knob{\n  position:absolute;\n  top:50%;left:50%;\n  transform:translate(-50%,-50%);\n  width:38px;height:38px;\n  border-radius:50%;\n  background:rgba(255,255,255,0.25);\n  border:2px solid #fff;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  backdrop-filter:blur(2px);\n}\n\n@media (min-width:750px){\n  .sor-proof-ba{flex-direction:row;align-items:center;gap:48px;}\n  .sor-ba-text{width:45%;}\n  .sor-ba-text h3{font-size:30px;}\n  .sor-ba-text p{font-size:16px;}\n  .sor-ba-slider{width:55%;}\n}\n</style>",
