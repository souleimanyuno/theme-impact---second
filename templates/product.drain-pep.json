    "custom_liquid_ThaW7H": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-why\">\n\n  <div class=\"sor-why-head\">\n    <h2>Waarom kiezen voor <em>Sorelya</em>?</h2>\n    <p>Een zachte plantaardige formule die de lymfestroom ondersteunt, je inwendige balans herstelt en zichtbaar resultaat geeft zonder de bijwerkingen van een agressief diureticum. Vergelijk en ontdek waarom vrouwen hun diuretica inruilen voor Sorelya.</p>\n  </div>\n\n  <div class=\"sor-why-table\">\n\n    <div class=\"sor-why-header\">\n      <div class=\"sor-why-h-empty\"></div>\n      <div class=\"sor-why-h-us\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/NELORYA_21_0c5b4df4-f148-4819-825c-bc9d5f07b149_430x.png?v=1785616476\" alt=\"Sorelya\" loading=\"lazy\">\n        <span>Sorelya</span>\n      </div>\n      <div class=\"sor-why-h-them\">Andere<br>merken</div>\n    </div>\n\n    <div class=\"sor-why-row\">\n      <div class=\"sor-why-label\">Ondersteunt een gezonde lymfestroom</div>\n      <div class=\"sor-why-us sor-why-us-first\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"#4ADE9B\"><path d=\"M12 1.8l2.1 1.5 2.5-.3.9 2.4 2.3 1.1-.5 2.5 1.5 2.1-1.5 2.1.5 2.5-2.3 1.1-.9 2.4-2.5-.3L12 20.4l-2.1-1.5-2.5.3-.9-2.4-2.3-1.1.5-2.5L3.2 11l1.5-2.1-.5-2.5 2.3-1.1.9-2.4 2.5.3z\"/><path d=\"M9.3 11.4l1.9 1.9 3.6-3.8\" stroke=\"#0B3B2A\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <div class=\"sor-why-them\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#C94A4A\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"sor-why-row\">\n      <div class=\"sor-why-label\">Compleet inwendig evenwicht circulatie, spijsvertering en energie</div>\n      <div class=\"sor-why-us\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"#4ADE9B\"><path d=\"M12 1.8l2.1 1.5 2.5-.3.9 2.4 2.3 1.1-.5 2.5 1.5 2.1-1.5 2.1.5 2.5-2.3 1.1-.9 2.4-2.5-.3L12 20.4l-2.1-1.5-2.5.3-.9-2.4-2.3-1.1.5-2.5L3.2 11l1.5-2.1-.5-2.5 2.3-1.1.9-2.4 2.5.3z\"/><path d=\"M9.3 11.4l1.9 1.9 3.6-3.8\" stroke=\"#0B3B2A\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <div class=\"sor-why-them\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#C94A4A\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"sor-why-row\">\n      <div class=\"sor-why-label\">Zacht maar effectief geen agressief diureticum</div>\n      <div class=\"sor-why-us\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"#4ADE9B\"><path d=\"M12 1.8l2.1 1.5 2.5-.3.9 2.4 2.3 1.1-.5 2.5 1.5 2.1-1.5 2.1.5 2.5-2.3 1.1-.9 2.4-2.5-.3L12 20.4l-2.1-1.5-2.5.3-.9-2.4-2.3-1.1.5-2.5L3.2 11l1.5-2.1-.5-2.5 2.3-1.1.9-2.4 2.5.3z\"/><path d=\"M9.3 11.4l1.9 1.9 3.6-3.8\" stroke=\"#0B3B2A\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <div class=\"sor-why-them\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#C94A4A\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"sor-why-row\">\n      <div class=\"sor-why-label\">100% plantaardige extracten zonder alcohol, suiker of gluten</div>\n      <div class=\"sor-why-us\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"#4ADE9B\"><path d=\"M12 1.8l2.1 1.5 2.5-.3.9 2.4 2.3 1.1-.5 2.5 1.5 2.1-1.5 2.1.5 2.5-2.3 1.1-.9 2.4-2.5-.3L12 20.4l-2.1-1.5-2.5.3-.9-2.4-2.3-1.1.5-2.5L3.2 11l1.5-2.1-.5-2.5 2.3-1.1.9-2.4 2.5.3z\"/><path d=\"M9.3 11.4l1.9 1.9 3.6-3.8\" stroke=\"#0B3B2A\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <div class=\"sor-why-them\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#C94A4A\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"sor-why-row\">\n      <div class=\"sor-why-label\">Onafhankelijk geteste batches</div>\n      <div class=\"sor-why-us\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"#4ADE9B\"><path d=\"M12 1.8l2.1 1.5 2.5-.3.9 2.4 2.3 1.1-.5 2.5 1.5 2.1-1.5 2.1.5 2.5-2.3 1.1-.9 2.4-2.5-.3L12 20.4l-2.1-1.5-2.5.3-.9-2.4-2.3-1.1.5-2.5L3.2 11l1.5-2.1-.5-2.5 2.3-1.1.9-2.4 2.5.3z\"/><path d=\"M9.3 11.4l1.9 1.9 3.6-3.8\" stroke=\"#0B3B2A\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <div class=\"sor-why-them\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#C94A4A\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/></svg>\n      </div>\n    </div>\n\n    <div class=\"sor-why-row\">\n      <div class=\"sor-why-label\">Zichtbaar verschil in 7-14 dagen</div>\n      <div class=\"sor-why-us sor-why-us-last\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"#4ADE9B\"><path d=\"M12 1.8l2.1 1.5 2.5-.3.9 2.4 2.3 1.1-.5 2.5 1.5 2.1-1.5 2.1.5 2.5-2.3 1.1-.9 2.4-2.5-.3L12 20.4l-2.1-1.5-2.5.3-.9-2.4-2.3-1.1.5-2.5L3.2 11l1.5-2.1-.5-2.5 2.3-1.1.9-2.4 2.5.3z\"/><path d=\"M9.3 11.4l1.9 1.9 3.6-3.8\" stroke=\"#0B3B2A\" stroke-width=\"1.8\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <div class=\"sor-why-them\">\n        <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"#C94A4A\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9 9l6 6M15 9l-6 6\"/></svg>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n.sor-why{font-family:inherit;max-width:100%;}\n\n.sor-why-head{margin-bottom:26px;}\n.sor-why-head h2{\n  font-size:22px;\n  font-weight:800;\n  color:#1a1a1a;\n  line-height:1.25;\n  margin:0 0 10px;\n}\n.sor-why-head h2 em{font-style:italic;}\n.sor-why-head p{\n  font-size:13.5px;\n  line-height:1.55;\n  color:#5a5a5a;\n  margin:0;\n}\n\n.sor-why-table{\n  background:#EAF7F0;\n  border-radius:14px;\n  padding:0 10px 10px;\n}\n\n.sor-why-header{\n  display:grid;\n  grid-template-columns:1fr 68px 68px;\n  align-items:end;\n  gap:0;\n}\n.sor-why-h-us{\n  background:transparent;\n  text-align:center;\n  padding-bottom:6px;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:2px;\n}\n.sor-why-h-us img{\n  width:44px;\n  height:auto;\n  display:block;\n  margin-bottom:-2px;\n}\n.sor-why-h-us span{\n  font-size:11px;\n  font-weight:800;\n  color:#0B3B2A;\n}\n.sor-why-h-them{\n  text-align:center;\n  font-size:11px;\n  font-weight:700;\n  color:#4a4a4a;\n  line-height:1.2;\n  padding-bottom:10px;\n}\n\n.sor-why-row{\n  display:grid;\n  grid-template-columns:1fr 68px 68px;\n  align-items:stretch;\n  border-top:1px dashed #C5DED2;\n}\n.sor-why-row:first-of-type{border-top:none;}\n.sor-why-label{\n  font-size:12.5px;\n  line-height:1.35;\n  color:#1a1a1a;\n  padding:15px 10px 15px 6px;\n  display:flex;\n  align-items:center;\n}\n.sor-why-us{\n  background:#1A5140;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n.sor-why-us-first{border-radius:10px 10px 0 0;}\n.sor-why-us-last{border-radius:0 0 10px 10px;}\n.sor-why-them{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n\n@media (min-width:750px){\n  .sor-why{display:flex;gap:56px;align-items:center;}\n  .sor-why-head{width:38%;margin-bottom:0;}\n  .sor-why-head h2{font-size:32px;}\n  .sor-why-head p{font-size:16px;}\n  .sor-why-table{flex:1;padding:0 16px 16px;}\n  .sor-why-header{grid-template-columns:1fr 110px 110px;}\n  .sor-why-h-us img{width:76px;}\n  .sor-why-h-us span{font-size:14px;}\n  .sor-why-h-them{font-size:14px;}\n  .sor-why-row{grid-template-columns:1fr 110px 110px;}\n  .sor-why-label{font-size:15px;padding:20px 16px 20px 10px;}\n  .sor-why-us svg,.sor-why-them svg{width:26px;height:26px;}\n}\n</style>",
