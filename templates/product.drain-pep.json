    "custom_liquid_gXtP7b": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": false,
        "liquid": "{%- comment -%}\n  ELORYA — BLOC 4 : transformation « de X à Y » + 6 scènes + CTA + garantie.\n  Clone FR du bloc Sonvital « Observa cómo tus piernas pasan de… ».\n  Mobile-first. Zéro dépendance au thème, zéro librairie.\n{%- endcomment -%}\n\n{%- assign elo_avant      = \"lourdes et gonflées\" -%}\n{%- assign elo_apres      = \"légères et dessinées\" -%}\n{%- assign elo_cta_texte  = \"Essayer sans risque\" -%}\n{%- assign elo_cta_lien   = \"#elo-acheter\" -%}\n{%- assign elo_garantie_j = \"60\" -%}\n\n{%- assign elo_scenes = \"Voir vos chevilles retrouver leur forme en fin de journée|Vous réveiller sans cette sensation de <em>jambes en plomb</em> ni les pieds serrés dans vos chaussures|Remettre vos bottes, vos sandales ou votre jean ajusté sans avoir à <em>forcer</em>|Sentir vos jambes légères à nouveau, sans cette lourdeur qui vous suit partout|Passer la main sur votre cuisse et sentir la peau lisse, pas capitonnée|Vous regarder dans le miroir et reconnaître à nouveau la ligne de vos jambes\" | split: \"|\" -%}\n\n<section class=\"elo-b4\">\n  <div class=\"elo-b4__wrap\">\n\n    <h2 class=\"elo-b4__titre\">\n      Regardez vos jambes passer de <em>«&nbsp;{{ elo_avant }}&nbsp;»</em> à <em>«&nbsp;{{ elo_apres }}&nbsp;»</em> avec le Drainage Lymphatique&nbsp;+&nbsp;Collagène d'ELORYA\n    </h2>\n\n    <p class=\"elo-b4__intro\">\n      La formule ELORYA™ aide votre corps à se dégonfler de l'intérieur — puis à raffermir la peau qui se trouvait dessous — pour que vous puissiez&nbsp;:\n    </p>\n\n    <ul class=\"elo-b4__liste\">\n      {%- for s in elo_scenes -%}\n        <li class=\"elo-b4__item\">\n          <span class=\"elo-b4__coche\" aria-hidden=\"true\">\n            <svg viewBox=\"0 0 20 20\" width=\"11\" height=\"11\"><path d=\"M3 10.5l4.5 4.5L17 5.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </span>\n          <span class=\"elo-b4__texte\">{{ s }}</span>\n        </li>\n      {%- endfor -%}\n    </ul>\n\n    <a class=\"elo-b4__cta\" href=\"{{ elo_cta_lien }}\">{{ elo_cta_texte }}</a>\n    <p class=\"elo-b4__garantie\">Garantie de remboursement {{ elo_garantie_j }} jours</p>\n\n  </div>\n</section>\n\n<style>\n  .elo-b4{\n    --elo-ink:#123B2E;\n    --elo-texte:#1E2B26;\n    --elo-gris:#6B7A73;\n    --elo-coche:#1C5D52;\n    --elo-cta:#151A18;\n    font-family:inherit;color:var(--elo-texte);\n    padding:26px 0 28px;\n    border-top:3px solid #3FA34D;\n    border-bottom:3px solid #3FA34D;\n  }\n  .elo-b4 *,.elo-b4 *::before,.elo-b4 *::after{box-sizing:border-box;}\n  .elo-b4__wrap{max-width:640px;margin:0 auto;padding:0;}\n\n  .elo-b4__titre{\n    margin:0 0 16px;\n    font-size:25px;line-height:1.28;font-weight:800;letter-spacing:-.01em;\n    color:var(--elo-texte);text-wrap:balance;\n  }\n  .elo-b4__titre em{font-style:italic;font-weight:500;}\n\n  .elo-b4__intro{margin:0 0 20px;font-size:16px;line-height:1.5;color:var(--elo-texte);}\n\n  .elo-b4__liste{list-style:none;margin:0 0 26px;padding:0;display:flex;flex-direction:column;gap:16px;}\n  .elo-b4__item{display:flex;align-items:flex-start;gap:12px;}\n  .elo-b4__coche{\n    flex:0 0 auto;width:26px;height:26px;margin-top:1px;border-radius:50%;\n    background:var(--elo-coche);color:#fff;\n    display:flex;align-items:center;justify-content:center;\n  }\n  .elo-b4__texte{font-size:16px;line-height:1.45;color:var(--elo-texte);}\n  .elo-b4__texte em{font-style:italic;}\n\n  .elo-b4__cta{\n    display:block;width:100%;text-align:center;text-decoration:none;\n    background:var(--elo-cta);color:#fff;\n    font-size:17px;font-weight:700;line-height:1;\n    padding:20px 18px;border-radius:10px;\n    -webkit-tap-highlight-color:transparent;\n    transition:opacity .15s ease;\n  }\n  .elo-b4__cta:hover{opacity:.88;}\n\n  .elo-b4__garantie{margin:12px 0 0;text-align:center;font-size:14px;color:var(--elo-gris);}\n\n  @media (min-width:750px){\n    .elo-b4{padding:36px 0 38px;}\n    .elo-b4__titre{font-size:31px;margin-bottom:18px;}\n    .elo-b4__intro{font-size:17px;}\n    .elo-b4__texte{font-size:17px;}\n    .elo-b4__cta{max-width:420px;margin:0 auto;}\n  }\n</style>",
