          "type": "liquid",
          "settings": {
            "liquid": "{%- comment -%}\n  ELORYA — BLOC 3 : « Cas réels de clientes » — carrousel avant/après scrollable.\n  Défilement horizontal au doigt (scroll-snap), points de progression, flèches sur desktop.\n  Mobile-first. Zéro dépendance au thème, zéro librairie.\n{%- endcomment -%}\n\n{%- assign elo_ba_titre    = \"CAS RÉELS DE CLIENTES ELORYA\" -%}\n{%- assign elo_ba_labels   = true -%}{%- comment -%} affiche « Avant / Après » sur l'image {%- endcomment -%}\n\n{%- assign elo_ba_images = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Captura_de_pantalla_2026-05-13_a_las_15.21.56_430x.png?v=1788976238,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/673498859_1928452884464250_3707562645625882552_n_430x.jpg?v=1788976236,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/645992914_3312753528896580_1078035044337395182_n_430x.jpg?v=1788976236,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/637354645_796506856800047_9057788895393573539_n_430x.jpg?v=1788976236,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/634475333_2178222846255314_4469678633394026155_n_430x.jpg?v=1788976237\" | split: \",\" -%}\n\n{%- comment -%} Une légende par image, même ordre. Laisser vide («  ») pour masquer. {%- endcomment -%}\n{%- assign elo_ba_legendes = \"Cuisses et jambes — 8 semaines|Chevilles et pieds — 4 semaines|Mollets et chevilles — 6 semaines|Jambes — 5 semaines|Pieds et chevilles — 3 semaines\" | split: \"|\" -%}\n\n<section class=\"elo-b3\" aria-roledescription=\"carrousel\" aria-label=\"{{ elo_ba_titre }}\">\n  <h2 class=\"elo-b3__titre\">{{ elo_ba_titre }}</h2>\n\n  <div class=\"elo-b3__zone\">\n    <button type=\"button\" class=\"elo-b3__fleche elo-b3__fleche--prev\" data-elo-prev aria-label=\"Précédent\">\n      <svg viewBox=\"0 0 12 20\" width=\"11\" height=\"18\" aria-hidden=\"true\"><path d=\"M10 1.5L1.5 10 10 18.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n\n    <ul class=\"elo-b3__piste\" data-elo-piste>\n      {%- for img in elo_ba_images -%}\n        {%- assign leg = elo_ba_legendes[forloop.index0] | strip -%}\n        <li class=\"elo-b3__slide\">\n          <figure class=\"elo-b3__figure\">\n            {%- if elo_ba_labels -%}\n              <span class=\"elo-b3__tags\" aria-hidden=\"true\">\n                <span class=\"elo-b3__tag\">Avant</span>\n                <span class=\"elo-b3__tag elo-b3__tag--apres\">Après</span>\n              </span>\n            {%- endif -%}\n            <img src=\"{{ img }}\"\n                 alt=\"Photo avant et après d'une cliente ELORYA{% if leg != blank %} — {{ leg }}{% endif %}\"\n                 width=\"860\" height=\"860\"\n                 loading=\"lazy\" decoding=\"async\">\n            {%- if leg != blank -%}\n              <figcaption class=\"elo-b3__legende\">{{ leg }}</figcaption>\n            {%- endif -%}\n          </figure>\n        </li>\n      {%- endfor -%}\n    </ul>\n\n    <button type=\"button\" class=\"elo-b3__fleche elo-b3__fleche--next\" data-elo-next aria-label=\"Suivant\">\n      <svg viewBox=\"0 0 12 20\" width=\"11\" height=\"18\" aria-hidden=\"true\"><path d=\"M2 1.5L10.5 10 2 18.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </div>\n\n  <div class=\"elo-b3__points\" data-elo-points role=\"tablist\" aria-label=\"Choisir une photo\">\n    {%- for img in elo_ba_images -%}\n      <button type=\"button\" class=\"elo-b3__point{% if forloop.first %} is-actif{% endif %}\" data-elo-point=\"{{ forloop.index0 }}\" aria-label=\"Photo {{ forloop.index }}\"></button>\n    {%- endfor -%}\n  </div>\n\n  <p class=\"elo-b3__mention\">Résultats individuels. Photos de clientes, non retouchées. Les résultats varient d'une personne à l'autre.</p>\n</section>\n\n<style>\n  .elo-b3{\n    --elo-ink:#123B2E;\n    --elo-texte:#1E2B26;\n    --elo-gris:#6B7A73;\n    --elo-ligne:#E3E8E5;\n    --elo-point:#C8D3CD;\n    font-family:inherit;color:var(--elo-texte);margin:26px 0;\n  }\n  .elo-b3 *,.elo-b3 *::before,.elo-b3 *::after{box-sizing:border-box;}\n\n  .elo-b3__titre{\n    margin:0 0 14px;text-align:center;\n    font-size:14px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;\n    color:var(--elo-ink);line-height:1.35;\n  }\n\n  .elo-b3__zone{position:relative;}\n\n  .elo-b3__piste{\n    list-style:none;margin:0;padding:0 0 2px;\n    display:flex;gap:12px;\n    overflow-x:auto;overscroll-behavior-x:contain;\n    scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .elo-b3__piste::-webkit-scrollbar{display:none;}\n\n  .elo-b3__slide{flex:0 0 86%;scroll-snap-align:center;}\n  .elo-b3__figure{margin:0;}\n  .elo-b3__figure{position:relative;}\n  .elo-b3__figure img{\n    display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;\n    border-radius:14px;background:#F2F4F3;\n  }\n\n  .elo-b3__tags{\n    position:absolute;top:10px;left:10px;right:10px;\n    display:flex;justify-content:space-between;pointer-events:none;\n  }\n  .elo-b3__tag{\n    background:rgba(255,255,255,.92);color:var(--elo-ink);\n    font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;\n    padding:5px 10px;border-radius:999px;box-shadow:0 1px 4px rgba(0,0,0,.12);\n  }\n  .elo-b3__tag--apres{background:var(--elo-ink);color:#fff;}\n\n  .elo-b3__legende{\n    margin:9px 2px 0;font-size:14px;line-height:1.35;color:var(--elo-gris);text-align:center;\n  }\n\n  /* Flèches — desktop uniquement */\n  .elo-b3__fleche{display:none;}\n\n  /* Points */\n  .elo-b3__points{display:flex;justify-content:center;gap:7px;margin:14px 0 0;}\n  .elo-b3__point{\n    width:7px;height:7px;padding:0;border:0;border-radius:50%;\n    background:var(--elo-point);cursor:pointer;transition:width .2s ease,background .2s ease;\n    -webkit-tap-highlight-color:transparent;\n  }\n  .elo-b3__point.is-actif{width:20px;border-radius:999px;background:var(--elo-ink);}\n\n  .elo-b3__mention{\n    margin:12px 0 0;text-align:center;font-size:12px;line-height:1.4;color:var(--elo-gris);\n  }\n\n  @media (min-width:750px){\n    .elo-b3__titre{font-size:16px;margin-bottom:18px;}\n    .elo-b3__slide{flex:0 0 calc((100% - 24px)/3);}\n    .elo-b3__fleche{\n      display:flex;align-items:center;justify-content:center;\n      position:absolute;top:50%;transform:translateY(-50%);z-index:2;\n      width:38px;height:38px;border-radius:50%;border:1px solid var(--elo-ligne);\n      background:#fff;color:var(--elo-ink);cursor:pointer;\n      box-shadow:0 2px 8px rgba(0,0,0,.08);\n    }\n    .elo-b3__fleche--prev{left:-8px;}\n    .elo-b3__fleche--next{right:-8px;}\n    .elo-b3__fleche[disabled]{opacity:.35;cursor:default;}\n  }\n\n  @media (prefers-reduced-motion:reduce){\n    .elo-b3__piste{scroll-behavior:auto;}\n  }\n</style>\n\n<script>\n  (function(){\n    var piste = document.querySelector('[data-elo-piste]');\n    if(!piste) return;\n    var points = Array.prototype.slice.call(document.querySelectorAll('[data-elo-point]'));\n    var prev = document.querySelector('[data-elo-prev]');\n    var next = document.querySelector('[data-elo-next]');\n    var slides = Array.prototype.slice.call(piste.children);\n    var tick;\n\n    function pas(){\n      if(slides.length < 2) return piste.clientWidth;\n      return slides[1].offsetLeft - slides[0].offsetLeft;\n    }\n    function actif(){\n      return Math.round(piste.scrollLeft / pas());\n    }\n    function sync(){\n      var i = Math.max(0, Math.min(actif(), slides.length - 1));\n      points.forEach(function(p, n){ p.classList.toggle('is-actif', n === i); });\n      if(prev) prev.disabled = piste.scrollLeft <= 2;\n      if(next) next.disabled = piste.scrollLeft >= piste.scrollWidth - piste.clientWidth - 2;\n    }\n    function aller(i){\n      piste.scrollTo({ left: i * pas(), behavior: 'smooth' });\n    }\n\n    piste.addEventListener('scroll', function(){\n      clearTimeout(tick);\n      tick = setTimeout(sync, 60);\n    }, { passive: true });\n\n    points.forEach(function(p){\n      p.addEventListener('click', function(){ aller(parseInt(p.dataset.eloPoint, 10)); });\n    });\n    if(prev) prev.addEventListener('click', function(){ aller(Math.max(0, actif() - 1)); });\n    if(next) next.addEventListener('click', function(){ aller(Math.min(slides.length - 1, actif() + 1)); });\n\n    window.addEventListener('resize', sync);\n    sync();\n  })();\n</script>"
          }
        }
      },
