        "liquid": "<div class=\"sor-diff-section\">\n  <div class=\"sor-diff-image\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_1_aout_2026_20_12_27_430x.png?v=1785611553\" alt=\"Sorelya Lymfedrainage Druppels\" loading=\"lazy\">\n  </div>\n\n  <div class=\"sor-diff-content\">\n    <h2 class=\"sor-diff-title\">Ontdek het verschil in hoe je eruitziet en hoe je je voelt.</h2>\n    <p class=\"sor-diff-text\">Ondersteunt de natuurlijke balans van je lichaam, voor een frissere uitstraling en meer energie, elke dag.</p>\n\n    <div class=\"sor-diff-grid\">\n      <div class=\"sor-diff-card\">\n        <span class=\"sor-diff-icon\">\n          <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M8.5 10h.01M15.5 10h.01M8 15c1.2 1 2.5 1.5 4 1.5s2.8-.5 4-1.5\"/></svg>\n        </span>\n        <span class=\"sor-diff-card-text\">Vermindert gezichtszwelling</span>\n      </div>\n      <div class=\"sor-diff-card\">\n        <span class=\"sor-diff-icon\">\n          <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 3.5c3 4 6 7.5 6 11a6 6 0 01-12 0c0-3.5 3-7 6-11z\"/></svg>\n        </span>\n        <span class=\"sor-diff-card-text\">Vermindert vochtretentie</span>\n      </div>\n      <div class=\"sor-diff-card\">\n        <span class=\"sor-diff-icon\">\n          <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M4 16l6-6 4 4 6-8\"/><path d=\"M15 6h5v5\"/></svg>\n        </span>\n        <span class=\"sor-diff-card-text\">Bevordert natuurlijke energie</span>\n      </div>\n      <div class=\"sor-diff-card\">\n        <span class=\"sor-diff-icon\">\n          <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\"><path d=\"M12 20s-7-4.35-9.5-9C1 7.5 2.8 4.5 6 4.5c2 0 3.3 1.1 4 2.3.7-1.2 2-2.3 4-2.3 3.2 0 5 3 3.5 6.5C19 15.65 12 20 12 20z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n        </span>\n        <span class=\"sor-diff-card-text\">Bevordert innerlijke vitaliteit</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.sor-diff-section{\n  font-family:inherit;\n  display:flex;\n  flex-direction:column;\n  max-width:100%;\n  border-radius:14px;\n  overflow:hidden;\n}\n\n.sor-diff-image{\n  width:100%;\n  line-height:0;\n}\n.sor-diff-image img{\n  width:100%;\n  height:auto;\n  display:block;\n  object-fit:cover;\n}\n\n.sor-diff-content{\n  background:#16342A;\n  padding:26px 20px 28px;\n}\n.sor-diff-title{\n  color:#fff;\n  font-size:21px;\n  font-weight:800;\n  line-height:1.25;\n  margin:0 0 12px;\n}\n.sor-diff-text{\n  color:#C9DACB;\n  font-size:13.5px;\n  line-height:1.55;\n  margin:0 0 20px;\n}\n\n.sor-diff-grid{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:10px;\n}\n.sor-diff-card{\n  background:rgba(255,255,255,0.07);\n  border:1px solid rgba(255,255,255,0.14);\n  border-radius:12px;\n  padding:14px 12px;\n  display:flex;\n  flex-direction:column;\n  gap:10px;\n}\n.sor-diff-icon{\n  color:#fff;\n  display:flex;\n}\n.sor-diff-card-text{\n  color:#fff;\n  font-weight:700;\n  font-size:12.5px;\n  line-height:1.35;\n}\n\n@media (min-width:750px){\n  .sor-diff-section{flex-direction:row;}\n  .sor-diff-image{width:46%;}\n  .sor-diff-image img{height:100%;}\n  .sor-diff-content{width:54%;padding:44px 44px;}\n  .sor-diff-title{font-size:32px;}\n  .sor-diff-text{font-size:16px;}\n  .sor-diff-card-text{font-size:15px;}\n  .sor-diff-card{padding:18px 16px;}\n}\n</style>",
