    "custom_liquid_kg3DGR": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-mirror\" data-sor-mirror>\n\n  <div class=\"sor-mirror-head\">\n    <h2>Resultaten die je <em>in de spiegel ziet</em></h2>\n    <p>Van Amsterdam tot Rotterdam — +12.000 vrouwen veranderden hun ochtenden al.</p>\n  </div>\n\n  <div class=\"sor-mirror-track\" data-sor-mirror-track>\n\n    <article class=\"sor-mirror-card\" data-sor-mirror-card>\n      <span class=\"sor-mirror-quote\">\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\"><path d=\"M9.5 6.5c-3 1.3-4.8 3.7-4.8 6.6 0 2.6 1.5 4.4 3.7 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.7-2.8 3.4-3.6l-1.8-1.2zm8.4 0c-3 1.3-4.8 3.7-4.8 6.6 0 2.6 1.5 4.4 3.7 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.7-2.8 3.4-3.6l-1.8-1.2z\"/></svg>\n      </span>\n      <div class=\"sor-mirror-stars\">★★★★★</div>\n      <h3 class=\"sor-mirror-title\">\"Ik zag mezelf weer in de spiegel\"</h3>\n      <p class=\"sor-mirror-text\">Na 2 zwangerschappen had ik het gevoel dat mijn lichaam alles vasthield. Na 3 weken met Sorelya werd ik niet meer wakker met een opgezwollen gezicht. Mijn humeur veranderde, mijn energie ook.</p>\n      <div class=\"sor-mirror-author\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/1748551321-image_63_430x.jpg?v=1784600276\" alt=\"Sanne M.\" loading=\"lazy\">\n        <div>\n          <p class=\"sor-mirror-name\">Sanne M., 38 jaar · Amsterdam 🇳🇱</p>\n          <p class=\"sor-mirror-verified\">Geverifieerde koper</p>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"sor-mirror-card\" data-sor-mirror-card>\n      <span class=\"sor-mirror-quote\">\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\"><path d=\"M9.5 6.5c-3 1.3-4.8 3.7-4.8 6.6 0 2.6 1.5 4.4 3.7 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.7-2.8 3.4-3.6l-1.8-1.2zm8.4 0c-3 1.3-4.8 3.7-4.8 6.6 0 2.6 1.5 4.4 3.7 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.7-2.8 3.4-3.6l-1.8-1.2z\"/></svg>\n      </span>\n      <div class=\"sor-mirror-stars\">★★★★★</div>\n      <h3 class=\"sor-mirror-title\">\"Mijn benen deden geen pijn meer\"</h3>\n      <p class=\"sor-mirror-text\">Ik sta 9 uur per dag als verpleegkundige. Na de eerste maand met de druppels deden mijn benen aan het einde van mijn dienst geen pijn meer. Nu is het een vast onderdeel van mijn routine.</p>\n      <div class=\"sor-mirror-author\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/1748552506-image_63_1_430x.jpg?v=1784600276\" alt=\"Lieke R.\" loading=\"lazy\">\n        <div>\n          <p class=\"sor-mirror-name\">Lieke R., 45 jaar · Rotterdam 🇳🇱</p>\n          <p class=\"sor-mirror-verified\">Geverifieerde koper</p>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"sor-mirror-card\" data-sor-mirror-card>\n      <span class=\"sor-mirror-quote\">\n        <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"currentColor\"><path d=\"M9.5 6.5c-3 1.3-4.8 3.7-4.8 6.6 0 2.6 1.5 4.4 3.7 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.7-2.8 3.4-3.6l-1.8-1.2zm8.4 0c-3 1.3-4.8 3.7-4.8 6.6 0 2.6 1.5 4.4 3.7 4.4 1.9 0 3.3-1.4 3.3-3.2 0-1.8-1.3-3.1-3-3.1-.3 0-.6 0-.8.1.4-1.5 1.7-2.8 3.4-3.6l-1.8-1.2z\"/></svg>\n      </span>\n      <div class=\"sor-mirror-stars\">★★★★★</div>\n      <h3 class=\"sor-mirror-title\">\"Eindelijk iets dat werkt\"</h3>\n      <p class=\"sor-mirror-text\">Ik probeerde al jaren thee en diuretica zonder resultaat. Dit is het enige dat écht heeft gewerkt — en zonder dat uitgedroogde gevoel. De overgang laat me niet meer opzwellen zoals eerst.</p>\n      <div class=\"sor-mirror-author\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/1748431982-r5_430x.jpg?v=1784600276\" alt=\"Annemieke T.\" loading=\"lazy\">\n        <div>\n          <p class=\"sor-mirror-name\">Annemieke T., 52 jaar · Utrecht 🇳🇱</p>\n          <p class=\"sor-mirror-verified\">Geverifieerde koper · Overgang</p>\n        </div>\n      </div>\n    </article>\n\n  </div>\n\n  <div class=\"sor-mirror-dots\" data-sor-mirror-dots>\n    <button type=\"button\" class=\"active\" data-sor-mirror-dot=\"0\" aria-label=\"Review 1\"></button>\n    <button type=\"button\" data-sor-mirror-dot=\"1\" aria-label=\"Review 2\"></button>\n    <button type=\"button\" data-sor-mirror-dot=\"2\" aria-label=\"Review 3\"></button>\n  </div>\n\n</div>\n\n<script>\n(function(){\n  document.querySelectorAll('[data-sor-mirror]').forEach(function(section){\n    var track = section.querySelector('[data-sor-mirror-track]');\n    var cards = Array.from(section.querySelectorAll('[data-sor-mirror-card]'));\n    var dots = Array.from(section.querySelectorAll('[data-sor-mirror-dot]'));\n    if(!track || !cards.length) return;\n\n    function setActive(i){\n      dots.forEach(function(d, di){ d.classList.toggle('active', di === i); });\n    }\n\n    requestAnimationFrame(function(){\n      track.scrollLeft = 0;\n      setActive(0);\n    });\n\n    if('IntersectionObserver' in window){\n      var obs = new IntersectionObserver(function(entries){\n        entries.forEach(function(entry){\n          if(entry.isIntersecting && entry.intersectionRatio >= 0.65){\n            var i = cards.indexOf(entry.target);\n            if(i >= 0) setActive(i);\n          }\n        });\n      }, { root: track, threshold: [0.4, 0.65, 0.9] });\n      cards.forEach(function(c){ obs.observe(c); });\n    }\n\n    dots.forEach(function(dot, i){\n      dot.addEventListener('click', function(){\n        var target = cards[i];\n        if(!target) return;\n        track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior:'smooth' });\n        setActive(i);\n      });\n    });\n  });\n})();\n</script>\n\n<style>\n.sor-mirror,.sor-mirror *{box-sizing:border-box;}\n.sor-mirror{font-family:inherit;width:100%;max-width:100%;overflow:hidden;}\n\n.sor-mirror-head{text-align:center;margin-bottom:22px;}\n.sor-mirror-head h2{\n  font-size:22px;\n  font-weight:800;\n  color:#1a1a1a;\n  line-height:1.25;\n  margin:0 0 8px;\n}\n.sor-mirror-head h2 em{font-style:italic;}\n.sor-mirror-head p{\n  font-size:13px;\n  color:#6b6b6b;\n  line-height:1.45;\n  margin:0;\n}\n\n.sor-mirror-track{\n  display:flex;\n  gap:12px;\n  overflow-x:auto;\n  overscroll-behavior-x:contain;\n  scroll-snap-type:x mandatory;\n  scroll-behavior:smooth;\n  scrollbar-width:none;\n  -webkit-overflow-scrolling:touch;\n  touch-action:pan-x;\n}\n.sor-mirror-track::-webkit-scrollbar{display:none;}\n\n.sor-mirror-card{\n  position:relative;\n  flex:0 0 100%;\n  width:100%;\n  background:#F7F6F3;\n  border-radius:16px;\n  padding:24px 18px 18px;\n  scroll-snap-align:start;\n  scroll-snap-stop:always;\n  display:flex;\n  flex-direction:column;\n}\n.sor-mirror-quote{\n  position:absolute;\n  top:14px;right:14px;\n  width:30px;height:30px;\n  border-radius:50%;\n  background:#2B1E14;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n}\n.sor-mirror-stars{\n  text-align:center;\n  color:#F5C518;\n  font-size:16px;\n  letter-spacing:2px;\n  margin-bottom:10px;\n}\n.sor-mirror-title{\n  text-align:center;\n  font-size:16px;\n  font-weight:800;\n  color:#1a1a1a;\n  margin:0 0 12px;\n  line-height:1.3;\n}\n.sor-mirror-text{\n  flex:1;\n  text-align:center;\n  font-size:13.5px;\n  line-height:1.55;\n  color:#3a3a3a;\n  margin:0 0 18px;\n}\n.sor-mirror-author{\n  display:flex;\n  align-items:center;\n  gap:10px;\n  border-top:1px solid #E4E1DA;\n  padding-top:14px;\n}\n.sor-mirror-author img{\n  width:38px;height:38px;\n  border-radius:50%;\n  object-fit:cover;\n  flex-shrink:0;\n  display:block;\n}\n.sor-mirror-name{\n  font-size:12.5px;\n  font-weight:700;\n  color:#1a1a1a;\n  margin:0 0 2px;\n  line-height:1.25;\n}\n.sor-mirror-verified{\n  font-size:11.5px;\n  color:#6b6b6b;\n  margin:0;\n  line-height:1.2;\n}\n\n.sor-mirror-dots{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  gap:8px;\n  margin-top:16px;\n}\n.sor-mirror-dots button{\n  width:8px;height:8px;\n  padding:0;border:0;\n  border-radius:50%;\n  background:#D9D5CE;\n  cursor:pointer;\n  transition:background-color .2s ease,transform .2s ease;\n}\n.sor-mirror-dots button.active{background:#1a1a1a;transform:scale(1.1);}\n\n@media (min-width:750px){\n  .sor-mirror-head{margin-bottom:34px;}\n  .sor-mirror-head h2{font-size:32px;}\n  .sor-mirror-head p{font-size:16px;}\n  .sor-mirror-track{\n    display:grid;\n    grid-template-columns:repeat(3,minmax(0,1fr));\n    gap:24px;\n    overflow:visible;\n  }\n  .sor-mirror-card{padding:30px 24px 22px;}\n  .sor-mirror-title{font-size:19px;}\n  .sor-mirror-text{font-size:15px;}\n  .sor-mirror-name{font-size:14px;}\n  .sor-mirror-verified{font-size:13px;}\n  .sor-mirror-author img{width:44px;height:44px;}\n  .sor-mirror-dots{display:none;}\n}\n</style>",
