    "custom_liquid_33tNMR": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{%- comment -%}\n  sorelya — BLOC 6 : « Comment ça fonctionne » — chronologie de résultats.\n  Clone FR du bloc Sonvital « Cómo funciona », passé de 3 à 4 étapes :\n  les 3 étapes drainage (eau) + 1 étape collagène (peau, semaine 8-12).\n  L'étape 4 n'a pas encore de visuel → elle s'affiche en carte bleutée sans image.\n  Dès que l'image existe, il suffit de renseigner son URL dans elo_tl_images.\n  Mobile-first. Zéro librairie, zéro JS.\n{%- endcomment -%}\n\n{%- assign elo_tl_kicker = \"COMMENT ÇA FONCTIONNE\" -%}\n{%- assign elo_tl_mot    = \"rien\" -%}\n\n{%- assign elo_tl_durees = \"Premières 24 h|Jour 10|Jour 20|Semaine 8 à 12\" | split: \"|\" -%}\n\n{%- assign elo_tl_citations = \"Je commence à sentir mes jambes moins lourdes et mon corps plus léger.|Je vois mes chevilles plus dessinées et la sensation de gonflement qui cède.|Je vois la différence : mes pieds et mes chevilles sont plus légers et plus jolis.|Je passe la main sur ma cuisse et la peau est plus lisse, plus ferme.\" | split: \"|\" -%}\n\n{%- assign elo_tl_etats = \"Point de départ|En cours|Résultat|Peau raffermie\" | split: \"|\" -%}\n\n{%- comment -%} 4e valeur vide = carte sans image (à remplir quand le visuel peau existera). {%- endcomment -%}\n{%- assign elo_tl_images = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_23_may_2026_08_58_21_430x.png?v=1789091191,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_23_may_2026_08_59_55_430x.png?v=1789091191,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_23_may_2026_09_01_34_430x.png?v=1789091191,\" | split: \",\" -%}\n\n<section class=\"elo-b6\">\n  <div class=\"elo-b6__wrap\">\n\n    <p class=\"elo-b6__kicker\"><span class=\"elo-b6__pastille\" aria-hidden=\"true\"></span>{{ elo_tl_kicker }}</p>\n\n    <h2 class=\"elo-b6__titre\">Ne changez <em>{{ elo_tl_mot }}</em> à votre routine ni à votre sport</h2>\n\n    <p class=\"elo-b6__intro\">\n      Ajoutez simplement <strong>SORELYA™</strong> à votre quotidien et observez comme, peu à peu, votre corps se sent plus léger. Voici comment ça peut se passer&nbsp;:\n    </p>\n\n    <ol class=\"elo-b6__etapes\">\n      {%- for duree in elo_tl_durees -%}\n        {%- assign img = elo_tl_images[forloop.index0] | strip -%}\n        <li class=\"elo-b6__etape{% if img == blank %} elo-b6__etape--peau{% endif %}\">\n\n          <p class=\"elo-b6__badge\">\n            <span class=\"elo-b6__num\">{{ forloop.index }}</span>\n            <span class=\"elo-b6__duree\">{{ duree }}</span>\n          </p>\n\n          <blockquote class=\"elo-b6__citation\">\n            <span class=\"elo-b6__guillemet\" aria-hidden=\"true\">“</span>{{ elo_tl_citations[forloop.index0] }}\n          </blockquote>\n\n          {%- if img != blank -%}\n            <div class=\"elo-b6__media\">\n              <img src=\"{{ img }}\" alt=\"{{ duree }} — {{ elo_tl_etats[forloop.index0] }}\" width=\"860\" height=\"860\" loading=\"lazy\" decoding=\"async\">\n              <span class=\"elo-b6__etat\">{{ elo_tl_etats[forloop.index0] }}</span>\n            </div>\n          {%- else -%}\n            <p class=\"elo-b6__etat elo-b6__etat--seul\">{{ elo_tl_etats[forloop.index0] }}</p>\n          {%- endif -%}\n\n        </li>\n      {%- endfor -%}\n    </ol>\n\n    <p class=\"elo-b6__chute\">\n      En quelques semaines à peine… ne soyez pas surprise quand votre conjoint et vos amies <strong>commencent à le remarquer</strong>.\n    </p>\n\n  </div>\n</section>\n\n<style>\n  .elo-b6{\n    --elo-teal:#1C5D66;\n    --elo-teal-fonce:#164A52;\n    --elo-texte:#2A332C;\n    --elo-gris:#6B7A73;\n    --elo-carte:#FBF3EA;\n    --elo-bord:#F0E2D2;\n    --elo-orange:#E08A3C;\n    font-family:inherit;color:var(--elo-texte);padding:24px 0 22px;\n  }\n  .elo-b6 *,.elo-b6 *::before,.elo-b6 *::after{box-sizing:border-box;}\n  .elo-b6__wrap{max-width:640px;margin:0 auto;padding:0;}\n\n  .elo-b6__kicker{\n    display:flex;align-items:center;justify-content:center;gap:9px;\n    width:fit-content;margin:0 auto 14px;padding:9px 16px;\n    background:#E7EDEC;border-radius:999px;\n    font-size:11px;font-weight:700;letter-spacing:.14em;color:var(--elo-teal);\n  }\n  .elo-b6__pastille{width:6px;height:6px;border-radius:50%;background:var(--elo-teal);flex:0 0 auto;}\n\n  .elo-b6__titre{\n    margin:0 0 16px;text-align:center;\n    font-size:17.5px;line-height:1.25;font-weight:800;letter-spacing:-.01em;color:var(--elo-texte);\n    text-wrap:balance;\n  }\n  .elo-b6__titre em{font-style:italic;color:var(--elo-teal);}\n\n  .elo-b6__intro{\n    margin:0 0 20px;text-align:center;\n    font-size:13px;line-height:1.6;color:var(--elo-gris);\n  }\n  .elo-b6__intro strong{color:var(--elo-texte);}\n\n  .elo-b6__etapes{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:18px;counter-reset:none;}\n  .elo-b6__etape{\n    background:var(--elo-carte);border:1px solid var(--elo-bord);\n    border-radius:14px;padding:13px 13px 15px;\n  }\n\n  .elo-b6__badge{\n    display:inline-flex;align-items:center;gap:8px;margin:0 0 11px;\n    background:var(--elo-teal);border-radius:999px;padding:6px 14px 6px 6px;\n  }\n  .elo-b6__num{\n    width:22px;height:22px;border-radius:50%;flex:0 0 auto;\n    background:rgba(255,255,255,.22);color:#fff;\n    display:flex;align-items:center;justify-content:center;\n    font-size:11px;font-weight:700;line-height:1;\n  }\n  .elo-b6__duree{color:#fff;font-size:12.5px;font-weight:700;line-height:1;}\n\n  .elo-b6__citation{\n    margin:0 0 11px;padding:0 2px 0 20px;position:relative;\n    font-size:13.5px;line-height:1.4;font-style:italic;color:var(--elo-teal-fonce);\n  }\n  .elo-b6__guillemet{\n    position:absolute;left:0;top:-6px;\n    font-size:22px;line-height:1;font-style:normal;color:var(--elo-orange);\n  }\n\n  .elo-b6__media{position:relative;}\n  .elo-b6__media img{\n    display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;\n    border-radius:12px;background:#EFEAE3;\n  }\n  .elo-b6__etat{\n    position:absolute;left:10px;bottom:10px;\n    background:var(--elo-teal);color:#fff;\n    font-size:11px;font-weight:600;line-height:1;\n    padding:7px 12px;border-radius:999px;\n    box-shadow:0 2px 8px rgba(0,0,0,.18);\n  }\n\n  /* Étape peau — pas encore de visuel */\n  .elo-b6__etape--peau{background:#EFF6F8;border-color:#D6E4EC;}\n  .elo-b6__etape--peau .elo-b6__badge{background:#1C4A5A;}\n  .elo-b6__etape--peau .elo-b6__citation{color:#164452;}\n  .elo-b6__etat--seul{\n    position:static;display:inline-block;margin:0;\n    background:#1C4A5A;box-shadow:none;\n  }\n\n  .elo-b6__chute{\n    margin:20px 0 0;text-align:center;\n    font-size:13px;line-height:1.6;color:var(--elo-gris);\n  }\n  .elo-b6__chute strong{color:var(--elo-texte);}\n\n  @media (min-width:750px){\n    .elo-b6{padding:34px 0 30px;}\n    .elo-b6__titre{font-size:20.5px;}\n    .elo-b6__intro{font-size:14px;}\n    .elo-b6__etape{padding:16px 16px 18px;}\n    .elo-b6__citation{font-size:14.5px;}\n    .elo-b6__chute{font-size:14px;}\n  }\n</style>",
