    "custom_liquid_ENU4G3": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-timeline\">\n  <div class=\"sor-tl-header\">\n    <h2 class=\"sor-tl-title\">Jouw route naar <span>lymfatisch herstel</span></h2>\n    <p class=\"sor-tl-subtitle\">Echte, geleidelijke vooruitgang — geen snelle oplossingen.</p>\n  </div>\n\n  <div class=\"sor-tl-list\">\n    <div class=\"sor-tl-item\">\n      <div class=\"sor-tl-dot\">1</div>\n      <div class=\"sor-tl-card\">\n        <span class=\"sor-tl-week\">WEEK 1</span>\n        <h3 class=\"sor-tl-step-title\">De doorstroming start</h3>\n        <ul class=\"sor-tl-bullets\">\n          <li>De zwelling begint te verminderen</li>\n          <li>Lichtere spijsvertering</li>\n        </ul>\n        <div class=\"sor-tl-divider\"></div>\n        <p class=\"sor-tl-stat\"><strong>93%</strong> van de klanten merkte minder zwelling in de eerste week</p>\n      </div>\n    </div>\n\n    <div class=\"sor-tl-item\">\n      <div class=\"sor-tl-dot\">2</div>\n      <div class=\"sor-tl-card\">\n        <span class=\"sor-tl-week\">WEEK 2</span>\n        <h3 class=\"sor-tl-step-title\">Merkbare lichtheid</h3>\n        <ul class=\"sor-tl-bullets\">\n          <li>Lichtere benen en lichaam</li>\n          <li>Toenemende energie</li>\n        </ul>\n        <div class=\"sor-tl-divider\"></div>\n        <p class=\"sor-tl-stat\"><strong>91%</strong> voelde zich lichter en helderder van geest</p>\n      </div>\n    </div>\n\n    <div class=\"sor-tl-item\">\n      <div class=\"sor-tl-dot\">3</div>\n      <div class=\"sor-tl-card\">\n        <span class=\"sor-tl-week\">WEEK 3</span>\n        <h3 class=\"sor-tl-step-title\">Glow van binnenuit</h3>\n        <ul class=\"sor-tl-bullets\">\n          <li>Helderdere, stralende huid</li>\n          <li>Stabiele stemming en helderheid</li>\n        </ul>\n        <div class=\"sor-tl-divider\"></div>\n        <p class=\"sor-tl-stat\"><strong>91%</strong> zag zichtbare verbetering van de huid</p>\n      </div>\n    </div>\n\n    <div class=\"sor-tl-item\">\n      <div class=\"sor-tl-dot\">4</div>\n      <div class=\"sor-tl-card\">\n        <span class=\"sor-tl-week\">WEEK 4</span>\n        <h3 class=\"sor-tl-step-title\">Blijvende balans</h3>\n        <ul class=\"sor-tl-bullets\">\n          <li>Constante energie</li>\n          <li>Platter en minder opgeblazen gevoel</li>\n        </ul>\n        <div class=\"sor-tl-divider\"></div>\n        <p class=\"sor-tl-stat\"><strong>95%</strong> rapporteerde algehele verbetering bij consistent gebruik</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.sor-timeline{font-family:inherit;max-width:100%;}\n\n.sor-tl-header{text-align:center;margin-bottom:28px;}\n.sor-tl-title{font-size:22px;font-weight:800;color:#1a1a1a;margin:0 0 8px;line-height:1.25;}\n.sor-tl-title span{color:#1F5138;}\n.sor-tl-subtitle{font-size:13.5px;color:#6b6b6b;margin:0;}\n\n.sor-tl-list{position:relative;display:flex;flex-direction:column;gap:22px;}\n.sor-tl-list::before{\n  content:'';\n  position:absolute;\n  top:23px;bottom:23px;left:22px;\n  border-left:2px dashed #D9D5CE;\n  z-index:0;\n}\n.sor-tl-item{position:relative;display:flex;gap:14px;z-index:1;}\n.sor-tl-dot{\n  flex-shrink:0;\n  width:44px;height:44px;\n  border-radius:50%;\n  background:#1F5138;\n  color:#fff;\n  font-weight:800;\n  font-size:15px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  position:relative;\n  z-index:1;\n}\n.sor-tl-card{\n  flex:1;\n  background:#F7F6F3;\n  border-radius:14px;\n  padding:18px 16px;\n}\n.sor-tl-week{\n  display:block;\n  font-size:11px;\n  font-weight:800;\n  letter-spacing:0.06em;\n  color:#1F5138;\n  margin-bottom:6px;\n}\n.sor-tl-step-title{\n  font-size:16px;\n  font-weight:800;\n  color:#1a1a1a;\n  margin:0 0 10px;\n}\n.sor-tl-bullets{\n  list-style:none;\n  margin:0 0 14px;\n  padding:0;\n  display:flex;\n  flex-direction:column;\n  gap:6px;\n}\n.sor-tl-bullets li{\n  font-size:13px;\n  color:#3a3a3a;\n  line-height:1.4;\n  padding-left:14px;\n  position:relative;\n}\n.sor-tl-bullets li::before{\n  content:'';\n  position:absolute;\n  left:0;top:6px;\n  width:5px;height:5px;\n  border-radius:50%;\n  background:#1F5138;\n}\n.sor-tl-divider{border-top:1px solid #E4E1DA;margin-bottom:14px;}\n.sor-tl-stat{font-size:12.5px;color:#6b6b6b;line-height:1.4;margin:0;}\n.sor-tl-stat strong{color:#1F5138;font-size:19px;font-weight:800;margin-right:2px;}\n\n@media (min-width:750px){\n  .sor-tl-title{font-size:34px;}\n  .sor-tl-subtitle{font-size:16px;}\n  .sor-tl-list{flex-direction:row;gap:20px;}\n  .sor-tl-list::before{\n    top:22px;bottom:auto;left:5%;right:5%;\n    border-left:none;\n    border-top:2px dashed #D9D5CE;\n    height:0;\n  }\n  .sor-tl-item{flex-direction:column;flex:1;gap:20px;align-items:center;}\n  .sor-tl-dot{margin:0 auto;}\n  .sor-tl-card{width:100%;}\n}\n</style>",
