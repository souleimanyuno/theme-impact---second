ouse')maus=false;});\n    if('IntersectionObserver' in window){\n      new IntersectionObserver(function(es){aktiv=es[0].isIntersecting;},{threshold:0.3}).observe(root);\n    }else{aktiv=true;}\n    setTimeout(function(){if(!seen){var r=root.getBoundingClientRect();aktiv=r.top<innerHeight&&r.bottom>0;}},1500);\n    if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))setInterval(weiter,TAKT);\n  }\n  function run(){[].forEach.call(document.querySelectorAll('[data-vvs]'),init);}\n  run();\n  if(!window.__vvs){window.__vvs=1;document.addEventListener('shopify:section:load',run);}\n})();\n</script>"
