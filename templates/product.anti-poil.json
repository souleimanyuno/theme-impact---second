    "ap_mecanisme": {
      "type": "lp-ap-mecanisme",
      "settings": {
        "t01": "Pénétrer jusqu’à la racine",
        "t02": "L’extrait de Cyperus rotundus",
        "t03": "pénètre en profondeur et atteint le follicule, là où naît le signal de pousse.",
        "t04": "Couper le signal",
        "t05": "Ses flavonoïdes",
        "t06": "forment un bouclier autour de la racine : le signal qui ordonne au poil de pousser ne passe plus.",
        "t07": "Affiner le poil",
        "t08": "À chaque cycle, le poil qui repousse est plus fin, plus clair, plus lent. Avec le temps, de plus en plus discret.",
        "t09": "Apaiser et réparer",
        "t10": "Le panthénol",
        "t11": "calme le feu du rasoir, tandis que",
