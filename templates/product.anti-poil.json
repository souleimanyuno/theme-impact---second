ach(function(v){\n      v.muted=true;v.defaultMuted=true;v.volume=0;\n      v.addEventListener('volumechange',function(){if(!v.muted||v.volume){v.muted=true;v.volume=0;}});\n    });\n\n    function play(v){if(v.preload!=='auto')v.preload='auto';var p=v.play();if(p&&p.catch)p.catch(function(){});}\n    function stop(v){if(!v.paused)v.pause();}\n\n    /* Nur was im Bild ist, l\\u00e4dt und l\\u00e4uft \\u2014 h\\u00e4lt die PDP schnell */\n    var seen=false;\n    if('IntersectionObserver' in window){\n      var io=new IntersectionObserver(function(es){\n        seen=true;\n        es.forEach(function(e){var v=e.target;v._in=e.isIntersecting;if(v._in)play(v);else stop(v);});\n      },{threshold:0.2});\n      vids.forEach(function(v){io.observe(v);});\n    }\n    /* Notausstieg: meldet der Observer sich nicht, starten die sichtbaren Videos trotzdem */\n    setTimeout(function(){\n      if(seen)return;\n      var tr=track.getBoundingClientRect();\n      vids.forEach(function(v){\n        var r=v.getBoundingClientRect();\n        if(r.top<innerHeight&&r.bottom>0&&r.left<tr.right&&r.right>tr.left){v._in=true;play(v);}\n      });\n    },1500);\n\n    /* iOS-Stromsparmodus blockt Autoplay \\u2014 die erste Ber\\u00fchrung startet es nach */\n    function kick(){vids.forEach(function(v){if(v._in&&v.paused)play(v);});}\n    document.addEventListener('touchend',kick,{passive:true});\n    document.addEventListener('visibilitychange',function(){if(!document.hidden)kick();});\n\n    /* Pfeile + Maus-Ziehen (nur Desktop) */\n    function step(){var g=parseFloat(getComputedStyle(track).columnGap)||0;return cards.length?cards[0].getBoundingClientRect().width+g:track.clientWidth;}\n    function update(){\n      var max=track.scrollWidth-track.clientWidth;\n      if(max>2)root.classList.add('is-scrollable');else root.classList.remove('is-scrollable');\n      if(prev)prev.disabled=track.scrollLeft<=2;\n      if(next)next.disabled=track.scrollLeft>=max-2;\n    }\n    if(prev)prev.addEventListener('click',function(){track.scrollBy({left:-step(),behavior:'smooth'});});\n    if(next)next.addEventListener('click',function(){track.scrollBy({left:step(),behavior:'smooth'});});\n    track.addEventListener('scroll',update,{passive:true});\n    window.addEventListener('resize',update);\n    update();\n\n    var drag=null;\n    track.addEventListener('pointerdown',function(e){\n      if(e.pointerType!=='mouse'||e.button!==0)return;\n      drag={x:e.clientX,l:track.scrollLeft};track.classList.add('is-drag');e.preventDefault();\n    });\n    window.addEventListener('pointermove',function(e){if(drag)track.scrollLeft=drag.l-(e.clientX-drag.x);});\n    window.addEventListener('pointerup',function(){\n      if(!drag)return;drag=null;\n      var s=step(),l=track.scrollLeft;\n      track.classList.remove('is-drag');track.scrollLeft=l;\n      track.scrollTo({left:Math.round(l/s)*s,behavior:'smooth'});\n    });\n    track.addEventListener('contextmenu',function(e){e.preventDefault();});\n\n    /* Automatisch weiter \\u2014 h\\u00e4lt an, solange jemand selbst wischt oder mit der Maus drauf ist */\n    var TAKT=3500;   /* Millisekunden bis zum n\\u00e4chsten Video */\n    var aktiv=false,maus=false,pauseBis=0;\n    function halt(){pauseBis=Date.now()+5000;}\n    function weiter(){\n      if(!aktiv||maus||drag||document.hidden||Date.now()<pauseBis)return;\n      var max=track.scrollWidth-track.clientWidth;\n      if(max<=2)return;\n      var s=step(),ziel=(Math.round(track.scrollLeft/s)+1)*s;\n      track.scrollTo({left:track.scrollLeft>=max-2?0:Math.min(ziel,max),behavior:'smooth'});\n    }\n    ['touchstart','pointerdown','wheel'].forEach(function(ev){track.addEventListener(ev,halt,{passive:true});});\n    if(prev)prev.addEventListener('click',halt);\n    if(next)next.addEventListener('click',halt);\n    root.addEventListener('pointerenter',function(e){if(e.pointerType==='mouse')maus=true;});\n    root.addEventListener('pointerleave',function(e){if(e.pointerType==='mouse')maus=false;});\n    if('IntersectionObserver' in window){\n      new IntersectionObserver(function(es){aktiv=es[0].isIntersecting;},{threshold:0.3}).observe(root);\n    }else{aktiv=true;}\n    setTimeout(function(){if(!seen){var r=root.getBoundingClientRect();aktiv=r.top<innerHeight&&r.bottom>0;}},1500);\n    if(!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches))setInterval(weiter,TAKT);\n  }\n  function run(){[].forEach.call(document.querySelectorAll('[data-vvs]'),init);}\n  run();\n  if(!window.__vvs){window.__vvs=1;document.addEventListener('shopify:section:load',run);}\n})();\n</script>"
