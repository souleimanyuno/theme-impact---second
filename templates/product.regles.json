ex-wrap:wrap;\n  gap:9px;\n}\n.sor-price-current{\n  font-size:22px;\n  font-weight:700;\n  color:#1a1a1a;\n}\n.sor-price-old{\n  font-size:14px;\n  color:#9C8770;\n  text-decoration:line-through;\n}\n.sor-save-badge{\n  display:inline-flex;\n  align-items:center;\n  gap:5px;\n  background:#2B1E14;\n  color:#fff;\n  font-size:11.5px;\n  font-weight:700;\n  letter-spacing:0.02em;\n  padding:5px 10px;\n  border-radius:999px;\n}\n\n@media (min-width:750px){\n  .sor-rating-text{font-size:14.5px;}\n  .sor-price-current{font-size:28px;}\n  .sor-price-old{font-size:17px;}\n  .sor-save-badge{font-size:13px;padding:6px 12px;}\n}\n</style>"
