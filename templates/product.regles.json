          "settings": {
            "liquid": "{%- comment -%}\n  ============================================================\n  SORELYA FR — B2A : HERO, colonne info (haut)\n  Clone du hero Myoovi 2.0\n  Contenu : badge promo · pastille avis · titre · prix + barré + % ·\n            5 bullets bénéfices (début en gras)\n  Suite dans B2B : quantité + ATC + 4 accordéons\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ---------- VARIABLES À MODIFIER ---------- {%- endcomment -%}\n{%- assign sor_badge        = \"OFFRE D'ÉTÉ\" -%}\n{%- assign sor_note         = \"4,6/5\" -%}\n{%- assign sor_clientes     = \"8 000+\" -%}\n{%- assign sor_titre        = \"Appareil Anti-Douleurs Règles Sorelya 2.0\" -%}\n{%- assign sor_prix         = \"49,90 €\" -%}\n{%- assign sor_prix_barre   = \"69,90 €\" -%}\n{%- assign sor_remise       = \"-30%\" -%}\n{%- comment -%} ----------------------------------------- {%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sor-hero{\n    --sor-cola:#3C2C26; --sor-grey:#756A64; --sor-chalk:#F3EFEC;\n    --sor-tomato:#F56045; --sor-aubergine:#541431;\n    --sor-orange:#C1552E; --sor-green:#41573F; --sor-strike:#9C9C9C;\n    --sor-serif:'Fraunces','Times New Roman',Times,serif;\n    --sor-sans:'Helvetica Neue',Helvetica,Arial,sans-serif;\n    padding:0; margin:0; max-width:none;\n    font-family:var(--sor-sans); color:var(--sor-cola);\n  }\n  .sor-hero *{box-sizing:border-box;}\n\n  /* --- badge promo --- */\n  .sor-hero__badge{\n    display:inline-block; padding:4px 13px; background:var(--sor-aubergine);\n    color:#fff; border-radius:70px; font-family:var(--sor-sans);\n    font-size:12px; font-weight:500; line-height:18px; letter-spacing:.02em; margin:0 0 7px;\n  }\n\n  /* --- pastille avis (une seule ligne) --- */\n  .sor-hero__rating{\n    display:flex; align-items:center; gap:4px; width:fit-content; max-width:100%;\n    white-space:nowrap; background:var(--sor-chalk); border-radius:33px; padding:3px 11px;\n    font-family:var(--sor-sans); font-size:12.5px; font-weight:500; line-height:1.6; margin:0 0 9px;\n  }\n  .sor-hero__stars{display:flex; gap:1px; line-height:0;}\n  .sor-hero__stars svg{width:13px; height:13px; display:block;}\n  .sor-hero__rating u{text-underline-offset:2px;}\n  .sor-hero__dot{color:var(--sor-cola);}\n\n  /* --- titre --- */\n  .sor-hero__title{\n    font-family:var(--sor-serif); font-weight:300; font-size:25px;\n    line-height:1.2; letter-spacing:-.01em; margin:0 0 8px; color:var(--sor-cola);\n  }\n\n  /* --- prix --- */\n  .sor-hero__prices{\n    display:flex; align-items:center; flex-wrap:wrap; gap:10px;\n    margin:0 0 12px; font-family:var(--sor-sans);\n  }\n  .sor-hero__price{\n    font-size:21px; line-height:1; font-weight:700;\n    color:var(--sor-orange); letter-spacing:-.01em;\n  }\n  .sor-hero__compare{\n    font-size:16px; line-height:1; font-weight:700;\n    color:var(--sor-strike); text-decoration:line-through;\n  }\n  .sor-hero__save{\n    display:inline-block; background:var(--sor-green); color:#fff;\n    font-size:12px; font-weight:700; line-height:1;\n    padding:6px 10px; border-radius:7px; letter-spacing:.01em;\n  }\n\n  /* --- bullets --- */\n  .sor-hero__list{list-style:none; margin:0; padding:0;}\n  .sor-hero__list li{\n    position:relative; padding-left:18px; margin:0 0 6px; font-family:var(--sor-sans);\n    font-size:13.5px; font-weight:400; line-height:1.45; color:var(--sor-cola);\n  }\n  .sor-hero__list li b{font-weight:700;}\n  .sor-hero__list li::before{\n    content:\"\"; position:absolute; left:6px; top:.62em;\n    width:4px; height:4px; border-radius:50%; background:var(--sor-cola);\n  }\n\n  @media (min-width:750px){\n    .sor-hero__badge{font-size:13px;}\n    .sor-hero__rating{font-size:13.5px;}\n    .sor-hero__stars svg{width:14px; height:14px;}\n    .sor-hero__title{font-size:32px;}\n    .sor-hero__price{font-size:25px;}\n    .sor-hero__compare{font-size:19px;}\n    .sor-hero__save{font-size:13px;}\n    .sor-hero__list li{font-size:14.5px;}\n  }\n</style>\n\n<div class=\"sor-hero\">\n\n  <span class=\"sor-hero__badge\">{{ sor_badge }}</span>\n\n  <div class=\"sor-hero__rating\">\n    <span class=\"sor-hero__stars\" aria-hidden=\"true\">\n      {%- for i in (1..4) -%}\n        <svg viewBox=\"0 0 20 20\" fill=\"#F56045\"><path d=\"M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z\"/></svg>\n      {%- endfor -%}\n      <svg viewBox=\"0 0 20 20\">\n        <defs><linearGradient id=\"sor-half\"><stop offset=\"60%\" stop-color=\"#F56045\"/><stop offset=\"60%\" stop-color=\"#E3DCD6\"/></linearGradient></defs>\n        <path fill=\"url(#sor-half)\" d=\"M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z\"/>\n      </svg>\n    </span>\n    <span><u>Noté {{ sor_note }}</u></span>\n    <span class=\"sor-hero__dot\">·</span>\n    <span><u>Adopté par {{ sor_clientes }}</u></span>\n  </div>\n\n  <h1 class=\"sor-hero__title\">{{ sor_titre }}</h1>\n\n  <div class=\"sor-hero__prices\">\n    <span class=\"sor-hero__price\">{{ sor_prix }}</span>\n    <span class=\"sor-hero__compare\">{{ sor_prix_barre }}</span>\n    <span class=\"sor-hero__save\">{{ sor_remise }}</span>\n  </div>\n\n  <ul class=\"sor-hero__list\">\n    <li><b>Douleurs de règles et endo</b> — efficace même sur les fortes douleurs</li>\n    <li><b>Double action</b> — impulsions + chaleur pour un confort maximal</li>\n    <li><b>100% sans médicament</b> — soulagée, sans les effets secondaires</li>\n    <li><b>Partout avec toi</b> — fini les plans annulés</li>\n    <li><b>Soulagement en 5 minutes seulement</b></li>\n  </ul>\n\n</div>"
          }
        },
