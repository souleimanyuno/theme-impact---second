            "liquid": "{% comment %}\n  BLOQUE — Stock, compras y fecha de entrega\n{% endcomment %}\n\n<div class=\"srl-urgency\">\n  <style>\n    .srl-urgency {\n      width: 100%;\n      max-width: 560px;\n      margin: 0 auto;\n      padding: 16px 4px;\n      font-family: inherit;\n      color: #373737;\n    }\n\n    .srl-urgency *,\n    .srl-urgency *::before,\n    .srl-urgency *::after {\n      box-sizing: border-box;\n    }\n\n    .srl-urgency__list {\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n      margin: 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .srl-urgency__item {\n      display: flex;\n      align-items: flex-start;\n      gap: 12px;\n      margin: 0;\n      padding: 0;\n    }\n\n    .srl-urgency__dot {\n      flex: none;\n      width: 9px;\n      height: 9px;\n      margin-top: 7px;\n      border-radius: 50%;\n    }\n\n    .srl-urgency__dot--stock {\n      background: #ffb2b4;\n    }\n\n    .srl-urgency__dot--sales {\n      background: #373737;\n    }\n\n    .srl-urgency__dot--delivery {\n      background: #9dbda8;\n    }\n\n    .srl-urgency__text {\n      margin: 0;\n      font-size: 17px;\n      font-weight: 800;\n      line-height: 1.45;\n      letter-spacing: -0.01em;\n      color: #373737;\n    }\n\n    .srl-urgency__stock {\n      color: #ff353b;\n    }\n\n    @media screen and (max-width: 749px) {\n      .srl-urgency {\n        padding: 14px 2px;\n      }\n\n      .srl-urgency__list {\n        gap: 15px;\n      }\n\n      .srl-urgency__item {\n        gap: 11px;\n      }\n\n      .srl-urgency__text {\n        font-size: 16px;\n      }\n\n      .srl-urgency__dot {\n        width: 9px;\n        height: 9px;\n        margin-top: 7px;\n      }\n    }\n  </style>\n\n  <ul class=\"srl-urgency__list\">\n    <li class=\"srl-urgency__item\">\n      <span class=\"srl-urgency__dot srl-urgency__dot--stock\"></span>\n\n      <p class=\"srl-urgency__text\">\n        <span class=\"srl-urgency__stock\">Bajo stock</span>\n        (Agosto tiene alto riesgo de agotarse)\n      </p>\n    </li>\n\n    <li class=\"srl-urgency__item\">\n      <span class=\"srl-urgency__dot srl-urgency__dot--sales\"></span>\n\n      <p class=\"srl-urgency__text\">\n        +514 compras realizadas hoy\n      </p>\n    </li>\n\n    <li class=\"srl-urgency__item\">\n      <span class=\"srl-urgency__dot srl-urgency__dot--delivery\"></span>\n\n      <p class=\"srl-urgency__text\">\n        En tu casa el 13 de agosto\n      </p>\n    </li>\n  </ul>\n</div>"
