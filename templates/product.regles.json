    "custom_liquid_gXtP7b": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ============================================================\n  SORELYA FR — B4 : bloc promesse (vidéo + texte)\n  Clone du bloc Myoovi « For women who need instant pain relief. »\n  ÉCHELLE : lead serif 22/28 · sous-titre serif 16/18 · corps 13.5/14.5\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ---------- VARIABLES À MODIFIER ---------- {%- endcomment -%}\n{%- assign sor_video      = \"https://cdn.shopify.com/videos/c/o/v/17cb85bb7fc5419da92367b3e8086cf7.mp4\" -%}\n{%- assign sor_overlay_1  = \"Soulagement immédiat\" -%}\n{%- assign sor_overlay_2  = \"efficace en quelques secondes !\" -%}\n{%- assign sor_fond       = \"#F3EFEC\" -%}\n{%- comment -%} ----------------------------------------- {%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sor-prom{\n    --sor-cola:#3C2C26;\n    --sor-serif:'Fraunces','Times New Roman',Times,serif;\n    --sor-sans:'Helvetica Neue',Helvetica,Arial,sans-serif;\n    background:{{ sor_fond }};\n    padding:18px 18px 26px;\n    font-family:var(--sor-sans);\n    color:var(--sor-cola);\n  }\n  .sor-prom *{box-sizing:border-box;}\n  .sor-prom__inner{max-width:620px;margin:0 auto;}\n\n  /* --- vidéo --- */\n  .sor-prom__media{\n    position:relative; border-radius:22px; overflow:hidden;\n    margin:0 0 22px; line-height:0;\n  }\n  .sor-prom__media video{\n    display:block; width:100%; height:auto; object-fit:cover;\n  }\n  .sor-prom__overlay{\n    position:absolute; left:0; right:0; bottom:22px;\n    text-align:center; padding:0 16px; color:#fff;\n    text-shadow:0 1px 12px rgba(0,0,0,.28);\n  }\n  .sor-prom__overlay strong{\n    display:block; font-family:var(--sor-sans);\n    font-size:19px; font-weight:700; line-height:1.2; margin:0 0 3px;\n  }\n  .sor-prom__overlay em{\n    display:block; font-family:var(--sor-serif);\n    font-style:italic; font-weight:400; font-size:17px; line-height:1.2;\n  }\n\n  /* --- texte --- */\n  .sor-prom__title{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:22px; line-height:1.2; letter-spacing:-.01em; margin:0 0 12px;\n  }\n  .sor-prom__lead{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:16px; line-height:1.4; margin:0 0 14px;\n  }\n  .sor-prom__text{\n    font-family:var(--sor-sans); font-weight:400;\n    font-size:13.5px; line-height:1.6; margin:0 0 12px;\n  }\n  .sor-prom__text:last-child{margin:0;}\n\n  @media (min-width:750px){\n    .sor-prom{padding:26px 18px 34px;}\n    .sor-prom__overlay{bottom:30px;}\n    .sor-prom__overlay strong{font-size:24px;}\n    .sor-prom__overlay em{font-size:21px;}\n    .sor-prom__title{font-size:28px;}\n    .sor-prom__lead{font-size:18px;}\n    .sor-prom__text{font-size:14.5px;}\n  }\n</style>\n\n<div class=\"sor-prom\">\n  <div class=\"sor-prom__inner\">\n\n    <div class=\"sor-prom__media\">\n      <video\n        src=\"{{ sor_video }}\"\n        autoplay muted loop playsinline\n        preload=\"metadata\"\n        aria-label=\"{{ sor_overlay_1 }}\"></video>\n      <div class=\"sor-prom__overlay\">\n        <strong>{{ sor_overlay_1 }}</strong>\n        <em>{{ sor_overlay_2 }}</em>\n      </div>\n    </div>\n\n    <h2 class=\"sor-prom__title\">Pour les femmes qui ont besoin d'un soulagement immédiat.</h2>\n\n    <p class=\"sor-prom__lead\">Fini les antidouleurs, les crampes qui te plient en deux et les\n    plans annulés…</p>\n\n    <p class=\"sor-prom__text\">Découvre Sorelya 2.0 — notre appareil le plus avancé.</p>\n\n    <p class=\"sor-prom__text\">En associant la technologie TENS, éprouvée, à une douce thérapie\n    par la chaleur, il soulage rapidement les douleurs de règles et d'endométriose, sans\n    médicament : il bloque les signaux de douleur et détend tes muscles.</p>\n\n    <p class=\"sor-prom__text\">Pour te laisser… détendue, à l'aise, et de nouveau aux commandes.</p>\n\n  </div>\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_ENU4G3": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ============================================================\n  SORELYA FR — B5 : slider témoignages\n  Clone du bloc Myoovi « Backed by science, loved by you… »\n  6 avis courts repris de leur slider, traduits.\n  Défilement horizontal natif (scroll-snap), aucun JS.\n  ÉCHELLE : titre serif 25/34 · titre carte serif 18/20 · corps 13.5/14.5\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ---------- VARIABLES À MODIFIER ---------- {%- endcomment -%}\n{%- assign sor_bg    = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/d127c629-6ca0-4e23-a799-0d9a96290acd.png?v=1786728868\" -%}\n{%- assign sor_titre = \"Validé par la science, adoré par vous…\" -%}\n{%- comment -%} ----------------------------------------- {%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sor-avis{\n    --sor-serif:'Fraunces','Times New Roman',Times,serif;\n    --sor-sans:'Helvetica Neue',Helvetica,Arial,sans-serif;\n    position:relative;\n    background:url(\"{{ sor_bg }}&width=1400\") center/cover no-repeat;\n    padding:26px 0 30px;\n    font-family:var(--sor-sans);\n    color:#fff;\n    overflow:hidden;\n  }\n  .sor-avis *{box-sizing:border-box;}\n  .sor-avis::before{\n    content:\"\"; position:absolute; inset:0;\n    background:linear-gradient(180deg,rgba(0,0,0,.18) 0%,rgba(0,0,0,.05) 40%,rgba(0,0,0,.18) 100%);\n  }\n  .sor-avis__in{position:relative;}\n\n  .sor-avis__titre{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:25px; line-height:1.2; text-align:center;\n    margin:0 0 20px; padding:0 18px; color:#fff;\n    text-shadow:0 1px 14px rgba(0,0,0,.3);\n  }\n\n  /* --- rail --- */\n  .sor-avis__rail{\n    display:flex; gap:14px;\n    overflow-x:auto; scroll-snap-type:x mandatory;\n    padding:0 18px 6px;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n  }\n  .sor-avis__rail::-webkit-scrollbar{display:none;}\n\n  /* --- carte verre --- */\n  .sor-avis__card{\n    flex:0 0 78%; max-width:310px;\n    scroll-snap-align:center;\n    background:rgba(255,255,255,.16);\n    -webkit-backdrop-filter:blur(16px);\n    backdrop-filter:blur(16px);\n    border:1px solid rgba(255,255,255,.34);\n    border-radius:20px;\n    padding:18px 18px 20px;\n  }\n  .sor-avis__stars{display:flex; gap:3px; margin:0 0 12px; line-height:0;}\n  .sor-avis__stars svg{width:17px; height:17px; display:block;}\n\n  .sor-avis__t{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:18px; line-height:1.2; margin:0 0 10px; color:#fff;\n  }\n  .sor-avis__b{\n    font-family:var(--sor-sans); font-weight:400;\n    font-size:13.5px; line-height:1.5; margin:0 0 14px; color:#fff;\n  }\n  .sor-avis__n{\n    font-family:var(--sor-sans); font-weight:400;\n    font-size:13.5px; letter-spacing:.04em; text-transform:uppercase;\n    margin:0; color:#fff;\n  }\n\n  @media (min-width:750px){\n    .sor-avis{padding:34px 0 38px;}\n    .sor-avis__titre{font-size:34px; margin-bottom:26px;}\n    .sor-avis__rail{gap:18px; padding:0 28px 6px;}\n    .sor-avis__card{flex:0 0 330px; max-width:330px; padding:22px;}\n    .sor-avis__stars svg{width:19px; height:19px;}\n    .sor-avis__t{font-size:20px;}\n    .sor-avis__b, .sor-avis__n{font-size:14.5px;}\n  }\n</style>\n\n{%- capture sor_etoiles -%}\n  <span class=\"sor-avis__stars\" aria-hidden=\"true\">\n    {%- for i in (1..5) -%}\n      <svg viewBox=\"0 0 20 20\" fill=\"#fff\"><path d=\"M10 1.6l2.4 5.3 5.8.6-4.3 3.9 1.2 5.7L10 14.2 4.9 17.1l1.2-5.7L1.8 7.5l5.8-.6z\"/></svg>\n    {%- endfor -%}\n  </span>\n{%- endcapture -%}\n\n<div class=\"sor-avis\">\n  <div class=\"sor-avis__in\">\n\n    <h2 class=\"sor-avis__titre\">{{ sor_titre }}</h2>\n\n    <div class=\"sor-avis__rail\">\n\n      <div class=\"sor-avis__card\">\n        {{ sor_etoiles }}\n        <h3 class=\"sor-avis__t\">Efficace</h3>\n        <p class=\"sor-avis__b\">Super produit, il m'aide vraiment à gérer mes douleurs d'endo —\n        et il est tellement discret que je peux même le porter au travail.</p>\n        <p class=\"sor-avis__n\">Nathalie</p>\n      </div>\n\n      <div class=\"sor-avis__card\">\n        {{ sor_etoiles }}\n        <h3 class=\"sor-avis__t\">Ça m'a sauvée !</h3>\n        <p class=\"sor-avis__b\">Mes douleurs d'endométriose ont presque disparu avec ça —\n        incroyable !! J'en reprendrai un c'est sûr !!</p>\n        <p class=\"sor-avis__n\">Sophie</p>\n      </div>\n\n      <div class=\"sor-avis__card\">\n        {{ sor_etoiles }}\n        <h3 class=\"sor-avis__t\">5 étoiles !</h3>\n        <p class=\"sor-avis__b\">Petit appareil compact et bien pensé. Certains mois j'ai des\n        douleurs qui me clouent au lit ; là, je peux continuer ma journée. Service 5 étoiles aussi.</p>\n        <p class=\"sor-avis__n\">Claire</p>\n      </div>\n\n      <div class=\"sor-avis__card\">\n        {{ sor_etoiles }}\n        <h3 class=\"sor-avis__t\">Incroyable !!!</h3>\n        <p class=\"sor-avis__b\">J'adore ! Mes douleurs de règles sont terribles à cause de\n        l'endométriose, du SOPK et de kystes ovariens. Là je suis soulagée et je peux faire ma\n        journée normalement au travail.</p>\n        <p class=\"sor-avis__n\">Sarah</p>\n      </div>\n\n      <div class=\"sor-avis__card\">\n        {{ sor_etoiles }}\n        <h3 class=\"sor-avis__t\">Ça change la vie !</h3>\n        <p class=\"sor-avis__b\">Produit génial et service client génial, je suis bluffée, merci.</p>\n        <p class=\"sor-avis__n\">Marie-Jeanne</p>\n      </div>\n\n      <div class=\"sor-avis__card\">\n        {{ sor_etoiles }}\n        <h3 class=\"sor-avis__t\">Encore un service impeccable</h3>\n        <p class=\"sor-avis__b\">Formidable ! Je pense beaucoup de bien de cette marque et du\n        soulagement que ce produit apporte à ma fille. J'en parle autour de moi comme si c'était\n        de la famille.</p>\n        <p class=\"sor-avis__n\">Camille</p>\n      </div>\n\n    </div>\n\n  </div>\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_33tNMR": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ============================================================\n  SORELYA FR — B6A : « Get the Myoovi sensation »\n  Clone du bloc de conversion Myoovi : visuel + stat + 3 blocs\n  problème → solution (antidouleurs / clouée au lit / plans annulés)\n  ⚠️ « Jusqu'à 90% des femmes » = chiffre repris de Myoovi, non sourcé\n     chez eux. À sourcer ou à retirer avant mise en ligne.\n  ÉCHELLE : titre serif 25/34 · stat serif 17/20 · sous-titres serif 16/18\n            corps 13.5/14.5\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ---------- VARIABLES À MODIFIER ---------- {%- endcomment -%}\n{%- assign sor_img    = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_14_aout_2026_18_45_18.png?v=1786729536\" -%}\n{%- assign sor_ico_1  = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/NELORYA_13.png?v=1786729964\" -%}\n{%- assign sor_ico_2  = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/NELORYA_17_11e32f77-8b2d-4ac0-85fb-763514e13cbf.png?v=1786729967\" -%}\n{%- assign sor_ico_3  = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/NELORYA_18.png?v=1786729984\" -%}\n{%- assign sor_titre  = \"Découvre la sensation Sorelya\" -%}\n{%- assign sor_fond   = \"#FCF8F5\" -%}\n{%- comment -%} ----------------------------------------- {%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sor-sens{\n    --sor-cola:#3C2C26;\n    --sor-serif:'Fraunces','Times New Roman',Times,serif;\n    --sor-sans:'Helvetica Neue',Helvetica,Arial,sans-serif;\n    background:{{ sor_fond }};\n    padding:0 0 26px;\n    font-family:var(--sor-sans);\n    color:var(--sor-cola);\n  }\n  .sor-sens *{box-sizing:border-box;}\n\n  /* --- visuel --- */\n  .sor-sens__hero{\n    display:block; width:100%;\n    aspect-ratio:4/5; object-fit:cover; object-position:center 28%;\n    margin:0 0 22px;\n  }\n\n  .sor-sens__in{padding:0 18px; max-width:660px; margin:0 auto;}\n\n  .sor-sens__titre{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:25px; line-height:1.18; letter-spacing:-.01em;\n    margin:0 0 16px;\n  }\n  .sor-sens__stat{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:17px; line-height:1.35;\n    margin:0 0 26px;\n  }\n\n  /* --- blocs problème → solution --- */\n  .sor-sens__item{margin:0 0 24px;}\n  .sor-sens__item:last-child{margin:0;}\n  .sor-sens__head{\n    display:flex; align-items:center; gap:14px; margin:0 0 12px;\n  }\n  .sor-sens__head img{\n    flex:0 0 auto; width:58px; height:58px; object-fit:contain; display:block;\n  }\n  .sor-sens__head h3{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:16px; line-height:1.25; margin:0; color:var(--sor-cola);\n  }\n  .sor-sens__item p{\n    font-family:var(--sor-sans); font-weight:400;\n    font-size:13.5px; line-height:1.6; margin:0;\n  }\n\n  @media (min-width:750px){\n    .sor-sens{padding-bottom:34px;}\n    .sor-sens__hero{aspect-ratio:16/9; object-position:center 25%; margin-bottom:28px;}\n    .sor-sens__titre{font-size:34px;}\n    .sor-sens__stat{font-size:20px; margin-bottom:32px;}\n    .sor-sens__head img{width:66px; height:66px;}\n    .sor-sens__head h3{font-size:18px;}\n    .sor-sens__item p{font-size:14.5px;}\n    .sor-sens__item{margin-bottom:28px;}\n  }\n</style>\n\n<div class=\"sor-sens\">\n\n  <img class=\"sor-sens__hero\"\n       src=\"{{ sor_img }}&width=1200\"\n       alt=\"Femme portant l'appareil Sorelya sous ses vêtements\"\n       width=\"1254\" height=\"1254\" loading=\"lazy\">\n\n  <div class=\"sor-sens__in\">\n\n    <h2 class=\"sor-sens__titre\">{{ sor_titre }}</h2>\n\n    <p class=\"sor-sens__stat\">Jusqu'à 90% des femmes souffrent de douleurs de règles.\n    Essaie Sorelya 2.0 et ressens la différence d'un soulagement à double action.</p>\n\n    <div class=\"sor-sens__item\">\n      <div class=\"sor-sens__head\">\n        <img src=\"{{ sor_ico_1 }}&width=200\" alt=\"\" width=\"200\" height=\"200\" loading=\"lazy\">\n        <h3>Les antidouleurs te plombent ?</h3>\n      </div>\n      <p>Tu mérites mieux que d'attendre qu'un cachet fasse effet. Sorelya 2.0 apporte un\n      soulagement immédiat et sans médicament, grâce à la double action TENS + chaleur.\n      C'est prouvé, c'est naturel, et c'est sans médicament.</p>\n    </div>\n\n    <div class=\"sor-sens__item\">\n      <div class=\"sor-sens__head\">\n        <img src=\"{{ sor_ico_2 }}&width=200\" alt=\"\" width=\"200\" height=\"200\" loading=\"lazy\">\n        <h3>Des crampes qui te clouent au lit ?</h3>\n      </div>\n      <p>Tu crois que ce cycle de douleur ne s'arrêtera jamais, mais si… Les patchs Sorelya\n      couvrent une zone plus large : ils détendent tes muscles tout en bloquant les signaux de\n      douleur. Un soulagement que tu sens en quelques minutes.</p>\n    </div>\n\n    <div class=\"sor-sens__item\">\n      <div class=\"sor-sens__head\">\n        <img src=\"{{ sor_ico_3 }}&width=200\" alt=\"\" width=\"200\" height=\"200\" loading=\"lazy\">\n        <h3>Encore un plan annulé ?</h3>\n      </div>\n      <p>Annuler tes plans ou poser une journée, ce n'est pas juste embêtant, c'est une plaie…\n      Sorelya 2.0 est sans fil, discret, et se porte sous tes vêtements. Pour te laisser vivre,\n      bouger et te sentir au mieux.</p>\n    </div>\n\n  </div>\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_rkNFEW": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ============================================================\n  SORELYA FR — B8 : « Quelles sensations ? »\n  Clone du bloc Myoovi « How will Myoovi 2.0 feel? »\n  Rôle : casser l'objection « les impulsions, ça fait mal ? »\n  ÉCHELLE : titre serif 25/34 · chapô serif 17/20 · corps serif 14/15\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ---------- VARIABLES À MODIFIER ---------- {%- endcomment -%}\n{%- assign sor_img   = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_14_aout_2026_19_52_38.png?v=1786733588\" -%}\n{%- assign sor_titre = \"Quelles sensations avec Sorelya 2.0 ?\" -%}\n{%- assign sor_fond  = \"#fff\" -%}\n{%- comment -%} ----------------------------------------- {%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sor-feel{\n    --sor-cola:#3C2C26;\n    --sor-serif:'Fraunces','Times New Roman',Times,serif;\n    background:{{ sor_fond }};\n    padding:20px 18px 28px;\n    color:var(--sor-cola);\n  }\n  .sor-feel *{box-sizing:border-box;}\n  .sor-feel__in{max-width:620px; margin:0 auto;}\n\n  .sor-feel__img{\n    display:block; width:100%; height:auto;\n    aspect-ratio:1/1; object-fit:cover;\n    border-radius:18px;\n    margin:0 0 22px;\n  }\n\n  .sor-feel__titre{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:25px; line-height:1.2; letter-spacing:-.01em;\n    margin:0 0 16px;\n  }\n  .sor-feel__lead{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:17px; line-height:1.4;\n    margin:0 0 20px;\n  }\n  .sor-feel__p{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:14px; line-height:1.55;\n    margin:0 0 14px;\n  }\n  .sor-feel__p:last-child{margin:0;}\n\n  @media (min-width:750px){\n    .sor-feel{padding:28px 18px 36px;}\n    .sor-feel__img{border-radius:22px; margin-bottom:28px;}\n    .sor-feel__titre{font-size:34px;}\n    .sor-feel__lead{font-size:20px;}\n    .sor-feel__p{font-size:15px;}\n  }\n</style>\n\n<div class=\"sor-feel\">\n  <div class=\"sor-feel__in\">\n\n    <img class=\"sor-feel__img\"\n         src=\"{{ sor_img }}&width=1200\"\n         alt=\"Deux amies portant l'appareil Sorelya sous leurs vêtements\"\n         width=\"1254\" height=\"1254\" loading=\"lazy\">\n\n    <h2 class=\"sor-feel__titre\">{{ sor_titre }}</h2>\n\n    <p class=\"sor-feel__lead\">Sorelya diffuse de douces vibrations et une chaleur apaisante :\n    la sensation d'un massage pulsé, sous tes vêtements.</p>\n\n    <p class=\"sor-feel__p\">Tes douleurs de règles envolées, tu peux continuer ta journée,\n    retrouver tes amies, aller travailler et faire ce que tu aimes le plus.</p>\n\n    <p class=\"sor-feel__p\">Son design sans fil et discret, c'est zéro fil emmêlé et zéro\n    contrainte — porte ta Sorelya partout, tu oublieras même qu'elle est là.</p>\n\n  </div>\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_ThaW7H": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  ============================================================\n  SORELYA FR — B11 : bloc communauté + marquee infini\n  Clone du bloc Myoovi « Unite with 1000's of women. »\n  Défilement continu droite → gauche, CSS pur, pause au survol,\n  désactivé si l'utilisatrice a réduit les animations.\n  ⚠️ « des milliers de femmes » : à ajuster quand on aura nos vrais\n     chiffres (cf. le point preuve sociale de la blockmap).\n  ÉCHELLE : titre serif 25/34 · sous-titre serif 16/18\n  ============================================================\n{%- endcomment -%}\n\n{%- comment -%} ---------- VARIABLES À MODIFIER ---------- {%- endcomment -%}\n{%- assign sor_titre = \"Rejoins des milliers de femmes.\" -%}\n{%- assign sor_sous  = \"La mission de Sorelya : en finir avec les douleurs de règles… naturellement.\" -%}\n{%- assign sor_fond  = \"#FCF8F5\" -%}\n{%- assign sor_vitesse = \"55s\" -%}\n{%- assign sor_imgs = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_14_aout_2026_22_11_31.png?v=1786741903,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_14_aout_2026_22_07_46.png?v=1786741845,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/9f0580d1-b6f4-4c00-b556-8e7769a00629.png?v=1786739506,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/a4c8c9b1-5c7c-49ea-a740-5f415ff7fd28.png?v=1786739506,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/eba77fea-b245-4bfc-8840-46d81c5fefc7.png?v=1786741844,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/8345b222-83bd-4f6e-990a-9c0941ad37ae.png?v=1786741845,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/46acb0d0-df3b-48a0-9a90-0b574a3e47d1.png?v=1786741843,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_14_aout_2026_22_09_45.png?v=1786741845,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_14_aout_2026_21_35_17.png?v=1786741842,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/37b10fb4-ff95-419a-9e22-f695f325853d.png?v=1786741844\" | split: \",\" -%}\n{%- comment -%} ----------------------------------------- {%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .sor-uni{\n    --sor-cola:#3C2C26;\n    --sor-serif:'Fraunces','Times New Roman',Times,serif;\n    background:{{ sor_fond }};\n    padding:26px 0 30px;\n    color:var(--sor-cola);\n    overflow:hidden;\n  }\n  .sor-uni *{box-sizing:border-box;}\n\n  .sor-uni__head{padding:0 18px; text-align:center; max-width:620px; margin:0 auto 22px;}\n  .sor-uni__titre{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:25px; line-height:1.2; margin:0 0 12px;\n  }\n  .sor-uni__sous{\n    font-family:var(--sor-serif); font-weight:300;\n    font-size:16px; line-height:1.35; margin:0;\n  }\n\n  /* --- marquee --- */\n  .sor-uni__mask{overflow:hidden; width:100%;}\n  .sor-uni__track{\n    display:flex;\n    width:max-content;\n    animation:sor-marquee {{ sor_vitesse }} linear infinite;\n    will-change:transform;\n  }\n  .sor-uni__mask:hover .sor-uni__track{animation-play-state:paused;}\n  .sor-uni__track img{\n    display:block;\n    width:200px; height:200px;\n    margin-right:12px;\n    object-fit:cover;\n    border-radius:14px;\n    flex:0 0 auto;\n  }\n  @keyframes sor-marquee{\n    from{transform:translateX(0);}\n    to{transform:translateX(-50%);}\n  }\n  @media (prefers-reduced-motion:reduce){\n    .sor-uni__track{animation:none;}\n    .sor-uni__mask{overflow-x:auto;}\n  }\n\n  @media (min-width:750px){\n    .sor-uni{padding:36px 0 42px;}\n    .sor-uni__titre{font-size:34px;}\n    .sor-uni__sous{font-size:18px;}\n    .sor-uni__head{margin-bottom:30px;}\n    .sor-uni__track img{width:280px; height:280px; margin-right:16px; border-radius:18px;}\n  }\n</style>\n\n<div class=\"sor-uni\">\n\n  <div class=\"sor-uni__head\">\n    <h2 class=\"sor-uni__titre\">{{ sor_titre }}</h2>\n    <p class=\"sor-uni__sous\">{{ sor_sous }}</p>\n  </div>\n\n  <div class=\"sor-uni__mask\">\n    <div class=\"sor-uni__track\">\n      {%- for i in (1..2) -%}\n        {%- for u in sor_imgs -%}\n          <img src=\"{{ u }}&width=600\" alt=\"\" width=\"600\" height=\"600\" loading=\"lazy\">\n        {%- endfor -%}\n      {%- endfor -%}\n    </div>\n  </div>\n\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
