    "custom_liquid_33tNMR": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-diff2\">\n  <h2 class=\"sor-diff2-title\">Zie het <em>verschil</em> in hoe je je voelt</h2>\n\n  <div class=\"sor-diff2-grid\">\n    <div class=\"sor-diff2-card\">\n      <div class=\"sor-diff2-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_215618_63de4128-c3f8-49ac-a995-6994acd75b8b_430x.png?v=1785611936\" alt=\"Vermindert zwelling\" loading=\"lazy\">\n      </div>\n      <div class=\"sor-diff2-body\">\n        <h3>Vermindert Zwelling</h3>\n        <p>Gezicht, ogen en wangen minder gezwollen vanaf de eerste ochtend.</p>\n      </div>\n    </div>\n\n    <div class=\"sor-diff2-card\">\n      <div class=\"sor-diff2-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/ChatGPT_Image_1_aout_2026_20_20_37_430x.png?v=1785612042\" alt=\"Voert vocht af\" loading=\"lazy\">\n      </div>\n      <div class=\"sor-diff2-body\">\n        <h3>Voert Vocht Af</h3>\n        <p>Geen zware benen, gezwollen enkels of vochtretentie meer.</p>\n      </div>\n    </div>\n\n    <div class=\"sor-diff2-card\">\n      <div class=\"sor-diff2-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_215636_eca5ce05-5c01-486d-9663-672300d3ffc4_430x.png?v=1785611936\" alt=\"Stabiele energie\" loading=\"lazy\">\n      </div>\n      <div class=\"sor-diff2-body\">\n        <h3>Stabiele Energie</h3>\n        <p>Natuurlijke vitaliteit zonder pieken, dalen of vermoeidheid.</p>\n      </div>\n    </div>\n\n    <div class=\"sor-diff2-card\">\n      <div class=\"sor-diff2-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_215646_a15975c6-f699-401b-856c-452910f6b97c_430x.png?v=1785611936\" alt=\"Innerlijke glow\" loading=\"lazy\">\n      </div>\n      <div class=\"sor-diff2-body\">\n        <h3>Innerlijke Glow</h3>\n        <p>Heldere huid, frisse oogopslag, verfijnde contouren.</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.sor-diff2{font-family:inherit;max-width:100%;}\n\n.sor-diff2-title{\n  text-align:center;\n  font-size:19px;\n  font-weight:800;\n  color:#1a1a1a;\n  margin:0 0 20px;\n  line-height:1.3;\n}\n.sor-diff2-title em{font-style:italic;}\n\n.sor-diff2-grid{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:12px;\n}\n.sor-diff2-card{\n  border-radius:14px;\n  overflow:hidden;\n  background:#F5F4F1;\n}\n.sor-diff2-img{\n  width:100%;\n  aspect-ratio:1/1;\n  overflow:hidden;\n}\n.sor-diff2-img img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  display:block;\n}\n.sor-diff2-body{\n  padding:14px 12px 18px;\n  text-align:center;\n}\n.sor-diff2-body h3{\n  font-size:14px;\n  font-weight:800;\n  color:#1a1a1a;\n  margin:0 0 6px;\n}\n.sor-diff2-body p{\n  font-size:12px;\n  line-height:1.45;\n  color:#5a5a5a;\n  margin:0;\n}\n\n@media (min-width:750px){\n  .sor-diff2-title{font-size:30px;margin-bottom:32px;}\n  .sor-diff2-grid{grid-template-columns:repeat(4,1fr);gap:20px;}\n  .sor-diff2-body{padding:20px 16px 24px;}\n  .sor-diff2-body h3{font-size:19px;}\n  .sor-diff2-body p{font-size:14.5px;}\n}\n</style>",
