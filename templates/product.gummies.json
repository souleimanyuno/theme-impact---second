    "custom_liquid_ThaW7H": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": false,
        "liquid": "{% comment %}\n  BLOQUE 7 — Comparativa D-tox vs Otros (Sorelya)\n  Imagen derecha (\"Otros\"): se reutiliza el mismo pack con blur + escala de grises para\n  representar una marca genérica anónima (mismo recurso visual que usa la referencia).\n  Si tienes una imagen genérica propia, sustitúyela en srl_pack_otros.\n{% endcomment %}\n{% assign srl_pack_dtox = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/NELORYA_6_430x.png?v=1786400556\" %}\n{% assign srl_pack_otros = \"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/NELORYA_6_430x.png?v=1786400556\" %}\n{% assign srl_cta_url = \"#comprar\" %}\n\n<div class=\"srl-cmp\">\n  <style>\n    .srl-cmp {\n      --srl-deep: #2f5344;\n      --srl-green-dark: #37533b;\n      --srl-yes: #2f5344;\n      --srl-no: #cf4444;\n      --srl-line: #e3e3df;\n      --srl-soft: #f7f7f5;\n      --srl-ink: #1a1a1a;\n      --srl-muted: #55554f;\n      font-family: inherit;\n      color: var(--srl-ink);\n      max-width: 860px;\n      margin: 0 auto;\n      padding: 56px 20px 56px;\n      box-sizing: border-box;\n    }\n    .srl-cmp *, .srl-cmp *::before, .srl-cmp *::after { box-sizing: border-box; }\n\n    /* --- Zona superior: packs + badge VS --- */\n    .srl-cmp__top {\n      position: relative;\n      display: grid;\n      grid-template-columns: 1fr 1.15fr 1fr;\n      align-items: end;\n      z-index: 1;\n    }\n    .srl-cmp__pack { text-align: center; }\n    .srl-cmp__pack img {\n      width: 100%;\n      max-width: 150px;\n      height: auto;\n      display: inline-block;\n    }\n    .srl-cmp__pack--otros img {\n      filter: grayscale(60%) blur(2px) brightness(1.05);\n      opacity: .75;\n    }\n    .srl-cmp__spacer {\n      background: var(--srl-deep);\n      border-radius: 14px 14px 0 0;\n      height: 100%;\n      min-height: 90px;\n      position: relative;\n    }\n    .srl-cmp__vs {\n      position: absolute;\n      top: -34px;\n      left: 50%;\n      transform: translateX(-50%);\n      width: 84px;\n      height: 84px;\n      border-radius: 50%;\n      background: #fff;\n      border: 3px solid var(--srl-deep);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 22px;\n      font-weight: 800;\n      color: var(--srl-ink);\n      z-index: 3;\n    }\n\n    /* --- Tabla --- */\n    .srl-cmp__table {\n      border: 2px solid var(--srl-deep);\n      border-radius: 14px;\n      overflow: hidden;\n      background: #fff;\n    }\n    .srl-cmp__row {\n      display: grid;\n      grid-template-columns: 1fr 1.15fr 1fr;\n      border-bottom: 1px solid var(--srl-line);\n    }\n    .srl-cmp__row:last-child { border-bottom: 0; }\n\n    .srl-cmp__cell {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      padding: 22px 12px;\n      text-align: center;\n    }\n    .srl-cmp__cell--side { background: var(--srl-soft); }\n    .srl-cmp__row:not(.srl-cmp__row--head) .srl-cmp__cell--side { background: #fff; }\n    .srl-cmp__cell--feat {\n      background: var(--srl-deep);\n      color: #fff;\n      font-size: 17px;\n      font-weight: 800;\n      line-height: 1.35;\n      padding: 22px 16px;\n    }\n\n    .srl-cmp__row--head .srl-cmp__cell--side {\n      font-size: 17px;\n      font-weight: 800;\n      color: var(--srl-deep);\n      line-height: 1.35;\n      padding: 26px 12px;\n    }\n    .srl-cmp__row--head .srl-cmp__cell--feat { font-size: 20px; padding: 26px 16px; }\n\n    .srl-cmp__mark {\n      width: 44px;\n      height: 44px;\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #fff;\n      font-size: 20px;\n      font-weight: 700;\n      line-height: 1;\n    }\n    .srl-cmp__mark--yes { background: var(--srl-yes); }\n    .srl-cmp__mark--no  { background: var(--srl-no); }\n\n    /* --- CTA --- */\n    .srl-cmp__cta-wrap { text-align: center; margin-top: 36px; }\n    .srl-cmp__cta {\n      display: block;\n      width: 100%;\n      background: var(--srl-green-dark);\n      color: #fff;\n      font-size: 17px;\n      font-weight: 800;\n      letter-spacing: .03em;\n      text-decoration: none;\n      padding: 22px 24px;\n      border-radius: 999px;\n      box-shadow: 0 4px 0 rgba(0,0,0,.14);\n      transition: transform .12s ease, box-shadow .12s ease;\n    }\n    .srl-cmp__cta:hover { transform: translateY(2px); box-shadow: 0 2px 0 rgba(0,0,0,.14); }\n    .srl-cmp__guarantee {\n      display: flex; align-items: center; justify-content: center;\n      gap: 8px; font-size: 15px; color: var(--srl-muted); margin-top: 16px;\n    }\n    .srl-cmp__guarantee svg { flex: none; }\n\n    @media (max-width: 640px) {\n      .srl-cmp { padding: 44px 14px; }\n      .srl-cmp__pack img { max-width: 104px; }\n      .srl-cmp__vs { width: 68px; height: 68px; top: -28px; font-size: 18px; }\n      .srl-cmp__cell { padding: 18px 8px; }\n      .srl-cmp__cell--feat { font-size: 15px; padding: 18px 10px; }\n      .srl-cmp__row--head .srl-cmp__cell--side { font-size: 15px; padding: 20px 8px; }\n      .srl-cmp__row--head .srl-cmp__cell--feat { font-size: 17px; padding: 20px 10px; }\n      .srl-cmp__mark { width: 38px; height: 38px; font-size: 17px; }\n      .srl-cmp__cta { font-size: 15px; padding: 20px 18px; }\n    }\n  </style>\n\n  <div class=\"srl-cmp__top\">\n    <div class=\"srl-cmp__pack\">\n      <img src=\"{{ srl_pack_dtox }}\" alt=\"Pack D-tox Sorelya\" loading=\"lazy\" width=\"150\" height=\"200\">\n    </div>\n    <div class=\"srl-cmp__spacer\">\n      <span class=\"srl-cmp__vs\">VS</span>\n    </div>\n    <div class=\"srl-cmp__pack srl-cmp__pack--otros\">\n      <img src=\"{{ srl_pack_otros }}\" alt=\"Otras marcas de vinagre de manzana\" loading=\"lazy\" width=\"150\" height=\"200\">\n    </div>\n  </div>\n\n  <div class=\"srl-cmp__table\">\n\n    <div class=\"srl-cmp__row srl-cmp__row--head\">\n      <div class=\"srl-cmp__cell srl-cmp__cell--side\">D-tox<br>Premium</div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Característica</div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--side\">Otros Vinagres de Manzana</div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Con \"La Madre\" (Probióticos Naturales)</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Vitamina C Añadida</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Pectina de Fruta (Fibra)</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Fácil de Tomar (Gominolas)</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Sin Sabor Ácido Desagradable</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Dosis Óptima (300mg)</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Producido en Laboratorio Certificado</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Control de Antojos Comprobado</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Ingredientes Artificiales &amp; Rellenos</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Baja Potencia &amp; Baja Absorción</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n    </div>\n\n    <div class=\"srl-cmp__row\">\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--no\">✕</span></div>\n      <div class=\"srl-cmp__cell srl-cmp__cell--feat\">Difícil de Tomar o Mal Sabor</div>\n      <div class=\"srl-cmp__cell\"><span class=\"srl-cmp__mark srl-cmp__mark--yes\">✓</span></div>\n    </div>\n\n  </div>\n\n  <div class=\"srl-cmp__cta-wrap\">\n    <a href=\"{{ srl_cta_url }}\" class=\"srl-cmp__cta\">COMPRAR AHORA Y AHORRAR</a>\n    <div class=\"srl-cmp__guarantee\">\n      <svg width=\"18\" height=\"20\" viewBox=\"0 0 18 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n        <path d=\"M9 1L1 4v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V4L9 1z\" fill=\"#37533b\"/>\n      </svg>\n      <span>Garantía de devolución de 30 días</span>\n    </div>\n  </div>\n</div>",
