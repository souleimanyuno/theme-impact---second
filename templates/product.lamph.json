    "custom_liquid_rkNFEW": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-proof\">\n\n  <div class=\"sor-proof-head\">\n    <h2>Waarom <em>Sorelya</em> vertrouwen?</h2>\n    <p>Zuivere ingrediënten en een formule geworteld in traditionele kruidenkennis.</p>\n  </div>\n\n  <div class=\"sor-proof-points\">\n    <div class=\"sor-pp\">\n      <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"8\" r=\"3\"/><path d=\"M12 11v10M9 6.5C7 5 5.5 6 6 8s2.5 1.8 3 .5M15 6.5c2-1.5 3.5-.5 3 1.5s-2.5 1.8-3 .5\"/></svg>\n      <div><h3>Herbalistische inspiratie</h3><p>Formule gebaseerd op de Europese en Noord-Amerikaanse traditie van lymfedrainage.</p></div>\n    </div>\n    <div class=\"sor-pp\">\n      <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2.5l2.2 1.6 2.7-.2.9 2.6 2.3 1.4-.9 2.6.9 2.6-2.3 1.4-.9 2.6-2.7-.2L12 18.5l-2.2-1.6-2.7.2-.9-2.6L3.9 13l.9-2.6-.9-2.6 2.3-1.4.9-2.6 2.7.2z\"/><path d=\"M9.5 11.5l1.8 1.8 3.4-3.6\"/></svg>\n      <div><h3>Externe analyses</h3><p>Elke batch wordt getest door onafhankelijke laboratoria om de zuiverheid te garanderen.</p></div>\n    </div>\n    <div class=\"sor-pp\">\n      <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M19 4C10 4 5 8.5 5 15v5M5 17c0-6 4.5-9 12-9.5\"/></svg>\n      <div><h3>Zuivere ingrediënten</h3><p>100% plantaardig, zonder alcohol, suiker, gluten of GMO. Veganistisch.</p></div>\n    </div>\n    <div class=\"sor-pp\">\n      <svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M12 2.5l7.5 3v6c0 4.5-3.2 8.4-7.5 10-4.3-1.6-7.5-5.5-7.5-10v-6z\"/></svg>\n      <div><h3>Gecertificeerde productie</h3><p>Geproduceerd in GMP-faciliteiten die voldoen aan de hoogste kwaliteitsnormen.</p></div>\n    </div>\n  </div>\n\n  <div class=\"sor-proof-stats\">\n    <h3 class=\"sor-stats-title\">Resultaten die je <em>voelt</em></h3>\n    <div class=\"sor-stat\">\n      <svg class=\"sor-ring\" viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"26\"/><circle cx=\"30\" cy=\"30\" r=\"26\" class=\"sor-ring-fill\" style=\"stroke-dashoffset:4.9\"/><text x=\"30\" y=\"34\">97%</text></svg>\n      <p>merkte 's ochtends een <strong>duidelijk minder opgezwollen gezicht</strong>.</p>\n    </div>\n    <div class=\"sor-stat\">\n      <svg class=\"sor-ring\" viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"26\"/><circle cx=\"30\" cy=\"30\" r=\"26\" class=\"sor-ring-fill\" style=\"stroke-dashoffset:26.1\"/><text x=\"30\" y=\"34\">84%</text></svg>\n      <p>zag <strong>minder zwelling in benen, enkels of voeten</strong> aan het einde van de dag.</p>\n    </div>\n    <div class=\"sor-stat\">\n      <svg class=\"sor-ring\" viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"26\"/><circle cx=\"30\" cy=\"30\" r=\"26\" class=\"sor-ring-fill\" style=\"stroke-dashoffset:27.8\"/><text x=\"30\" y=\"34\">83%</text></svg>\n      <p>voelt zich <strong>lichter, energieker en beter gehumeurd</strong> na 8 weken.</p>\n    </div>\n    <p class=\"sor-stats-source\">Interne enquête onder 490 vrijwillige klanten na 8 weken consistent gebruik.</p>\n  </div>\n\n  <div class=\"sor-proof-ba\">\n    <div class=\"sor-ba-text\">\n      <h3>Wanneer de doorstroming <em>stokt</em>, voel je het</h3>\n      <p>Je voelt een trage lymfestroom terug in je huid, je energie en je dagelijkse comfort. Zie het verschil tussen een geblokkeerd lichaam en een lichaam dat weer doorstroomt.</p>\n    </div>\n\n    <div class=\"sor-ba-slider\" id=\"sorBa\">\n      <img class=\"sor-ba-after\" src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_220100_8667a587-6a53-465e-bdd0-bc578cd76fc2_430x.png?v=1785612903\" alt=\"Na\" draggable=\"false\">\n      <div class=\"sor-ba-before-wrap\" id=\"sorBaClip\">\n        <img class=\"sor-ba-before\" src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/hf_20260503_215708_81c996c7-e7dd-45bc-a929-2b41fea0f567_430x.png?v=1785612903\" alt=\"Voor\" draggable=\"false\">\n      </div>\n      <span class=\"sor-ba-tag sor-ba-tag-l\">VOOR</span>\n      <span class=\"sor-ba-tag sor-ba-tag-r\">NA</span>\n      <div class=\"sor-ba-handle\" id=\"sorBaHandle\">\n        <span class=\"sor-ba-knob\">\n          <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"><path d=\"M10 8l-4 4 4 4M14 8l4 4-4 4\"/></svg>\n        </span>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function(){\n  var box = document.getElementById('sorBa');\n  if(!box) return;\n  var clip = document.getElementById('sorBaClip');\n  var handle = document.getElementById('sorBaHandle');\n  var dragging = false;\n\n  function setPos(clientX){\n    var r = box.getBoundingClientRect();\n    var pct = ((clientX - r.left) / r.width) * 100;\n    if(pct < 2) pct = 2;\n    if(pct > 98) pct = 98;\n    clip.style.width = pct + '%';\n    handle.style.left = pct + '%';\n  }\n\n  function start(e){ dragging = true; move(e); }\n  function stop(){ dragging = false; }\n  function move(e){\n    if(!dragging) return;\n    var x = e.touches ? e.touches[0].clientX : e.clientX;\n    setPos(x);\n  }\n\n  box.addEventListener('mousedown', start);\n  box.addEventListener('touchstart', start, {passive:true});\n  window.addEventListener('mousemove', move);\n  window.addEventListener('touchmove', move, {passive:true});\n  window.addEventListener('mouseup', stop);\n  window.addEventListener('touchend', stop);\n})();\n</script>\n\n<style>\n.sor-proof{font-family:inherit;max-width:100%;}\n\n.sor-proof-head{text-align:center;margin-bottom:24px;}\n.sor-proof-head h2{font-size:22px;font-weight:800;color:#1a1a1a;margin:0 0 8px;line-height:1.25;}\n.sor-proof-head h2 em{font-style:italic;}\n.sor-proof-head p{font-size:13.5px;color:#6b6b6b;margin:0;line-height:1.5;}\n\n.sor-proof-points{display:flex;flex-direction:column;gap:18px;margin-bottom:34px;}\n.sor-pp{display:flex;gap:12px;align-items:flex-start;}\n.sor-pp svg{color:#A08straight;color:#A0876B;flex-shrink:0;margin-top:2px;}\n.sor-pp h3{font-size:14.5px;font-weight:800;color:#1a1a1a;margin:0 0 4px;}\n.sor-pp p{font-size:13px;line-height:1.5;color:#5a5a5a;margin:0;}\n\n.sor-proof-stats{background:#F5F4F1;border-radius:16px;padding:22px 16px;margin-bottom:34px;}\n.sor-stats-title{font-size:18px;font-weight:800;color:#1a1a1a;margin:0 0 18px;text-align:center;}\n.sor-stats-title em{font-style:italic;}\n.sor-stat{display:flex;align-items:center;gap:14px;padding:14px 0;border-top:1px solid #E4E1DA;}\n.sor-stat:first-of-type{border-top:none;padding-top:0;}\n.sor-ring{width:56px;height:56px;flex-shrink:0;}\n.sor-ring circle{fill:none;stroke:#E4E1DA;stroke-width:4;}\n.sor-ring .sor-ring-fill{stroke:#A0876B;stroke-linecap:round;stroke-dasharray:163.36;transform:rotate(-90deg);transform-origin:50% 50%;}\n.sor-ring text{fill:#A0876B;font-size:15px;font-weight:800;text-anchor:middle;font-family:inherit;}\n.sor-stat p{font-size:13px;line-height:1.5;color:#3a3a3a;margin:0;}\n.sor-stat p strong{color:#1a1a1a;font-weight:700;}\n.sor-stats-source{font-size:11.5px;color:#8a8a8a;margin:14px 0 0;text-align:center;line-height:1.4;}\n\n.sor-proof-ba{display:flex;flex-direction:column;gap:20px;}\n.sor-ba-text h3{font-size:21px;font-weight:800;color:#1a1a1a;margin:0 0 10px;line-height:1.25;}\n.sor-ba-text h3 em{font-style:italic;}\n.sor-ba-text p{font-size:13.5px;line-height:1.55;color:#5a5a5a;margin:0;}\n\n.sor-ba-slider{\n  position:relative;\n  width:100%;\n  aspect-ratio:1/1;\n  border-radius:14px;\n  overflow:hidden;\n  user-select:none;\n  cursor:ew-resize;\n  touch-action:pan-y;\n}\n.sor-ba-slider img{\n  position:absolute;\n  top:0;left:0;\n  width:100%;height:100%;\n  object-fit:cover;\n  display:block;\n  pointer-events:none;\n}\n.sor-ba-before-wrap{\n  position:absolute;\n  top:0;left:0;\n  width:50%;\n  height:100%;\n  overflow:hidden;\n}\n.sor-ba-before-wrap img{width:auto;height:100%;min-width:none;}\n.sor-ba-slider .sor-ba-before{\n  width:100vw;\n  max-width:none;\n}\n.sor-ba-tag{\n  position:absolute;\n  top:10px;\n  background:rgba(160,135,107,0.92);\n  color:#fff;\n  font-size:10.5px;\n  font-weight:800;\n  letter-spacing:0.08em;\n  padding:5px 10px;\n  border-radius:4px;\n  z-index:3;\n}\n.sor-ba-tag-l{left:10px;}\n.sor-ba-tag-r{right:10px;}\n.sor-ba-handle{\n  position:absolute;\n  top:0;bottom:0;\n  left:50%;\n  width:2px;\n  background:#fff;\n  transform:translateX(-1px);\n  z-index:2;\n  pointer-events:none;\n}\n.sor-ba-knob{\n  position:absolute;\n  top:50%;left:50%;\n  transform:translate(-50%,-50%);\n  width:38px;height:38px;\n  border-radius:50%;\n  background:rgba(255,255,255,0.25);\n  border:2px solid #fff;\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  backdrop-filter:blur(2px);\n}\n\n@media (min-width:750px){\n  .sor-proof-head h2{font-size:32px;}\n  .sor-proof-head p{font-size:16px;}\n  .sor-proof-points{display:grid;grid-template-columns:1fr 1fr;gap:24px 32px;margin-bottom:48px;}\n  .sor-pp h3{font-size:17px;}\n  .sor-pp p{font-size:14.5px;}\n  .sor-proof-stats{padding:32px 28px;margin-bottom:48px;}\n  .sor-stats-title{font-size:24px;margin-bottom:22px;}\n  .sor-stat p{font-size:15px;}\n  .sor-ring{width:70px;height:70px;}\n  .sor-proof-ba{flex-direction:row;align-items:center;gap:48px;}\n  .sor-ba-text{width:45%;}\n  .sor-ba-text h3{font-size:30px;}\n  .sor-ba-text p{font-size:16px;}\n  .sor-ba-slider{width:55%;}\n}\n</style>",
