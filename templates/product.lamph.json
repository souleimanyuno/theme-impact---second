g>\n      <span>Natuurlijke afvoer — zonder agressief diureticum</span>\n    </li>\n    <li>\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" width=\"18\" height=\"18\"><circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M8 12.5l2.5 2.5L16 9.5\"/></svg>\n      <span>100% plantaardig · veganistisch · glutenvrij</span>\n    </li>\n    <li class=\"sor-shipping-item\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" width=\"18\" height=\"18\">\n        <rect x=\"1.5\" y=\"7\" width=\"11\" height=\"9\"/>\n        <path d=\"M12.5 10h4l3 3.2V16h-7z\"/>\n        <circle cx=\"6\" cy=\"18.5\" r=\"1.6\"/>\n        <circle cx=\"16.5\" cy=\"18.5\" r=\"1.6\"/>\n      </svg>\n      <span>Verwachte verzending: <strong>{{ start_day }} {{ start_month }} - {{ end_day }} {{ end_month }}</strong></span>\n    </li>\n  </ul>\n</div>\n\n<style>\n.sor-badge-benefits{font-family:inherit;max-width:100%;}\n\n.sor-badge{\n  display:inline-flex;\n  align-items:center;\n  gap:8px;\n  background:linear-gradient(100deg,#8B9A7A 0%,#6B4A35 100%);\n  border-radius:999px;\n  padding:9px 16px;\n  margin-bottom:16px;\n}\n.sor-badge-star{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  width:20px;\n  height:20px;\n  border-radius:50%;\n  background:rgba(255,255,255,0.25);\n  color:#fff;\n  flex-shrink:0;\n}\n.sor-badge-text{\n  color:#fff;\n  font-weight:700;\n  font-size:12.5px;\n  letter-spacing:0.01em;\n  line-height:1.2;\n}\n\n.sor-benefits-list{\n  list-style:none;\n  margin:0;\n  padding:0;\n  display:flex;\n  flex-direction:column;\n  gap:10px;\n}\n.sor-benefits-list li{\n  display:flex;\n  align-items:flex-start;\n  gap:9px;\n}\n.sor-benefits-list li svg{\n  color:#4A5D3A;\n  flex-shrink:0;\n  margin-top:1px;\n}\n.sor-benefits-list li span{\n  font-size:14px;\n  line-height:1.4;\n  color:#1a1a1a;\n}\n.sor-shipping-item svg{\n  color:#6B4A35;\n}\n.sor-shipping-item span strong{\n  color:#2B1E