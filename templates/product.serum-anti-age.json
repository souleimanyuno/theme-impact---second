    "sor_b10": {
      "type": "custom-liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": false,
        "liquid": "{%- comment -%}\n  SORELYA — BLOC 10 : « Every ingredient has a specific role » — carrousel de 8 cartes ingrédients à retourner\n  Clone EXACT du bloc BioChroma (titre rich text + custom_liquid ingredient-carousel) :\n  face avant = image + nom + accroche + bouton « + » ; face arrière = explication + bouton « × ».\n  Même ordre que BioChroma : Silk Peptides · Collagen · Volufiline · Acetyl Hexapeptide-8 ·\n  Double Hyaluronic Acid · Copper Tripeptide-1 · Centella Asiatica · Colloidal Gold.\n  Copy = traduction fidèle de BioChroma (y compris « jusqu'à 49 % en 4 semaines »).\n  Mobile-first : swipe + barre de progression + flèches ; au-delà de 1024 px, les cartes s'alignent sans flèches.\n  Images servies SANS le suffixe _430x + srcset.\n{%- endcomment -%}\n\n{%- assign sor_titre = \"Cada ingrediente tiene una función concreta\" -%}\n\n{%- assign sor_base = \"https://cdn.shopify.com/s/files/1/0889/4106/8645/files/\" -%}\n{%- assign sor_imgs = \"Progetto_senza_titolo_1_7c39f2e2-ca4f-4645-98ea-aa77d5d2e858.jpg?v=1790297924|Progetto_senza_titolo_2_d4e74a96-bc59-4238-b338-2efdcde04bc2.jpg?v=1790297924|Progetto_senza_titolo_3_8a0d6e0d-03ed-4c3c-bdda-17677982e83d.jpg?v=1790297924|4_896043bd-15f5-4bc1-8a51-d1989324c24b.jpg?v=1790297924|5_79a441f2-bf9a-45c2-927c-8baa287175ef.jpg?v=1790297924|6_2689aa73-bdf6-47f3-8d82-eac128a49df3.jpg?v=1790297924|7_17b6e874-a7af-4a34-91fd-ed95d074e867.jpg?v=1790297924|8_80da8417-e0d9-4156-ac94-52738e7e76d8.jpg?v=1790297924\" | split: \"|\" -%}\n\n{%- assign sor_noms = \"Péptidos de Seda|Colágeno de Bajo Peso Molecular|Volufiline|Acetil Hexapéptido-8|Doble Ácido Hialurónico|Tripéptido de Cobre-1|Centella Asiática|Oro Coloidal\" | split: \"|\" -%}\n\n{%- assign sor_accroches = \"La red que alisa desde dentro|Firmeza e hidratación|Rellena donde el tiempo ha hundido|Efecto alisador. Sin agujas.|Hidratación inmediata y duradera|Despierta las células que producen colágeno|Calma, refuerza, protege|Potencia todo lo demás\" | split: \"|\" -%}\n\n{%- assign sor_details = \"Se entrelazan en las capas profundas de la piel y forman una red tridimensional que levanta y alisa justo donde el colágeno se ha debilitado.|Penetra en profundidad en lugar de quedarse en la superficie. Alisa, reafirma y mantiene la piel suave y uniforme con el tiempo.|Aumenta visiblemente el volumen en las zonas que tienden a hundirse: pómulos, ojeras, surcos nasogenianos.|Relaja los músculos responsables de las líneas de expresión. Reducción visible de hasta un 49 % en 4 semanas.|Dos pesos moleculares: uno actúa en la superficie para un efecto relleno inmediato y el otro penetra en profundidad para una hidratación duradera.|Reactiva los fibroblastos ralentizados por la edad y estimula la producción natural de colágeno y elastina.|Refuerza la barrera cutánea, reduce las rojeces y estimula el colágeno. Apta también para las pieles más sensibles.|Aumenta la absorción de los demás activos en profundidad y aporta una luminosidad inmediata.\" | split: \"|\" -%}\n\n<section class=\"sor-b10\" data-sor-b10>\n  <h2 class=\"sor-b10__titre\">{{ sor_titre }}</h2>\n\n  <div class=\"sor-b10__wrap\">\n    <ul class=\"sor-b10__track\" role=\"list\">\n      {%- for nom in sor_noms -%}\n        {%- assign i = forloop.index0 -%}\n        {%- assign img = sor_base | append: sor_imgs[i] -%}\n        <li class=\"sor-b10__card\">\n          <div class=\"sor-b10__inner\">\n            <div class=\"sor-b10__front\">\n              <img src=\"{{ img }}&width=600\"\n                   srcset=\"{{ img }}&width=300 300w, {{ img }}&width=600 600w, {{ img }}&width=800 800w\"\n                   sizes=\"(min-width: 1024px) 300px, 250px\"\n                   alt=\"{{ nom }}\" width=\"600\" height=\"600\" loading=\"lazy\" decoding=\"async\">\n              <div class=\"sor-b10__info\">\n                <h3>{{ nom }}</h3>\n                <p>{{ sor_accroches[i] }}</p>\n              </div>\n              <button type=\"button\" class=\"sor-b10__btn\" data-flip aria-label=\"Más información sobre {{ nom }}\">+</button>\n            </div>\n            <div class=\"sor-b10__back\" aria-hidden=\"true\">\n              <h3>{{ nom }}</h3>\n              <p>{{ sor_details[i] }}</p>\n              <button type=\"button\" class=\"sor-b10__btn\" data-flip aria-label=\"Cerrar\" tabindex=\"-1\">&times;</button>\n            </div>\n          </div>\n        </li>\n      {%- endfor -%}\n    </ul>\n\n    <div class=\"sor-b10__ctrl\">\n      <button type=\"button\" class=\"sor-b10__arrow\" data-dir=\"-1\" aria-label=\"Ingredientes anteriores\">&#8592;</button>\n      <div class=\"sor-b10__line\"><span class=\"sor-b10__progress\"></span></div>\n      <button type=\"button\" class=\"sor-b10__arrow\" data-dir=\"1\" aria-label=\"Ingredientes siguientes\">&#8594;</button>\n    </div>\n  </div>\n</section>\n\n<script>\n  (function(){\n    function init(root){\n      if (root.dataset.sorInit) return;\n      root.dataset.sorInit = '1';\n      var track = root.querySelector('.sor-b10__track');\n      var bar = root.querySelector('.sor-b10__progress');\n\n      root.querySelectorAll('[data-flip]').forEach(function(btn){\n        btn.addEventListener('click', function(){\n          var card = btn.closest('.sor-b10__card');\n          var on = card.classList.toggle('is-flipped');\n          card.querySelector('.sor-b10__front').setAttribute('aria-hidden', on ? 'true' : 'false');\n          card.querySelector('.sor-b10__back').setAttribute('aria-hidden', on ? 'false' : 'true');\n          card.querySelector('.sor-b10__front .sor-b10__btn').tabIndex = on ? -1 : 0;\n          card.querySelector('.sor-b10__back .sor-b10__btn').tabIndex = on ? 0 : -1;\n        });\n      });\n\n      root.querySelectorAll('.sor-b10__arrow').forEach(function(a){\n        a.addEventListener('click', function(){\n          var c = track.querySelector('.sor-b10__card');\n          var step = c ? c.getBoundingClientRect().width + 16 : 260;\n          track.scrollBy({ left: step * parseInt(a.dataset.dir, 10), behavior: 'smooth' });\n        });\n      });\n\n      function sync(){\n        var max = track.scrollWidth - track.clientWidth;\n        var p = max > 0 ? (track.scrollLeft / max) * 100 : 100;\n        bar.style.width = Math.max(8, p) + '%';\n      }\n      track.addEventListener('scroll', sync, { passive: true });\n      window.addEventListener('resize', sync);\n      sync();\n    }\n    function initAll(scope){ (scope || document).querySelectorAll('[data-sor-b10]').forEach(init); }\n    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ initAll(); });\n    else initAll();\n    document.addEventListener('shopify:section:load', function(e){ initAll(e.target); });\n  })();\n</script>\n\n<style>\n  .sor-b10{\n    padding-top:var(--sor-espace-sections, 44px) !important;\n    --sor-ink:#2B2220;\n    --sor-gris:#666;\n    --sor-rose:#D9A79D;\n    padding:2px 0 6px;\n  }\n  .sor-b10__titre{\n    margin:0 0 14px;\n    text-align:center;\n    font-family:var(--font-heading-family, inherit);\n    font-style:var(--font-heading-style, normal);\n    font-weight:var(--font-heading-weight, 700);\n    font-size:29px;\n    line-height:1.25;\n    color:var(--sor-ink);\n  }\n\n  .sor-b10__track{\n    list-style:none;\n    margin:0;\n    padding:4px 2px 16px;\n    display:flex;\n    gap:16px;\n    overflow-x:auto;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n    overscroll-behavior-x:contain;\n  }\n  .sor-b10__track::-webkit-scrollbar{ display:none; }\n\n  .sor-b10__card{\n    flex:0 0 250px;\n    height:350px;\n    scroll-snap-align:start;\n    perspective:1200px;\n  }\n  .sor-b10__inner{\n    position:relative;\n    width:100%;\n    height:100%;\n    transform-style:preserve-3d;\n    transition:transform .7s ease;\n  }\n  .sor-b10__card.is-flipped .sor-b10__inner{ transform:rotateY(180deg); }\n\n  .sor-b10__front,\n  .sor-b10__back{\n    position:absolute;\n    inset:0;\n    border-radius:18px;\n    overflow:hidden;\n    -webkit-backface-visibility:hidden;\n    backface-visibility:hidden;\n    box-shadow:0 6px 16px rgba(0,0,0,.06);\n  }\n  .sor-b10__front{ display:flex; flex-direction:column; background:#fff; }\n  .sor-b10__front img{ display:block; width:100%; height:68%; object-fit:cover; }\n  .sor-b10__info{\n    flex:1;\n    padding:14px 16px;\n    border-top:1px solid #eee;\n    background:#fff;\n  }\n  .sor-b10__info h3,\n  .sor-b10__back h3{\n    margin:0 0 6px;\n    font-family:var(--font-heading-family, inherit);\n    font-weight:var(--font-heading-weight, 700);\n    font-size:17px;\n    line-height:1.25;\n    color:var(--sor-ink);\n  }\n  .sor-b10__info p{ margin:0; font-size:14.5px; line-height:1.35; color:var(--sor-gris); }\n\n  .sor-b10__back{\n    transform:rotateY(180deg);\n    background:#FAFAFA;\n    padding:26px 22px;\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    text-align:center;\n  }\n  .sor-b10__back p{ margin:0; font-size:15px; line-height:1.6; color:#333; }\n\n  .sor-b10__btn{\n    position:absolute;\n    top:12px;\n    right:14px;\n    width:34px;\n    height:34px;\n    border:0;\n    border-radius:50%;\n    background:var(--sor-rose);\n    color:#fff;\n    font-size:20px;\n    line-height:1;\n    cursor:pointer;\n    display:grid;\n    place-items:center;\n    padding:0;\n    box-shadow:0 3px 8px rgba(0,0,0,.12);\n  }\n  .sor-b10__btn:focus-visible{ outline:2px solid var(--sor-ink); outline-offset:2px; }\n\n  .sor-b10__ctrl{\n    display:flex;\n    align-items:center;\n    gap:14px;\n    padding:0 4px;\n  }\n  .sor-b10__line{\n    flex:1;\n    height:3px;\n    border-radius:3px;\n    background:#E4DDDA;\n    overflow:hidden;\n  }\n  .sor-b10__progress{ display:block; height:100%; width:8%; background:var(--sor-rose); transition:width .15s linear; }\n  .sor-b10__arrow{\n    flex:0 0 44px;\n    width:44px;\n    height:44px;\n    border:0;\n    border-radius:50%;\n    background:var(--sor-rose);\n    color:#fff;\n    font-size:20px;\n    line-height:1;\n    cursor:pointer;\n    display:grid;\n    place-items:center;\n    padding:0;\n  }\n\n  @media (prefers-reduced-motion:reduce){\n    .sor-b10__inner{ transition:none; }\n  }\n  @media (min-width:750px){\n    .sor-b10__titre{ font-size:37px; margin-bottom:20px; }\n  }\n  @media (min-width:1024px){\n    .sor-b10__track{ flex-wrap:wrap; justify-content:center; overflow:visible; scroll-snap-type:none; gap:20px; }\n    .sor-b10__card{ flex:0 0 300px; height:420px; }\n    .sor-b10__ctrl{ display:none; }\n  }\n</style>",
        "background": "",
