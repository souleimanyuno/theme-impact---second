wBox=\"0 0 24 24\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n        <circle cx=\"12\" cy=\"12\" r=\"10\"/>\n        <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"8.5\" stroke-width=\"2.5\"/>\n        <line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"16\"/>\n      </svg>\n      <span><strong>Pro Tip:</strong> If your pup is between sizes, we recommend sizing up for maximum comfort and coverage.</span>\n    </div>\n  </div>\n</div>\n\n<script>\n(function () {\n  var DURATION = 5 * 60 * 1000;\n  var KEY = 'cn_chillnest_deadline';\n  var timerInterval = null;\n\n  function pad(n) { return n < 10 ? '0' + n : String(n); }\n\n  function readDeadline() {\n    var now = Date.now();\n    var stored;\n    try { stored = window.localStorage.getItem(KEY); } catch (e) { stored = null; }\n\n    if (stored) {\n      var parsed = parseInt(stored, 10);\n      if (!isNaN(parsed) && parsed > now) return parsed;\n    }\n\n    var fresh = now + DURATION;\n    try { window.localStorage.setItem(KEY, String(fresh)); } catch (e) {}\n    return fresh;\n  }\n\n  function initTimer() {\n    var minsEl = document.querySelector('[data-cn-mins]');\n    var secsEl = document.querySelector('[data-cn-secs]');\n    if (!minsEl || !secsEl) return false;\n\n    if (timerInterval) clearInterval(timerInterval);\n\n    var deadline = readDeadline();\n\n    function render() {\n      var remaining = deadline - Date.now();\n\n      if (remaining <= 0) {\n        deadline = Date.now() + DURATION;\n        try { window.localStorage.setItem(KEY, String(deadline)); } catch (e) {}\n        remaining = DURATION;\n      }\n\n      var totalSec = Math.floor(remaining / 1000);\n      minsEl.textContent = pad(Math.floor(totalSec / 60));\n      secsEl.textContent = pad(totalSec % 60);\n    }\n\n    render();\n    timerInterval = setInterval(render, 1000);\n    return true;\n  }\n\n  function initModal() {\n    var openBtn = document.querySelector('[data-cn-sg-open]');\n    var overlay = document.querySelector('[data-cn-sg-overlay]');\n    var closeBtn = document.querySelector('[data-cn-sg-close]');\n    if (!openBtn || !overlay || !closeBtn) return false;\n\n    if (openBtn.dataset.cnBound === '1') return true;\n    openBtn.dataset.cnBound = '1';\n\n    openBtn.addEventListener('click', function (e) {\n      e.preventDefault();\n      overlay.classList.add('active');\n      document.body.style.overflow = 'hidden';\n    });\n\n    closeBtn.addEventListener('click', function (e) {\n      e.preventDefault();\n      overlay.classList.remove('active');\n      document.body.style.overflow = '';\n    });\n\n    overlay.addEventListener('click', function (e) {\n      if (e.target === overlay) {\n        overlay.classList.remove('active');\n        document.body.style.overflow = '';\n      }\n    });\n\n    return true;\n  }\n\n  function init() {\n    initTimer();\n    initModal();\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n\n  document.addEventListener('shopify:section:load', init);\n})();\n</script>"
