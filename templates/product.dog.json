    "custom_liquid_kg3DGR": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{% comment %}\n  BLOQUE 8 — Confianza + Preguntas Frecuentes (Sorelya · D-tox)\n  Las respuestas del FAQ están redactadas según las specs del producto (300mg ACV con\n  \"La Madre\", vitamina C, pectina, 2 gominolas/día, 25 porciones por bolsa). Revísalas\n  y ajústalas si tu formulación real difiere.\n  Usa <details>/<summary>: funciona sin JavaScript.\n{% endcomment %}\n{% assign srl_cta_url = \"#comprar\" %}\n\n<div class=\"srl-faq\">\n  <style>\n    .srl-faq {\n      --srl-green: #5aa062;\n      --srl-green-dark: #37533b;\n      --srl-deep: #2f5344;\n      --srl-ink: #1a1a1a;\n      --srl-muted: #4a4a45;\n      font-family: inherit;\n      background: var(--srl-green);\n      padding: 52px 20px 60px;\n      box-sizing: border-box;\n    }\n    .srl-faq *, .srl-faq *::before, .srl-faq *::after { box-sizing: border-box; }\n    .srl-faq__inner { max-width: 680px; margin: 0 auto; }\n\n    .srl-faq__secure {\n      display: flex; align-items: center; justify-content: center;\n      gap: 10px; color: #fff; font-size: 17px; margin: 0 0 44px;\n    }\n    .srl-faq__secure svg { flex: none; }\n\n    .srl-faq__badges {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 34px 20px;\n      margin: 0 0 56px;\n    }\n    .srl-faq__badge { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }\n    .srl-faq__icon {\n      width: 78px; height: 78px; border-radius: 50%;\n      background: #fff;\n      display: flex; align-items: center; justify-content: center;\n    }\n    .srl-faq__badge span { color: #fff; font-size: 17px; font-weight: 700; line-height: 1.35; }\n\n    .srl-faq__title {\n      font-size: 36px; font-weight: 800; line-height: 1.15;\n      color: #fff; text-align: center; margin: 0 0 28px;\n    }\n\n    .srl-faq__item {\n      background: #fff;\n      border-radius: 12px;\n      margin-bottom: 14px;\n      overflow: hidden;\n    }\n    .srl-faq__q {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 22px 22px;\n      font-size: 18px;\n      font-weight: 700;\n      line-height: 1.35;\n      color: var(--srl-ink);\n      cursor: pointer;\n      list-style: none;\n    }\n    .srl-faq__q::-webkit-details-marker { display: none; }\n    .srl-faq__chev {\n      flex: none;\n      transition: transform .25s ease;\n      color: var(--srl-ink);\n    }\n    .srl-faq__item[open] .srl-faq__chev { transform: rotate(90deg); }\n    .srl-faq__a {\n      padding: 0 22px 24px;\n      font-size: 16px;\n      line-height: 1.65;\n      color: var(--srl-muted);\n    }\n    .srl-faq__a p { margin: 0 0 12px; }\n    .srl-faq__a p:last-child { margin-bottom: 0; }\n\n    .srl-faq__cta-wrap { text-align: center; margin-top: 40px; }\n    .srl-faq__cta {\n      display: block; width: 100%;\n      background: var(--srl-green-dark);\n      color: #fff; font-size: 17px; font-weight: 800; letter-spacing: .03em;\n      text-decoration: none; padding: 22px 24px; border-radius: 999px;\n      box-shadow: 0 4px 0 rgba(0,0,0,.18);\n      transition: transform .12s ease, box-shadow .12s ease;\n    }\n    .srl-faq__cta:hover { transform: translateY(2px); box-shadow: 0 2px 0 rgba(0,0,0,.18); }\n    .srl-faq__guarantee {\n      display: flex; align-items: center; justify-content: center;\n      gap: 8px; font-size: 15px; color: rgba(255,255,255,.92); margin-top: 16px;\n    }\n    .srl-faq__guarantee svg { flex: none; }\n\n    @media (max-width: 600px) {\n      .srl-faq { padding: 42px 16px 50px; }\n      .srl-faq__secure { font-size: 15px; margin-bottom: 36px; }\n      .srl-faq__icon { width: 68px; height: 68px; }\n      .srl-faq__badge span { font-size: 16px; }\n      .srl-faq__title { font-size: 30px; }\n      .srl-faq__q { font-size: 16px; padding: 20px 18px; }\n      .srl-faq__a { font-size: 15px; padding: 0 18px 22px; }\n      .srl-faq__cta { font-size: 15px; padding: 20px 18px; }\n    }\n  </style>\n\n  <div class=\"srl-faq__inner\">\n\n    <p class=\"srl-faq__secure\">\n      <svg width=\"18\" height=\"20\" viewBox=\"0 0 18 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n        <path d=\"M9 1L1 4v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V4L9 1z\" fill=\"#fff\"/>\n      </svg>\n      Pago 100% seguro &middot; Envío garantizado\n    </p>\n\n    <div class=\"srl-faq__badges\">\n      <div class=\"srl-faq__badge\">\n        <span class=\"srl-faq__icon\">\n          <svg width=\"34\" height=\"38\" viewBox=\"0 0 18 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <path d=\"M9 1L1 4v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V4L9 1z\" fill=\"#2f5344\"/>\n          </svg>\n        </span>\n        <span>30 días de<br>Garantía</span>\n      </div>\n\n      <div class=\"srl-faq__badge\">\n        <span class=\"srl-faq__icon\">\n          <svg width=\"32\" height=\"36\" viewBox=\"0 0 32 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <rect x=\"4\" y=\"2\" width=\"24\" height=\"32\" rx=\"4\" fill=\"#2f5344\"/>\n          </svg>\n        </span>\n        <span>Certificado<br>por Laboratorio</span>\n      </div>\n\n      <div class=\"srl-faq__badge\">\n        <span class=\"srl-faq__icon\">\n          <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <path d=\"M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5L21 16z\" fill=\"#2f5344\"/>\n          </svg>\n        </span>\n        <span>Envío Rápido<br>y Garantizado</span>\n      </div>\n\n      <div class=\"srl-faq__badge\">\n        <span class=\"srl-faq__icon\">\n          <svg width=\"36\" height=\"36\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n            <circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"#2f5344\"/>\n            <rect x=\"11\" y=\"10\" width=\"2\" height=\"7\" rx=\"1\" fill=\"#fff\"/>\n            <circle cx=\"12\" cy=\"7.5\" r=\"1.3\" fill=\"#fff\"/>\n          </svg>\n        </span>\n        <span>Soporte<br>Personalizado</span>\n      </div>\n    </div>\n\n    <h2 class=\"srl-faq__title\">Preguntas Frecuentes</h2>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Qué ingredientes contiene?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>Solo tres ingredientes activos, en las dosis que tu intestino realmente necesita: <b>300mg de vinagre de manzana con \"La Madre\"</b> (probióticos naturales), <b>vitamina C</b> (ácido L-ascórbico de alta absorción) y <b>pectina</b> (fibra de fruta natural).</p>\n        <p>Sin aditivos artificiales, sin gluten, no-GMO y sin rellenos innecesarios.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Es seguro tomarlas con medicamentos?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>D-tox es un complemento alimenticio a base de ingredientes naturales. Aun así, si estás tomando medicación, estás embarazada o en período de lactancia, consulta con tu médico o farmacéutico antes de empezar.</p>\n        <p>Un complemento alimenticio no sustituye una dieta variada y equilibrada ni un estilo de vida saludable.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Cómo debo almacenar D-tox?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>En un lugar fresco y seco, entre 15 ºC y 25 ºC, lejos de la luz directa del sol. Cierra bien la bolsa después de cada uso.</p>\n        <p>En los días de mucho calor, puedes guardarlas en la nevera para que mantengan su textura.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Por qué funciona D-tox?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>Porque no ataca el síntoma, ataca la raíz. El vinagre de manzana con \"La Madre\" aporta las bacterias buenas, la pectina es la fibra prebiótica que las alimenta para que sobrevivan, y la vitamina C ayuda a tu cuerpo a absorber mejor lo que comes.</p>\n        <p>Los tres juntos hacen lo que ninguno hace por separado: devolverle a tu intestino lo que necesita para volver a funcionar.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Cuándo veré resultados?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>En los primeros días: menos hambre y menos antojos, con menos hinchazón después de comer. En 2-3 semanas: digestión más regular y vientre más plano. Al mes: más energía y menos fatiga.</p>\n        <p>Cada cuerpo es distinto, pero la constancia es lo que marca la diferencia.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Cómo las tomo?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>Simplemente toma <b>dos gominolas al día</b>. Para mejores resultados, tómalas por la mañana antes del desayuno o 30 minutos antes de tu comida principal.</p>\n        <p>No hay que mezclar nada, ni medir dosis, ni cambiar tu rutina.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Cuántas porciones contiene cada recipiente?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>Cada bolsa contiene <b>50 gominolas = 25 porciones</b>, es decir 25 días de suministro tomando 2 al día.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Es seguro para mí?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>D-tox se fabrica en un laboratorio certificado con pruebas de terceros en cada lote, con ingredientes de alta pureza. Sin gluten, no-GMO y sin aditivos artificiales.</p>\n        <p>Si tienes alguna condición médica, estás embarazada o en lactancia, o tomas medicación, consulta con tu médico antes de empezar.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Cuál es su garantía?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>Garantía de satisfacción de <b>30 días</b>. Si no estás completamente satisfecha con tu compra, te devolvemos tu dinero. Sin preguntas.</p>\n      </div>\n    </details>\n\n    <details class=\"srl-faq__item\">\n      <summary class=\"srl-faq__q\">¿Qué pasa si no estoy satisfecha?\n        <svg class=\"srl-faq__chev\" width=\"12\" height=\"18\" viewBox=\"0 0 12 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M2 2l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </summary>\n      <div class=\"srl-faq__a\">\n        <p>Escríbenos y te devolvemos el importe íntegro dentro de los 30 días. Sin papeleos y sin justificaciones.</p>\n        <p>El riesgo lo asumimos nosotros, no tú.</p>\n      </div>\n    </details>\n\n    <div class=\"srl-faq__cta-wrap\">\n      <a href=\"{{ srl_cta_url }}\" class=\"srl-faq__cta\">COMPRAR AHORA Y AHORRAR</a>\n      <div class=\"srl-faq__guarantee\">\n        <svg width=\"18\" height=\"20\" viewBox=\"0 0 18 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\">\n          <path d=\"M9 1L1 4v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V4L9 1z\" fill=\"#fff\"/>\n        </svg>\n        <span>Garantía de devolución de 30 días</span>\n      </div>\n    </div>\n\n  </div>\n</div>",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
    "custom_liquid_zTwWzz": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "<div class=\"sor-faq\">\n  <div class=\"sor-faq-head\">\n    <h2>Veelgestelde <em>vragen</em></h2>\n    <p>Alles wat je wilt weten voordat je begint.</p>\n  </div>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Wat doet Sorelya precies?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>Sorelya ondersteunt de natuurlijke lymfestroom van je lichaam. Het helpt zwelling en het vasthouden van vocht te verminderen en ondersteunt een zachte dagelijkse balans.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Wanneer zie ik resultaat?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>De meeste vrouwen merken binnen 7 tot 14 dagen een lichter gevoel en minder zwelling. Voor het beste resultaat gebruik je de druppels minimaal 4 weken consequent.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Hoe neem ik het in?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>1 tot 2 pipetten (1-2 ml), één of twee keer per dag. Onder je tong of verdund in water, thee of sap. Regelmatig gebruik en voldoende drinken zijn de sleutel.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Moet ik hierdoor de hele dag naar het toilet, zoals bij een diureticum?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>Nee. Sorelya is geen stimulerend middel en geen diureticum. Het werkt zacht mee met je lichaam, zonder je nieren te belasten of een uitgedroogd gevoel te geven.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Werkt het tijdens de overgang?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>Juist dan. Rode klaver is rijk aan isoflavonen en helpt de hormonale schommelingen op te vangen die het vasthouden van vocht versterken.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Is het veilig tijdens zwangerschap of borstvoeding?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>In deze gevoelige periodes raden we gebruik af zonder eerst je arts of verloskundige te raadplegen.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>Waar wordt het gemaakt?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>Sorelya wordt geformuleerd en gebotteld in gecertificeerde faciliteiten die voldoen aan strenge kwaliteits- en veiligheidsnormen.</p></div>\n  </details>\n\n  <details class=\"sor-faq-item\">\n    <summary><span>En als het niet werkt voor mij?</span><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 9l6 6 6-6\"/></svg></summary>\n    <div class=\"sor-faq-body\"><p>Je bent volledig beschermd door onze 60 dagen niet-goed-geld-terug-garantie. Voel je je niet lichter of meer in balans, dan krijg je je geld terug — zonder vragen.</p></div>\n  </details>\n\n  <div class=\"sor-faq-contact\">\n    <p>Nog een andere vraag? Mail ons op <a href=\"mailto:contact@sorelya.com\">contact@sorelya.com</a> — we antwoorden meestal binnen 24 uur.</p>\n  </div>\n</div>\n\n<style>\n.sor-faq{font-family:inherit;max-width:100%;}\n\n.sor-faq-head{text-align:center;margin-bottom:24px;}\n.sor-faq-head h2{\n  font-size:22px;\n  font-weight:800;\n  color:#1a1a1a;\n  line-height:1.25;\n  margin:0 0 8px;\n}\n.sor-faq-head h2 em{font-style:italic;color:#1F5138;}\n.sor-faq-head p{\n  font-size:13.5px;\n  color:#6b6b6b;\n  margin:0;\n}\n\n.sor-faq-item{\n  border-bottom:1px solid #E4E1DA;\n}\n.sor-faq-item:first-of-type{border-top:1px solid #E4E1DA;}\n.sor-faq-item summary{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:14px;\n  padding:16px 2px;\n  cursor:pointer;\n  list-style:none;\n}\n.sor-faq-item summary::-webkit-details-marker{display:none;}\n.sor-faq-item summary span{\n  font-size:14.5px;\n  font-weight:700;\n  color:#1a1a1a;\n  line-height:1.35;\n}\n.sor-faq-item summary svg{\n  flex-shrink:0;\n  color:#1F5138;\n  transition:transform .2s ease;\n}\n.sor-faq-item[open] summary svg{transform:rotate(180deg);}\n.sor-faq-item[open] summary span{color:#1F5138;}\n\n.sor-faq-body{padding:0 2px 18px;}\n.sor-faq-body p{\n  font-size:13.5px;\n  line-height:1.6;\n  color:#4a4a4a;\n  margin:0;\n}\n\n.sor-faq-contact{\n  margin-top:22px;\n  background:#F7F6F3;\n  border-radius:12px;\n  padding:16px;\n  text-align:center;\n}\n.sor-faq-contact p{\n  font-size:13px;\n  line-height:1.5;\n  color:#4a4a4a;\n  margin:0;\n}\n.sor-faq-contact a{\n  color:#1F5138;\n  font-weight:700;\n  text-decoration:underline;\n}\n\n@media (min-width:750px){\n  .sor-faq-head{margin-bottom:36px;}\n  .sor-faq-head h2{font-size:32px;}\n  .sor-faq-head p{font-size:16px;}\n  .sor-faq-item summary{padding:20px 4px;}\n  .sor-faq-item summary span{font-size:17px;}\n  .sor-faq-body{padding:0 4px 22px;}\n  .sor-faq-body p{font-size:15.5px;max-width:85%;}\n  .sor-faq-contact{padding:20px;}\n  .sor-faq-contact p{font-size:15px;}\n}\n</style>",
