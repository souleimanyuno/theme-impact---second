            "liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n\n  /* ── GUARANTEE BAR ── */\n  .cnacc-trust {\n    font-family: 'Inter', sans-serif;\n    text-align: center;\n    padding: 16px 0 10px;\n  }\n\n  .cnacc-trust__text {\n    font-size: 11px;\n    font-weight: 700;\n    color: #111;\n    margin-bottom: 12px;\n    letter-spacing: -0.01em;\n  }\n\n  .cnacc-trust__text span {\n    display: inline-block;\n    margin: 0 6px;\n    color: #bbb;\n    font-weight: 400;\n  }\n\n  .cnacc-trust__payments img {\n    width: 80%;\n    max-width: 420px;\n    height: auto;\n    display: block;\n    margin: 0 auto;\n  }\n\n  /* ── ACCORDION ── */\n  .cnacc {\n    font-family: 'Inter', sans-serif;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    padding: 16px 0;\n    width: 100%;\n  }\n\n  .cnacc__item {\n    border: 1.5px solid #e2e2e2;\n    border-radius: 16px;\n    background: #fff;\n    overflow: hidden;\n    transition: border-color 0.25s;\n  }\n  .cnacc__item.open {\n    border-color: #1a5cff;\n  }\n\n  .cnacc__trigger {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 16px;\n    background: none;\n    border: none;\n    cursor: pointer;\n    text-align: left;\n  }\n\n  .cnacc__badge {\n    width: 40px;\n    height: 40px;\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .cnacc__badge svg { width: 20px; height: 20px; }\n  .cnacc__badge--blue   { background: #eef1ff; }\n  .cnacc__badge--blue   svg { stroke: #1a5cff; fill: none; }\n  .cnacc__badge--green  { background: #eaf6f0; }\n  .cnacc__badge--green  svg { stroke: #1a7a3f; fill: none; }\n  .cnacc__badge--purple { background: #f0eaff; }\n  .cnacc__badge--purple svg { stroke: #6b3fcb; fill: none; }\n  .cnacc__badge--orange { background: #fff2ea; }\n  .cnacc__badge--orange svg { stroke: #d95f1a; fill: none; }\n\n  .cnacc__label {\n    flex: 1;\n    font-size: 15px;\n    font-weight: 700;\n    color: #111;\n    letter-spacing: -0.01em;\n  }\n\n  .cnacc__chev {\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n    stroke: #aaa;\n    fill: none;\n    transition: transform 0.3s, stroke 0.2s;\n  }\n  .cnacc__item.open .cnacc__chev {\n    transform: rotate(180deg);\n    stroke: #1a5cff;\n  }\n\n  .cnacc__body {\n    display: none;\n    padding: 2px 16px 18px 16px;\n  }\n  .cnacc__item.open .cnacc__body { display: block; }\n\n  /* DETAILS */\n  .cnacc__desc {\n    font-size: 13.5px;\n    color: #444;\n    line-height: 1.65;\n    margin-bottom: 18px;\n  }\n\n  .cnacc__feat-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    text-align: center;\n    gap: 4px;\n  }\n  .cnacc__feat-cell {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 5px;\n  }\n  .cnacc__feat-cell svg {\n    width: 24px;\n    height: 24px;\n    stroke: #1a5cff;\n    fill: none;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n  .cnacc__feat-cell span {\n    font-size: 11.5px;\n    font-weight: 700;\n    color: #111;\n  }\n\n  /* MATERIALS */\n  .cnacc__layers {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 8px;\n    margin-bottom: 14px;\n  }\n  .cnacc__layer {\n    border: 1.5px solid #e2e2e2;\n    border-radius: 12px;\n    padding: 12px 8px 10px;\n    text-align: center;\n  }\n  .cnacc__layer-num {\n    width: 26px;\n    height: 26px;\n    background: #111;\n    color: #fff;\n    border-radius: 50%;\n    font-size: 12px;\n    font-weight: 800;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin: 0 auto 8px;\n  }\n  .cnacc__layer-name {\n    font-size: 12px;\n    font-weight: 700;\n    color: #111;\n    margin-bottom: 3px;\n  }\n  .cnacc__layer-sub {\n    font-size: 11.5px;\n    color: #666;\n    line-height: 1.4;\n  }\n\n  .cnacc__pills {\n    display: flex;\n    gap: 7px;\n    flex-wrap: wrap;\n    margin-bottom: 12px;\n  }\n  .cnacc__pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    background: #eaf6f0;\n    color: #1a7a3f;\n    font-size: 11px;\n    font-weight: 700;\n    padding: 5px 11px;\n    border-radius: 999px;\n  }\n  .cnacc__pill svg {\n    width: 13px;\n    height: 13px;\n    stroke: #1a7a3f;\n    fill: none;\n    stroke-width: 2.2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .cnacc__care {\n    font-size: 13px;\n    color: #555;\n    line-height: 1.5;\n  }\n\n  /* SIZING */\n  .cnacc__size-section + .cnacc__size-section { margin-top: 20px; }\n  .cnacc__size-heading {\n    font-size: 11.5px;\n    font-weight: 900;\n    color: #111;\n    text-transform: uppercase;\n    letter-spacing: 0.07em;\n    margin-bottom: 12px;\n  }\n\n  .cnacc__size-grid-4 {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 7px;\n    margin-bottom: 6px;\n  }\n  .cnacc__size-grid-3 {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 7px;\n    margin-bottom: 6px;\n  }\n\n  .cnacc__size-card {\n    border: 1.5px solid #e2e2e2;\n    border-radius: 12px;\n    padding: 11px 6px;\n    text-align: center;\n    position: relative;\n  }\n  .cnacc__size-card.pop {\n    border-color: #1a5cff;\n    background: #f0f4ff;\n  }\n  .cnacc__size-card .pop-tag {\n    position: absolute;\n    top: -9px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: #1a5cff;\n    color: #fff;\n    font-size: 8.5px;\n    font-weight: 800;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n    padding: 2px 7px;\n    border-radius: 999px;\n    white-space: nowrap;\n  }\n  .cnacc__size-letter {\n    font-size: 20px;\n    font-weight: 900;\n    color: #111;\n    line-height: 1;\n    margin-bottom: 3px;\n  }\n  .cnacc__size-dims {\n    font-size: 10.5px;\n    color: #777;\n    margin-bottom: 2px;\n  }\n  .cnacc__size-weight {\n    font-size: 10.5px;\n    font-weight: 700;\n    color: #111;\n  }\n\n  .cnacc__size-note {\n    font-size: 12px;\n    color: #666;\n    font-style: italic;\n    margin: 10px 0 8px;\n  }\n  .cnacc__size-tip {\n    background: #f3f5fb;\n    border-radius: 10px;\n    padding: 9px 12px;\n    font-size: 12.5px;\n    color: #444;\n    display: flex;\n    align-items: center;\n    gap: 7px;\n  }\n  .cnacc__size-tip svg {\n    width: 15px;\n    height: 15px;\n    stroke: #1a5cff;\n    fill: none;\n    flex-shrink: 0;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n  .cnacc__size-tip strong { font-weight: 800; color: #111; }\n\n  /* SHIPPING */\n  .cnacc__ship-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 8px;\n  }\n  .cnacc__ship-card {\n    background: #f7f8fa;\n    border-radius: 12px;\n    padding: 12px 10px;\n    display: flex;\n    align-items: flex-start;\n    gap: 9px;\n  }\n  .cnacc__ship-card svg {\n    width: 18px;\n    height: 18px;\n    stroke: #d95f1a;\n    fill: none;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    flex-shrink: 0;\n    margin-top: 1px;\n  }\n  .cnacc__ship-title {\n    font-size: 13px;\n    font-weight: 700;\n    color: #111;\n    margin-bottom: 2px;\n    line-height: 1.3;\n  }\n  .cnacc__ship-sub {\n    font-size: 11.5px;\n    color: #777;\n    line-height: 1.4;\n  }\n</style>\n\n<!-- GUARANTEE + PAYMENTS BAR -->\n<div class=\"cnacc-trust\">\n  <p class=\"cnacc-trust__text\">\n    30-Day Money Back Guarantee <span>·</span> Free Shipping on All Orders\n  </p>\n  <div class=\"cnacc-trust__payments\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Capture_d_ecran_le_2026-06-26_a_14.45.12_430x.png?v=1782481530\"\n      alt=\"Secure payment methods\"\n      loading=\"lazy\"\n    >\n  </div>\n</div>\n\n<!-- ACCORDION -->\n<div class=\"cnacc\">\n\n  <!-- ① DETAILS -->\n  <div class=\"cnacc__item\" data-