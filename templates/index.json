    "custom_liquid_zWxkTJ": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<style>\n  .sorelya-compare,\n  .sorelya-compare * {\n    box-sizing: border-box;\n  }\n\n  .sorelya-compare {\n    --sorelya-brown: #b88c66;\n    --sorelya-dark: #171214;\n    --sorelya-soft: #f8f6f4;\n    --sorelya-border: #d8d1cd;\n    --sorelya-green: #d9f4c9;\n    --sorelya-red: #e97882;\n\n    width: 100%;\n    padding: 58px 24px 62px;\n    overflow: hidden;\n    background: #fff;\n    color: var(--sorelya-dark);\n    font-family: Arial, Helvetica, sans-serif;\n  }\n\n  .sorelya-compare__inner {\n    display: grid;\n    grid-template-columns: minmax(270px, 0.75fr) minmax(620px, 1.6fr);\n    align-items: center;\n    gap: 58px;\n    width: 100%;\n    max-width: 1500px;\n    margin: 0 auto;\n  }\n\n  /* =========================\n     HEADING\n  ========================= */\n\n  .sorelya-compare__heading-wrap {\n    align-self: start;\n    padding-top: 22px;\n  }\n\n  .sorelya-compare__heading {\n    max-width: 520px;\n    margin: 0 0 18px;\n    color: #050505;\n    font-size: clamp(45px, 5vw, 76px);\n    font-weight: 900;\n    line-height: 1.06;\n    letter-spacing: -0.055em;\n  }\n\n  .sorelya-compare__subheading {\n    max-width: 430px;\n    margin: 0;\n    color: #70686a;\n    font-size: 17px;\n    font-weight: 500;\n    line-height: 1.55;\n  }\n\n  /* =========================\n     TABLE\n  ========================= */\n\n  .sorelya-compare__table-wrap {\n    width: 100%;\n  }\n\n  .sorelya-compare__table {\n    width: 100%;\n    overflow: hidden;\n    border: 1.5px solid var(--sorelya-border);\n    border-radius: 17px;\n    background: #fff;\n  }\n\n  .sorelya-compare__row {\n    display: grid;\n    grid-template-columns: 42% 29% 29%;\n    min-height: 76px;\n  }\n\n  .sorelya-compare__row + .sorelya-compare__row {\n    border-top: 1px solid var(--sorelya-border);\n  }\n\n  .sorelya-compare__cell {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 0;\n    padding: 14px 16px;\n    text-align: center;\n  }\n\n  .sorelya-compare__cell + .sorelya-compare__cell {\n    border-left: 1px solid var(--sorelya-border);\n  }\n\n  .sorelya-compare__cell--feature {\n    justify-content: flex-start;\n    color: #1a1720;\n    font-size: 16px;\n    font-weight: 800;\n    line-height: 1.25;\n    text-align: left;\n  }\n\n  .sorelya-compare__cell--sorelya {\n    background: var(--sorelya-brown);\n    color: #fff;\n  }\n\n  /* =========================\n     TABLE HEADER\n  ========================= */\n\n  .sorelya-compare__row--header {\n    min-height: 90px;\n  }\n\n  .sorelya-compare__row--header .sorelya-compare__cell--feature {\n    background: #fff;\n  }\n\n  .sorelya-compare__brand {\n    color: #fff;\n    font-size: 22px;\n    font-weight: 900;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  .sorelya-compare__traditional {\n    color: #25202c;\n    font-size: 18px;\n    font-weight: 900;\n    line-height: 1.2;\n  }\n\n  /* =========================\n     CHECKS / CROSSES\n  ========================= */\n\n  .sorelya-compare__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n  }\n\n  .sorelya-compare__icon svg {\n    width: 28px;\n    height: 28px;\n    fill: none;\n    stroke-width: 2.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .sorelya-compare__icon--check svg {\n    stroke: var(--sorelya-green);\n  }\n\n  .sorelya-compare__icon--cross svg {\n    width: 22px;\n    height: 22px;\n    stroke: var(--sorelya-red);\n    stroke-width: 2.2;\n  }\n\n  .sorelya-compare__note {\n    margin: 13px 4px 0;\n    color: #91898c;\n    font-size: 10.5px;\n    line-height: 1.45;\n    text-align: right;\n  }\n\n  /* =========================\n     MOBILE\n  ========================= */\n\n  @media (max-width: 850px) {\n    .sorelya-compare {\n      padding: 40px 14px 44px;\n    }\n\n    .sorelya-compare__inner {\n      display: block;\n      width: 100%;\n    }\n\n    .sorelya-compare__heading-wrap {\n      padding: 0 8px;\n      text-align: center;\n    }\n\n    .sorelya-compare__heading {\n      max-width: 360px;\n      margin: 0 auto 12px;\n      font-size: 34px;\n      line-height: 1.04;\n      letter-spacing: -0.045em;\n      text-transform: uppercase;\n    }\n\n    .sorelya-compare__subheading {\n      max-width: 340px;\n      margin: 0 auto 28px;\n      font-size: 14px;\n      line-height: 1.5;\n    }\n\n    .sorelya-compare__table {\n      border-radius: 14px;\n    }\n\n    .sorelya-compare__row {\n      grid-template-columns: 46% 27% 27%;\n      min-height: 67px;\n    }\n\n    .sorelya-compare__row--header {\n      min-height: 72px;\n    }\n\n    .sorelya-compare__cell {\n      padding: 10px 7px;\n    }\n\n    .sorelya-compare__cell--feature {\n      padding-left: 12px;\n      font-size: 12.5px;\n      line-height: 1.22;\n    }\n\n    .sorelya-compare__brand {\n      font-size: 14px;\n      letter-spacing: 0.035em;\n    }\n\n    .sorelya-compare__traditional {\n      font-size: 11.5px;\n      line-height: 1.15;\n    }\n\n    .sorelya-compare__icon {\n      width: 27px;\n      height: 27px;\n    }\n\n    .sorelya-compare__icon svg {\n      width: 22px;\n      height: 22px;\n    }\n\n    .sorelya-compare__icon--cross svg {\n      width: 18px;\n      height: 18px;\n    }\n\n    .sorelya-compare__note {\n      margin-top: 10px;\n      font-size: 9px;\n      text-align: center;\n    }\n  }\n</style>\n\n<section class=\"sorelya-compare\">\n  <div class=\"sorelya-compare__inner\">\n\n    <div class=\"sorelya-compare__heading-wrap\">\n      <h2 class=\"sorelya-compare__heading\">\n        What Makes SORELYA Different\n      </h2>\n\n      <p class=\"sorelya-compare__subheading\">\n        A lipstick designed for the lips you have today—not the ones\n        you had at 25.\n      </p>\n    </div>\n\n    <div class=\"sorelya-compare__table-wrap\">\n\n      <div\n        class=\"sorelya-compare__table\"\n        role=\"table\"\n   