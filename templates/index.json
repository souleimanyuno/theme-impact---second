        "liquid_b9QNnR": {
          "type": "liquid",
          "disabled": true,
          "settings": {
            "liquid": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');\n\n  .sorelya-lip-faq {\n    --sorelya-primary: #7d1f3d;\n    --sorelya-primary-soft: #fbf1f4;\n    --sorelya-gold: #bd9254;\n    --sorelya-border: #e7dfe2;\n    --sorelya-text: #171214;\n    --sorelya-muted: #686064;\n\n    width: 100%;\n    font-family: 'Inter', sans-serif;\n    color: var(--sorelya-text);\n  }\n\n  /* ==============================\n     GUARANTEE + PAYMENTS\n  ============================== */\n\n  .sorelya-lip-trust {\n    text-align: center;\n    padding: 16px 0 12px;\n  }\n\n  .sorelya-lip-trust__text {\n    margin: 0 0 12px;\n    font-size: 11px;\n    line-height: 1.4;\n    font-weight: 800;\n    color: #111;\n    letter-spacing: -0.01em;\n  }\n\n  .sorelya-lip-trust__payments img {\n    display: block;\n    width: 100%;\n    max-width: 225px;\n    height: auto;\n    margin: 0 auto;\n  }\n\n  /* ==============================\n     VIDEO CAROUSEL\n  ============================== */\n\n  .sorelya-video-section {\n    padding: 14px 0 18px;\n  }\n\n  .sorelya-video-section__header {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 12px;\n    margin-bottom: 11px;\n  }\n\n  .sorelya-video-section__title {\n    margin: 0;\n    font-size: 15px;\n    line-height: 1.25;\n    font-weight: 900;\n    color: #111;\n    letter-spacing: -0.02em;\n  }\n\n  .sorelya-video-section__hint {\n    margin: 0;\n    font-size: 10px;\n    font-weight: 700;\n    color: #81777b;\n    white-space: nowrap;\n  }\n\n  .sorelya-video-track {\n    display: flex;\n    gap: 11px;\n    width: 100%;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    scroll-behavior: smooth;\n    overscroll-behavior-x: contain;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    padding: 2px 5% 4px 0;\n  }\n\n  .sorelya-video-track::-webkit-scrollbar {\n    display: none;\n  }\n\n  .sorelya-video-card {\n    position: relative;\n    flex: 0 0 92%;\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    border-radius: 17px;\n    overflow: hidden;\n    background: #eee;\n    box-shadow: 0 7px 22px rgba(50, 20, 31, 0.11);\n  }\n\n  .sorelya-video-card video {\n    display: block;\n    width: 100%;\n    aspect-ratio: 9 / 16;\n    object-fit: cover;\n    background: #eee;\n  }\n\n  .sorelya-video-sound {\n    position: absolute;\n    right: 10px;\n    bottom: 10px;\n    z-index: 2;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    min-height: 32px;\n    padding: 7px 10px;\n    border: 0;\n    border-radius: 999px;\n    background: rgba(17, 17, 17, 0.76);\n    color: #fff;\n    font-family: 'Inter', sans-serif;\n    font-size: 10px;\n    line-height: 1;\n    font-weight: 800;\n    cursor: pointer;\n    backdrop-filter: blur(6px);\n    -webkit-backdrop-filter: blur(6px);\n  }\n\n  .sorelya-video-sound svg {\n    width: 14px;\n    height: 14px;\n    stroke: currentColor;\n    fill: none;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .sorelya-video-dots {\n    display: flex;\n    justify-content: center;\n    gap: 6px;\n    margin-top: 11px;\n  }\n\n  .sorelya-video-dot {\n    width: 6px;\n    height: 6px;\n    padding: 0;\n    border: 0;\n    border-radius: 999px;\n    background: #d8cdd1;\n    transition:\n      width 0.2s ease,\n      background 0.2s ease;\n  }\n\n  .sorelya-video-dot.active {\n    width: 20px;\n    background: var(--sorelya-primary);\n  }\n\n  /* ==============================\n     ACCORDIONS\n  ============================== */\n\n  .sorelya-lip-acc {\n    display: flex;\n    flex-direction: column;\n    gap: 9px;\n    width: 100%;\n    padding: 10px 0 16px;\n  }\n\n  .sorelya-lip-acc__item {\n    overflow: hidden;\n    border: 1.5px solid var(--sorelya-border);\n    border-radius: 15px;\n    background: #fff;\n    transition:\n      border-color 0.25s ease,\n      box-shadow 0.25s ease;\n  }\n\n  .sorelya-lip-acc__item.open {\n    border-color: var(--sorelya-primary);\n    box-shadow: 0 7px 20px rgba(125, 31, 61, 0.08);\n  }\n\n  .sorelya-lip-acc__trigger {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    width: 100%;\n    padding: 13px 14px;\n    border: 0;\n    background: transparent;\n    color: inherit;\n    font-family: 'Inter', sans-serif;\n    text-align: left;\n    cursor: pointer;\n  }\n\n  .sorelya-lip-acc__badge {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n    width: 38px;\n    height: 38px;\n    border-radius: 10px;\n    background: var(--sorelya-primary-soft);\n  }\n\n  .sorelya-lip-acc__badge svg {\n    width: 19px;\n    height: 19px;\n    fill: none;\n    stroke: var(--sorelya-primary);\n    stroke-width: 1.9;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .sorelya-lip-acc__label {\n    flex: 1;\n    font-size: 14.5px;\n    line-height: 1.3;\n    font-weight: 800;\n    color: #111;\n    letter-spacing: -0.015em;\n  }\n\n  .sorelya-lip-acc__chevron {\n    flex: 0 0 auto;\n    width: 17px;\n    height: 17px;\n    fill: none;\n    stroke: #948a8e;\n    transition:\n      transform 0.25s ease,\n      stroke 0.25s ease;\n  }\n\n  .sorelya-lip-acc__item.open .sorelya-lip-acc__chevron {\n    transform: rotate(180deg);\n    stroke: var(--sorelya-primary);\n  }\n\n  .sorelya-lip-acc__body {\n    display: none;\n    padding: 0 15px 16px 64px;\n  }\n\n  .sorelya-lip-acc__item.open .sorelya-lip-acc__body {\n    display: block;\n  }\n\n  .sorelya-lip-acc__copy {\n    margin: 0;\n    font-size: 13px;\n    line-height: 1.62;\n    color: var(--sorelya-muted);\n  }\n\n  .sorelya-lip-acc__copy strong {\n    color: #241d20;\n    font-weight: 800;\n  }\n\n  .sorelya-lip-highlight {\n    display: block;\n    margin-top: 11px;\n    padding: 10px 12px;\n    border-radius: 10px;\n    background: var(--sorelya-primary-soft);\n    color: #5e2437;\n    font-size: 11.5px;\n    line-height: 1.5;\n    font-weight: 700;\n  }\n\n  .sorelya-lip-steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 7px;\n    margin-top: 13px;\n  }\n\n  .sorelya-lip-step {\n    padding: 11px 7px;\n    border: 1px solid #eadfe3;\n    border-radius: 11px;\n    background: #fff;\n    text-align: center;\n  }\n\n  .sorelya-lip-step__number {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 24px;\n    height: 24px;\n    margin: 0 auto 7px;\n    border-radius: 50%;\n    background: var(--sorelya-primary);\n    color: #fff;\n    font-size: 10px;\n    font-weight: 900;\n  }\n\n  .sorelya-lip-step__title {\n    margin-bottom: 3px;\n    font-size: 11px;\n    line-height: 1.3;\n    font-weight: 800;\n    color: #171214;\n  }\n\n  .sorelya-lip-step__text {\n    font-size: 10px;\n    line-height: 1.4;\n    color: #746a6e;\n  }\n\n  @media (min-width: 750px) {\n    .sorelya-video-track {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      overflow: visible;\n      padding-right: 0;\n    }\n\n    .sorelya-video-card {\n      width: 100%;\n    }\n\n    .sorelya-video-section__hint,\n    .sorelya-video-dots {\n      display: none;\n    }\n  }\n\n  @media (max-width: 480px) {\n    .sorelya-lip-acc__body {\n      padding: 0 14px 15px;\n    }\n\n    .sorelya-lip-steps {\n      grid-template-columns: 1fr;\n    }\n\n    .sorelya-lip-step {\n      display: grid;\n      grid-template-columns: 29px 1fr;\n      column-gap: 9px;\n      padding: 10px;\n      text-align: left;\n    }\n\n    .sorelya-lip-step__number {\n      grid-row: 1 / 3;\n      margin: 0;\n    }\n  }\n</style>\n\n<div class=\"sorelya-lip-faq\" data-sorelya-lip-root>\n\n  <!-- GUARANTEE + PAYMENT METHODS -->\n  <div class=\"sorelya-lip-trust\">\n    <p class=\"sorelya-lip-trust__text\">\n      60-Day Money-Back Guarantee • Free Shipping on All Orders\n    </p>\n\n    <div class=\"sorelya-lip-trust__payments\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Capture_d_ecran_le_2026-06-26_a_14.45.12_430x.png?v=1782481530\"\n        alt=\"Secure payment methods\"\n        loading=\"lazy\"\n      >\n    </div>\n  </div>\n\n  <!-- MOBILE-FIRST VIDEO CAROUSEL -->\n  <div class=\"sorelya-video-section\">\n    <div class=\"sorelya-video-section__header\">\n      <p class=\"sorelya-video-section__title\">See SORELYA on real women</p>\n      <p class=\"sorelya-video-section__hint\">Swipe to see more →</p>\n    </div>\n\n    <div class=\"sorelya-video-track\" data-sorelya-video-track>\n\n      <div class=\"sorelya-video-card\" data-sorelya-video-card>\n        <video\n          muted\n          autoplay\n          loop\n          playsinline\n          preload=\"metadata\"\n          disablepictureinpicture\n        >\n          <source\n            src=\"https://cdn.shopify.com/videos/c/o/v/44c6e06262764af0afcd43358edf4781.mp4\"\n            type=\"video/mp4\"\n          >\n        </video>\n\n        <button class=\"sorelya-video-sound\" type=\"button\" aria-label=\"Turn video sound on\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M11 5 6 9H2v6h4l5 4z\"/>\n            <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"/>\n            <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"/>\n          </svg>\n          <span>Tap for sound</span>\n        </button>\n      </div>\n\n      <div class=\"sorelya-video-card\" data-sorelya-video-card>\n        <video\n          muted\n          autoplay\n          loop\n          playsinline\n          preload=\"metadata\"\n          disablepictureinpicture\n        >\n          <source\n            src=\"https://cdn.shopify.com/videos/c/o/v/53b846cf8fd146ff860d336bb2be2ade.mp4\"\n            type=\"video/mp4\"\n          >\n        </video>\n\n        <button class=\"sorelya-video-sound\" type=\"button\" aria-label=\"Turn video sound on\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M11 5 6 9H2v6h4l5 4z\"/>\n            <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"/>\n            <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"/>\n          </svg>\n          <span>Tap for sound</span>\n        </button>\n      </div>\n\n      <div class=\"sorelya-video-card\" data-sorelya-video-card>\n        <video\n          muted\n          autoplay\n          loop\n          playsinline\n          preload=\"metadata\"\n          disablepictureinpicture\n        >\n          <source\n            src=\"https://cdn.shopify.com/videos/c/o/v/d2c7bfe087b24144b118c2dcc7e8d958.mp4\"\n            type=\"video/mp4\"\n          >\n        </video>\n\n        <button class=\"sorelya-video-sound\" type=\"button\" aria-label=\"Turn video sound on\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M11 5 6 9H2v6h4l5 4z\"/>\n            <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"/>\n            <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"/>\n          </svg>\n          <span>Tap for sound</span>\n        </button>\n      </div>\n\n    </div>\n\n    <div class=\"sorelya-video-dots\" aria-hidden=\"true\">\n      <button class=\"sorelya-video-dot active\" type=\"button\" data-video-dot=\"0\"></button>\n      <button class=\"sorelya-video-dot\" type=\"button\" data-video-dot=\"1\"></button>\n      <button class=\"sorelya-video-dot\" type=\"button\" data-video-dot=\"2\"></button>\n    </div>\n  </div>\n\n  <!-- FAQ ACCORDIONS -->\n  <div class=\"sorelya-lip-acc\">\n\n    <!-- 1 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 3v18\"/>\n            <path d=\"M3 12h18\"/>\n            <path d=\"m5 5 14 14\"/>\n            <path d=\"m19 5-14 14\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          How does SORELYA find my shade?\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          SORELYA starts almost clear, then gradually develops into a\n          <strong>personalized-looking tint</strong> influenced by your natural\n          lip tone, moisture and temperature. The finished color may look\n          slightly different on every woman.\n        </p>\n\n        <div class=\"sorelya-lip-steps\">\n          <div class=\"sorelya-lip-step\">\n            <span class=\"sorelya-lip-step__number\">1</span>\n            <div class=\"sorelya-lip-step__title\">Apply</div>\n            <div class=\"sorelya-lip-step__text\">Use one light, even layer.</div>\n          </div>\n\n          <div class=\"sorelya-lip-step\">\n            <span class=\"sorelya-lip-step__number\">2</span>\n            <div class=\"sorelya-lip-step__title\">Let It Develop</div>\n            <div class=\"sorelya-lip-step__text\">Watch the tint gradually appear.</div>\n          </div>\n\n          <div class=\"sorelya-lip-step\">\n            <span class=\"sorelya-lip-step__number\">3</span>\n            <div class=\"sorelya-lip-step__title\">Wear Your Tint</div>\n            <div class=\"sorelya-lip-step__text\">No shade chart or guessing needed.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- 2 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M7 3h10l2 5-7 13L5 8z\"/>\n            <path d=\"M8 8h8\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          Is it suitable for mature or very dry lips?\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          Yes. SORELYA was designed with mature lips in mind and has a\n          <strong>lightweight, balm-like feel</strong> rather than a heavy,\n          drying matte finish. For very chapped lips, moisturize first and blot\n          away excess balm before applying.\n        </p>\n\n        <span class=\"sorelya-lip-highlight\">\n          Color without the dry, tight feeling many women experience with\n          traditional lipstick.\n        </span>\n      </div>\n    </div>\n\n    <!-- 3 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M3 12c3-4 6-6 9-6s6 2 9 6c-3 4-6 6-9 6s-6-2-9-6z\"/>\n            <path d=\"M6 12h12\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          Will it stay out of my lip lines?\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          SORELYA is designed to help the tint remain\n          <strong>on your lips instead of creeping into the fine lines</strong>\n          around your mouth. Apply a thin, even layer to clean lips and allow\n          the color to develop before adding more.\n        </p>\n\n        <span class=\"sorelya-lip-highlight\">\n          Your lips aren’t the problem. Your old lipstick formula was.\n        </span>\n      </div>\n    </div>\n\n    <!-- 4 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n            <path d=\"M3 12h18\"/>\n            <path d=\"M12 3a14 14 0 0 1 0 18\"/>\n            <path d=\"M12 3a14 14 0 0 0 0 18\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          Does it work on every skin tone?\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          SORELYA can be worn across fair, medium and deep complexions.\n          Because the tint develops over your\n          <strong>natural lip color</strong>, the same tube can appear softer,\n          warmer or deeper from one woman to another.\n        </p>\n\n        <span class=\"sorelya-lip-highlight\">\n          Same lipstick. Different women. Different-looking results.\n        </span>\n      </div>\n    </div>\n\n    <!-- 5 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n            <polyline points=\"12 7 12 12 16 14\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          How long does the color last?\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          SORELYA is designed to keep the tint looking\n          <strong>soft and even for hours</strong>. Wear can vary depending on\n          meals, oils and your natural lip chemistry. Reapply whenever you want\n          a fresher or slightly deeper result.\n        </p>\n      </div>\n    </div>\n\n    <!-- 6 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M20 4C10 4 5 9 5 17c5 0 10-5 15-13z\"/>\n            <path d=\"M5 17c3-4 6-6 10-8\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          Ingredients & safety\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          SORELYA is a cosmetic lip product intended for external use only.\n          Review the complete ingredient list before use, especially if you\n          have known sensitivities. Patch test first and discontinue use if\n          irritation occurs.\n        </p>\n\n        <span class=\"sorelya-lip-highlight\">\n          Full ingredient list: [PASTE THE VERIFIED SUPPLIER INCI LIST HERE]\n        </span>\n      </div>\n    </div>\n\n    <!-- 7 -->\n    <div class=\"sorelya-lip-acc__item\" data-sorelya-accordion>\n      <button class=\"sorelya-lip-acc__trigger\" type=\"button\" aria-expanded=\"false\">\n        <span class=\"sorelya-lip-acc__badge\">\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M3 7h13v10H3z\"/>\n            <path d=\"M16 10h3l2 3v4h-5z\"/>\n            <circle cx=\"7\" cy=\"18\" r=\"2\"/>\n            <circle cx=\"18\" cy=\"18\" r=\"2\"/>\n          </svg>\n        </span>\n\n        <span class=\"sorelya-lip-acc__label\">\n          What if I don’t love my shade?\n        </span>\n\n        <svg class=\"sorelya-lip-acc__chevron\" viewBox=\"0 0 24 24\" stroke-width=\"2.5\">\n          <polyline points=\"6 9 12 15 18 9\"/>\n        </svg>\n      </button>\n\n      <div class=\"sorelya-lip-acc__body\">\n        <p class=\"sorelya-lip-acc__copy\">\n          Your order is protected by our\n          <strong>60-day money-back guarantee</strong>. Try SORELYA on your own\n          lips and see how the tint develops. If it is not right for you,\n          contact our support team within 60 days. Every order includes free\n          shipping and tracking.\n        </p>\n\n        <span class=\"sorelya-lip-highlight\">\n          No shade-chart risk. No being stuck with another unused lipstick.\n        </span>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('[data-sorelya-lip-root]').forEach(function (root) {\n\n      /* ACCORDIONS */\n      var accordionItems = root.querySelectorAll('[data-sorelya-accordion]');\n\n      accordionItems.forEach(function (item) {\n        item.classList.remove('open');\n\n        var trigger = item.querySelector('.sorelya-lip-acc__trigger');\n\n        if (trigger) {\n          trigger.setAttribute('aria-expanded', 'false');\n\n          trigger.addEventListener('click', function () {\n            var wasOpen = item.classList.contains('open');\n\n            accordionItems.forEach(function (otherItem) {\n              otherItem.classList.remove('open');\n\n              var otherTrigger = otherItem.querySelector(\n                '.sorelya-lip-acc__trigger'\n              );\n\n              if (otherTrigger) {\n                otherTrigger.setAttribute('aria-expanded', 'false');\n              }\n            });\n\n            if (!wasOpen) {\n              item.classList.add('open');\n              trigger.setAttribute('aria-expanded', 'true');\n            }\n          });\n        }\n      });\n\n      /* VIDEO AUTOPLAY */\n      var cards = Array.from(\n        root.querySelectorAll('[data-sorelya-video-card]')\n      );\n\n      var videos = cards.map(function (card) {\n        return card.querySelector('video');\n      });\n\n      var dots = Array.from(\n        root.querySelectorAll('[data-video-dot]')\n      );\n\n      function setActiveDot(index) {\n        dots.forEach(function (dot, dotIndex) {\n          dot.classList.toggle('active', dotIndex === index);\n        });\n      }\n\n      function muteOtherVideos(activeVideo) {\n        videos.forEach(function (video) {\n          if (video !== activeVideo) {\n            video.muted = true;\n\n            var card = video.closest('[data-sorelya-video-card]');\n            var button = card\n              ? card.querySelector('.sorelya-video-sound')\n              : null;\n\n            if (button) {\n              button.querySelector('span').textContent = 'Tap for sound';\n              button.setAttribute('aria-label', 'Turn video sound on');\n            }\n          }\n        });\n      }\n\n      if ('IntersectionObserver' in window) {\n        var videoObserver = new IntersectionObserver(\n          function (entries) {\n            entries.forEach(function (entry) {\n              var card = entry.target;\n              var video = card.querySelector('video');\n              var index = cards.indexOf(card);\n\n              if (entry.isIntersecting && entry.intersectionRatio >= 0.65) {\n                video.play().catch(function () {});\n                setActiveDot(index);\n              } else {\n                video.pause();\n              }\n            });\n          },\n          {\n            threshold: [0.25, 0.65, 0.9]\n          }\n        );\n\n        cards.forEach(function (card) {\n          videoObserver.observe(card);\n        });\n      } else if (videos[0]) {\n        videos[0].play().catch(function () {});\n      }\n\n      /* SOUND BUTTONS */\n      cards.forEach(function (card) {\n        var video = card.querySelector('video');\n        var button = card.querySelector('.sorelya-video-sound');\n\n        if (!video || !button) return;\n\n        button.addEventListener('click', function () {\n          var willUnmute = video.muted;\n\n          muteOtherVideos(video);\n          video.muted = !willUnmute;\n\n          if (willUnmute) {\n            button.querySelector('span').textContent = 'Sound on';\n            button.setAttribute('aria-label', 'Turn video sound off');\n            video.play().catch(function () {});\n          } else {\n            button.querySelector('span').textContent = 'Tap for sound';\n            button.setAttribute('aria-label', 'Turn video sound on');\n          }\n        });\n      });\n\n      /* DOT NAVIGATION */\n      var track = root.querySelector('[data-sorelya-video-track]');\n\n      dots.forEach(function (dot, index) {\n        dot.addEventListener('click', function () {\n          if (!cards[index] || !track) return;\n\n          track.scrollTo({\n            left: cards[index].offsetLeft - track.offsetLeft,\n            behavior: 'smooth'\n          });\n        });\n      });\n\n      /* PAUSE WHEN TAB IS HIDDEN */\n      document.addEventListener('visibilitychange', function () {\n        if (document.hidden) {\n          videos.forEach(function (video) {\n            video.pause();\n          });\n        }\n      });\n    });\n  })();\n</script>"
          }
        },
        "collapsible_text_7LqTqm": {
          "type": "collapsible_text",
          "disabled": true,
          "settings": {
            "icon": "none",
            "icon_width": 20,
            "title": "PFLEGE",
            "content": "<ol><li><strong>Bei 30°C in der Waschmaschine oder per Hand waschen</strong><br/>Beim Maschinenwaschen das Schonprogramm verwenden. Anders als billige Strumpfhosen die beim ersten Tragen reißen, sind diese für die Ewigkeit gemacht — kein Drama nötig.</li><li><strong>Normales Waschmittel verwenden (kein Bleichmittel, keine Weichspüler)</strong><br/>Ein mildes Waschmittel reicht völlig aus. Bleichmittel und Weichspüler beschädigen die formenden Fasern — und diese sind bereits angenehm weich.</li><li><strong>Liegend oder hängend trocknen (NIE in den Trockner)</strong><br/>Der Trockner ist dein Feind. Einfach normal aufhängen oder flach hinlegen. Direktes Sonnenlicht vermeiden, sonst kann die Farbe verblassen.</li><li><strong>Sorgfältig falten und in der Schublade aufbewahren</strong><br/>Keine komischen Falten, sonst verlieren sie die Form. Behandle sie wie dein Lieblingsteil — keine spezielle Aufbewahrung nötig, nur normale Pflege.</li><li><strong>Nur bei Bedarf ersetzen</strong><br/>Wenn das Kontrollband nicht mehr so gut hält oder der Stoff Verschleiß zeigt, ist es Zeit für ein neues Paar. Aber keine Sorge — diese halten VIEL länger als die 5€-Strumpfhosen die nach einmaligem Tragen reißen.</li></ol><p><strong>Profi-Tipp:</strong> Kauf 2-3 Paare und wechsle sie wöchentlich ab — so halten sie doppelt so lang.</p>",
            "page": ""
          }
        },
