     aria-label=\"SORELYA compared with traditional lipstick\"\n      >\n\n        <!-- HEADER -->\n        <div class=\"sorelya-compare__row sorelya-compare__row--header\" role=\"row\">\n          <div\n            class=\"sorelya-compare__cell sorelya-compare__cell--feature\"\n            role=\"columnheader\"\n          ></div>\n\n          <div\n            class=\"sorelya-compare__cell sorelya-compare__cell--sorelya\"\n            role=\"columnheader\"\n          >\n            <span class=\"sorelya-compare__brand\">SORELYA</span>\n          </div>\n\n          <div\n            class=\"sorelya-compare__cell\"\n            role=\"columnheader\"\n          >\n            <span class=\"sorelya-compare__traditional\">\n              Traditional<br>Lipstick\n            </span>\n          </div>\n        </div>\n\n        <!-- ROW 1 -->\n        <div class=\"sorelya-compare__row\" role=\"row\">\n          <div class=\"sorelya-compare__cell sorelya-compare__cell--feature\" role=\"cell\">\n            Tint develops on your lips\n          </div>\n\n          <div class=\"sorelya-compare__cell sorelya-compare__cell--sorelya\" role=\"cell\">\n            <span class=\"sorelya-compare__icon sorelya-compare__icon--check\">\n              <svg viewBox=\"0 0 24 24\">\n                <polyline points=\"20 6 9 17 4 12\"></polyline>\n              </svg>\n            </span>\n          </div>\n\n          <div class=\"sorelya-compare__cell\" role=\"cell\">\n            <span class=\"sorelya-compare__icon sorelya-compare__icon--cross\">\n              <svg viewBox=\"0 0 24 24\">\n                <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line>\n                <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line>\n              </svg>\n            </span>\n          </div>\n        </div>\n\n        <!-- ROW 2 -->\n        <div class=\"sorelya-compare__row\" role=\"row\">\n          <div class=\"sorelya-compare__cell sorelya-compare__cell--feature\" role=\"cell\">\n         