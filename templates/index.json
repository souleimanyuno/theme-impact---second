    "custom_liquid_DLg7Vj": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{%- comment -%}\n  SORELYA — BLOC 07\n  ★★★★★ Excelente / Resultados visibles / Sorelya\n  Carrousel avant/après — 5 cartes\n{%- endcomment -%}\n\n{%- assign sor_note_txt = \"Excelente\" -%}\n{%- assign sor_titre_1 = \"Resultados visibles\" -%}\n{%- assign sor_titre_2 = \"Sorelya\" -%}\n\n{%- capture sor_cartes_str -%}\nhttps://cdn.shopify.com/s/files/1/0992/0384/2370/files/Image_ChatGPT_28_sept._2026_23_37_04-1_430x.png?v=1790653256,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Image_ChatGPT_28_sept._2026_23_37_05-2_430x.png?v=1790653256,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Image_ChatGPT_28_sept._2026_23_37_06-3_430x.png?v=1790653256,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Image_ChatGPT_28_sept._2026_23_37_07-5_430x.png?v=1790653256,https://cdn.shopify.com/s/files/1/0992/0384/2370/files/Image_ChatGPT_28_sept._2026_23_37_07-4_430x.png?v=1790653256\n{%- endcapture -%}\n\n{%- assign sor_cartes = sor_cartes_str | strip | split: \",\" -%}\n\n{%- assign sor_alts = \"Antes y después: pliegues nasolabiales|Antes y después: mandíbula más definida|Antes y después: mandíbula más definida|Antes y después: líneas del labio superior|Antes y después: líneas de marioneta\" | split: \"|\" -%}\n\n{%- if sor_cartes.size > 0 -%}\n\n<section class=\"sor-b07\" data-sor-b07>\n\n  <div class=\"sor-b07__head\">\n\n    <div class=\"sor-b07__badge\">\n      <span class=\"sor-b07__stars\" aria-hidden=\"true\">\n        {%- for i in (1..5) -%}\n          <svg viewBox=\"0 0 24 24\">\n            <path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z\"/>\n          </svg>\n        {%- endfor -%}\n      </span>\n\n      <span class=\"sor-b07__note\">\n        {{ sor_note_txt }}\n      </span>\n    </div>\n\n    <h2 class=\"sor-b07__titre\">\n      <span class=\"sor-b07__t1\">\n        {{ sor_titre_1 }}\n      </span>\n\n      <span class=\"sor-b07__t2\">\n        {{ sor_titre_2 }}\n      </span>\n    </h2>\n\n  </div>\n\n  <ul class=\"sor-b07__track\" role=\"list\">\n\n    {%- for c in sor_cartes -%}\n\n      {%- assign url = c | strip -%}\n      {%- assign alt = sor_alts[forloop.index0] | default: \"Antes y después\" | strip -%}\n\n      <li class=\"sor-b07__card\">\n\n        <img\n          src=\"{{ url }}\"\n          alt=\"{{ alt | escape }}\"\n          width=\"700\"\n          height=\"900\"\n          loading=\"{% if forloop.first %}eager{% else %}lazy{% endif %}\"\n          decoding=\"async\"\n        >\n\n      </li>\n\n    {%- endfor -%}\n\n  </ul>\n\n  {%- if sor_cartes.size > 1 -%}\n\n    <div class=\"sor-b07__dots\" aria-hidden=\"true\">\n      {%- for c in sor_cartes -%}\n        <span class=\"sor-b07__dot{% if forloop.first %} is-on{% endif %}\"></span>\n      {%- endfor -%}\n    </div>\n\n  {%- endif -%}\n\n</section>\n\n\n<script>\n(function () {\n\n  function init(root) {\n\n    if (root.dataset.sorInit) return;\n\n    root.dataset.sorInit = '1';\n\n    var track = root.querySelector('.sor-b07__track');\n    var dots = root.querySelectorAll('.sor-b07__dot');\n\n    if (!track || !dots.length) return;\n\n    var cards = track.querySelectorAll('.sor-b07__card');\n\n    track.addEventListener(\n      'scroll',\n      function () {\n\n        var best = 0;\n        var bestD = Infinity;\n        var left = track.getBoundingClientRect().left;\n\n        cards.forEach(function (card, i) {\n\n          var distance = Math.abs(\n            card.getBoundingClientRect().left - left\n          );\n\n          if (distance < bestD) {\n            bestD = distance;\n            best = i;\n          }\n\n        });\n\n        dots.forEach(function (dot, i) {\n          dot.classList.toggle('is-on', i === best);\n        });\n\n      },\n      { passive: true }\n    );\n\n  }\n\n\n  function initAll(scope) {\n\n    (scope || document)\n      .querySelectorAll('[data-sor-b07]')\n      .forEach(init);\n\n  }\n\n\n  if (document.readyState === 'loading') {\n\n    document.addEventListener(\n      'DOMContentLoaded',\n      function () {\n        initAll();\n      }\n    );\n\n  } else {\n\n    initAll();\n\n  }\n\n\n  document.addEventListener(\n    'shopify:section:load',\n    function (event) {\n      initAll(event.target);\n    }\n  );\n\n})();\n</script>\n\n\n<style>\n\n.sor-b07 {\n  --sor-ink: #2B2220;\n  --sor-rose: #D9A79D;\n  --sor-rose-fonce: #9A5E53;\n  --sor-etoile: #E0A23B;\n\n  padding-top: var(--sor-espace-sections, 44px) !important;\n  padding-bottom: 4px;\n}\n\n\n.sor-b07__head {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n\n  padding: 0 8px;\n  margin-bottom: 8px;\n}\n\n\n.sor-b07__badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n\n  margin-bottom: 6px;\n}\n\n\n.sor-b07__stars {\n  display: inline-flex;\n  gap: 2px;\n}\n\n\n.sor-b07__stars svg {\n  width: 18px;\n  height: 18px;\n  fill: var(--sor-etoile);\n}\n\n\n.sor-b07__note {\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1;\n\n  color: var(--sor-ink);\n}\n\n\n.sor-b07__titre {\n  margin: 0;\n\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n\n  font-family: var(--font-heading-family, inherit);\n  font-style: var(--font-heading-style, normal);\n\n  color: var(--sor-ink);\n\n  line-height: 1.2;\n  letter-spacing: 0;\n}\n\n\n.sor-b07__t1 {\n  font-size: 29px;\n  font-weight: var(--font-heading-weight, 700);\n}\n\n\n.sor-b07__t2 {\n  font-size: 27px;\n  font-weight: 400;\n  color: var(--sor-rose-fonce);\n}\n\n\n.sor-b07__track {\n  list-style: none;\n\n  margin: 0;\n  padding: 2px 0 6px;\n\n  display: flex;\n  gap: 10px;\n\n  overflow-x: auto;\n\n  scroll-snap-type: x mandatory;\n\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n\n  overscroll-behavior-x: contain;\n}\n\n\n.sor-b07__track::-webkit-scrollbar {\n  display: none;\n}\n\n\n.sor-b07__card {\n  flex: 0 0 82%;\n  max-width: 340px;\n\n  scroll-snap-align: start;\n\n  border-radius: 18px;\n  overflow: hidden;\n}\n\n\n.sor-b07__card img {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n\n.sor-b07__dots {\n  display: flex;\n  justify-content: center;\n  gap: 6px;\n\n  margin-top: 4px;\n}\n\n\n.sor-b07__dot {\n  width: 7px;\n  height: 7px;\n\n  border-radius: 50%;\n\n  background: #E8D6D1;\n\n  transition: all .2s ease;\n}\n\n\n.sor-b07__dot.is-on {\n  width: 18px;\n\n  border-radius: 999px;\n\n  background: var(--sor-rose-fonce);\n}\n\n\n@media (min-width: 750px) {\n\n  .sor-b07 {\n    padding-bottom: 8px;\n  }\n\n  .sor-b07__stars svg {\n    width: 22px;\n    height: 22px;\n  }\n\n  .sor-b07__note {\n    font-size: 18px;\n  }\n\n  .sor-b07__t1 {\n    font-size: 37px;\n  }\n\n  .sor-b07__t2 {\n    font-size: 35px;\n  }\n\n  .sor-b07__track {\n    gap: 14px;\n  }\n\n  .sor-b07__card {\n    flex-basis: 340px;\n  }\n\n}\n\n</style>\n\n{%- endif -%}",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    },
