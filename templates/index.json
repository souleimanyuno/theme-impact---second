        "liquid": "{%- capture sr_svg1 -%}<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M11.5245 3.46353C11.6741 3.00287 12.3259 3.00287 12.4755 3.46353L14.1329 8.56434C14.1998 8.77035 14.3918 8.90983 14.6084 8.90983H19.9717C20.4561 8.90983 20.6575 9.52964 20.2656 9.81434L15.9266 12.9668C15.7514 13.0941 15.678 13.3198 15.745 13.5258L17.4023 18.6266C17.552 19.0873 17.0248 19.4704 16.6329 19.1857L12.2939 16.0332C12.1186 15.9059 11.8814 15.9059 11.7061 16.0332L7.3671 19.1857C6.97524 19.4704 6.448 19.0873 6.59768 18.6266L8.25503 13.5258C8.32197 13.3198 8.24864 13.0941 8.07339 12.9668L3.73438 9.81434C3.34253 9.52964 3.54392 8.90983 4.02828 8.90983H9.39159C9.6082 8.90983 9.80018 8.77035 9.86712 8.56434L11.5245 3.46353Z\"/></svg>{%- endcapture -%}\n{%- capture sr_svg2 -%}<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.37 7.86a1 1 0 0 0-1.42-1.41l-4.6 4.6-1.9-1.9a1 1 0 1 0-1.41 1.42l2.6 2.6a1 1 0 0 0 1.42 0l5.31-5.31Z\"/></svg>{%- endcapture -%}\n{%- capture sr_svg3 -%}<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z\"/><line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"/><path d=\"M16 10a4 4 0 0 1-8 0\"/></svg>{%- endcapture -%}\n<section id=\"shopify-section-sorelya__custom_liquid_QeDEmY\" class=\"shopify-section section\"><style data-shopify>.section-sorelya__custom_liquid_QeDEmY-padding {\n    padding-top: calc(40px * 0.75);\n    padding-bottom: calc(52px  * 0.75);\n  }\n\n  @media screen and (min-width: 750px) {\n    .section-sorelya__custom_liquid_QeDEmY-padding {\n      padding-top: 40px;\n      padding-bottom: 52px;\n    }\n  }</style><div class=\"color-background-1 gradient content-for-grouping always-display\">\n  \n  <div class=\"section-sorelya__custom_liquid_QeDEmY-padding\">\n    <!-- ============================================================\n     SORELYA — Avis clients (carrousel) — 14 AVIS\n     À coller dans : Personnaliser > Ajouter une section > \"Liquid personnalisé\"\n\n     À REMPLACER avant publication :\n       Tout est déjà renseigné. Vérifier seulement le lien produit\n       ci-dessous si ton handle est différent.\n     ============================================================ --><style>\n  .sr-avis {\n    --sr-acc: #052E57;          /* couleur de marque */\n    --sr-star: #00B67A;         /* vert Trustpilot */\n    --sr-cta: #FFD814;          /* jaune du bouton */\n    --sr-cta-txt: #052E57;      /* texte du bouton */\n    --sr-txt: #111827;\n    --sr-soft: #EAF0F6;\n    --sr-bd: #E5E7EB;\n    padding: 4px 0 6px;\n    background: #FFFFFF;\n  }\n  .sr-avis * { box-sizing: border-box; }\n\n  /* Pastille de note */\n  .sr-avis .sr-rating-wrap { display: flex; justify-content: center; padding: 0 16px; }\n  .sr-avis .sr-rating {\n    display: inline-flex; align-items: center; justify-content: center;\n    flex-wrap: nowrap; white-space: nowrap; gap: 8px; max-width: 100%;\n    background: var(--sr-soft); border: 1px solid var(--sr-acc);\n    border-radius: 999px; padding: 7px 16px; line-height: 1;\n  }\n  .sr-avis .sr-rating .sr-stars { flex: 0 0 auto; }\n  .sr-avis .sr-rating .sr-stars svg { width: clamp(15px,4.4vw,18px); height: clamp(15px,4.4vw,18px); }\n  .sr-avis .sr-rating p {\n    margin: 0; display: inline-flex; align-items: center; gap: 5px;\n    font-size: clamp(12px,3.3vw,15px); line-height: 1; color: var(--sr-txt);\n    white-space: nowrap;\n  }\n  .sr-avis .sr-rating strong { font-weight: 700; }\n  .sr-avis .sr-rating .sr-rating-sub { color: #4b5563; font-weight: 500; }\n\n  /* Titre */\n  .sr-avis .sr-header { text-align: center; padding: 8px 16px 12px; }\n  .sr-avis .sr-title {\n    margin: 0; text-transform: uppercase; letter-spacing: -0.01em;\n    font-size: clamp(24px,6.2vw,44px); line-height: 1.15; color: var(--sr-txt);\n  }\n  .sr-avis .sr-title em { color: var(--sr-acc); font-style: italic; }\n  .sr-avis .sr-sub {\n    margin: 8px auto 0; max-width: 640px;\n    font-size: clamp(16px,4vw,18px); line-height: 1.6; color: #4b5563;\n  }\n\n  /* Carrousel */\n  .sr-avis .sr-track {\n    display: flex; gap: 18px; overflow-x: auto;\n    scroll-snap-type: x proximity; overscroll-behavior-x: contain;\n    padding: 2px 16px 4px;\n    -ms-overflow-style: none; scrollbar-width: none;\n  }\n  .sr-avis .sr-track::-webkit-scrollbar { display: none; }\n  .sr-avis .sr-card {\n    flex: 0 0 auto; width: min(88vw,360px);\n    background: #fff; border: 1px solid var(--sr-bd); border-radius: 16px;\n    overflow: hidden; scroll-snap-align: center; display: flex; flex-direction: column;\n  }\n  @media (min-width: 750px) {\n    .sr-avis .sr-track { padding-inline: max(16px, calc((100% - 1140px) / 2)); }\n    .sr-avis .sr-card { width: 360px; }\n  }\n\n  /* Image */\n  .sr-avis .sr-media { position: relative; background: #f4f5f7; }\n  .sr-avis .sr-media img { display: block; width: 100%; aspect-ratio: 6 / 5; height: auto; object-fit: cover; }\n\n  /* Contenu */\n  .sr-avis .sr-content { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 12px; flex: 1; }\n  .sr-avis .sr-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n  .sr-avis .sr-stars { display: inline-flex; gap: 1px; color: var(--sr-star); }\n  .sr-avis .sr-head .sr-stars svg { width: 16px; height: 16px; }\n  .sr-avis .sr-who {\n    display: inline-flex; align-items: center; gap: 7px;\n    border: 1px solid var(--sr-bd); border-radius: 50px; padding: 4px 10px;\n    font-size: 13px; color: var(--sr-txt);\n  }\n  .sr-avis .sr-ok { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; color: #16a34a; }\n  .sr-avis .sr-ok svg { width: 14px; height: 14px; }\n  .sr-avis .sr-text { margin: 0; font-size: clamp(15px,3.9vw,17px); line-height: 1.65; color: var(--sr-txt); }\n\n  /* Produit acheté */\n  .sr-avis .sr-product {\n    margin-top: auto; display: flex; align-items: center; gap: 12px;\n    background: var(--sr-soft); border-radius: 12px; padding: 10px 12px;\n    text-decoration: none; color: inherit;\n    height: 78px;                     /* hauteur identique quel que soit le produit */\n  }\n  .sr-avis .sr-product img { width: 56px; height: 56px; object-fit: contain; border-radius: 8px; background: #fff; flex: 0 0 auto; }\n  .sr-avis .sr-pinfo { flex: 1; min-width: 0; display: block; }\n  .sr-avis .sr-pname {\n    margin: 0 0 3px; font-size: 13.5px; font-weight: 700; line-height: 1.25;\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  }\n  .sr-avis .sr-price { margin: 0; font-size: 14px; font-weight: 700; color: var(--sr-acc); line-height: 1.2; white-space: nowrap; }\n  .sr-avis .sr-price s { font-weight: 400; font-size: 12.5px; color: #8a8f98; margin-left: 6px; }\n  .sr-avis .sr-date {\n    margin: 3px 0 0; display: flex; align-items: center; gap: 5px;\n    font-size: 11.5px; line-height: 1.2; color: #6b7280;\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\n  }\n  .sr-avis .sr-date svg { width: 11px; height: 11px; flex: 0 0 auto; }\n\n  /* ===== FLÈCHES DE NAVIGATION ===== */\n  .sr-avis .sr-carousel { position: relative; }\n  .sr-avis .sr-nav {\n    position: absolute;\n    top: calc(35.8vw + 2px);          /* centre exact de l'image (86vw × 5/6 ÷ 2) */\n    transform: translateY(-50%);\n    z-index: 3;\n    width: 34px; height: 34px; padding: 0;\n    display: flex; align-items: center; justify-content: center;\n    border: 1px solid rgba(5,46,87,.10); border-radius: 50%;\n    background: rgba(255,255,255,.85);\n    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);\n    box-shadow: 0 2px 8px rgba(0,0,0,.15);\n    color: var(--sr-acc); cursor: pointer;\n    transition: background .2s ease, transform .15s ease;\n    -webkit-tap-highlight-color: transparent; touch-action: manipulation;\n  }\n  .sr-avis .sr-nav svg { width: 17px; height: 17px; }\n  .sr-avis .sr-nav--prev { left: 20px; }\n  .sr-avis .sr-nav--next { right: 20px; }\n  .sr-avis .sr-nav:hover { background: #fff; }\n  .sr-avis .sr-nav:active { transform: translateY(-50%) scale(.93); }\n\n  @media (min-width: 750px) {\n    .sr-avis .sr-nav { top: 152px; width: 42px; height: 42px; }\n    .sr-avis .sr-nav svg { width: 20px; height: 20px; }\n    .sr-avis .sr-nav--prev { left: calc(max(16px, (100% - 1140px) / 2) + 12px); }\n    .sr-avis .sr-nav--next { right: calc(max(16px, (100% - 1140px) / 2) + 12px); }\n  }\n\n  /* CTA */\n  .sr-avis .sr-cta-wrap {\n    display: flex; width: 100%; max-width: 430px; margin: 14px auto 0;\n    flex-direction: column; align-items: center; padding: 0 16px;\n  }\n  .sr-avis .sr-cta {\n    display: flex; width: 100%; min-height: clamp(60px, 16vw, 64px);\n    padding: 10px 16px; align-items: center; justify-content: center;\n    flex-direction: column; gap: 5px; overflow: hidden;\n    border: none; border-radius: 10px; background: #FFD814;\n    box-shadow: 0 10px 24px rgba(0,0,0,.14);\n    color: #121212; text-align: center; text-decoration: none; text-transform: uppercase;\n    font-family: inherit; cursor: pointer;\n    transition: background .2s ease, transform .2s ease;\n    -webkit-tap-highlight-color: transparent; touch-action: manipulation;\n  }\n  .sr-avis .sr-cta:hover { background: #DBB911; transform: translateY(-1px); }\n  .sr-avis .sr-cta:active { background: #DBB911; transform: translateY(1px) scale(.99); }\n  .sr-avis .sr-cta span,\n  .sr-avis .sr-cta strong {\n    display: block; color: #121212;\n    font-size: clamp(15.5px, 4.3vw, 17px); line-height: 1.08;\n    font-weight: 700; letter-spacing: -0.2px;\n  }\n  .sr-avis .sr-cta strong { font-size: clamp(12px, 3.3vw, 13px); }\n\n  /* ===== OPTIMISATION MOBILE ===== */\n  @media (max-width: 749px) {\n    .sr-avis { padding: 3px 0 5px; }\n    .sr-avis .sr-rating { padding: 6px 12px; gap: 6px; }\n    .sr-avis .sr-rating .sr-stars { gap: 0; }\n    .sr-avis .sr-header { padding: 6px 14px 10px; }\n    .sr-avis .sr-sub { margin-top: 7px; }\n\n    .sr-avis .sr-track { gap: 12px; padding: 2px 12px 4px; }\n    .sr-avis .sr-card { width: 86vw; border-radius: 14px; }\n\n    .sr-avis .sr-content { padding: 14px 14px 16px; gap: 10px; }\n    .sr-avis .sr-head { gap: 8px; }\n    .sr-avis .sr-who { padding: 4px 8px; font-size: 12.5px; }\n    .sr-avis .sr-product { padding: 9px 10px; gap: 10px; height: 72px; }\n    .sr-avis .sr-product img { width: 50px; height: 50px; }\n    .sr-avis .sr-pname { font-size: 13px; }\n    .sr-avis .sr-price { font-size: 13.5px; }\n    .sr-avis .sr-date { font-size: 11px; }\n\n    .sr-avis .sr-cta-wrap { margin-top: 12px; max-width: 360px; padding: 0 14px; }\n  }\n</style><div class=\"sr-avis\">\n\n  <div class=\"sr-rating-wrap\">\n    <div class=\"sr-rating\">\n      <span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span>\n      <p><strong>4,8/5</strong><span class=\"sr-rating-sub\">bei 4.218 verifizierten Bewertungen</span></p>\n    </div>\n  </div>\n\n  <div class=\"sr-header\">\n    <h2 class=\"sr-title\">SCHLIESSEN SIE SICH ÜBER 80.000 <em>ERLEICHTERTEN RADFAHRERN AN.</em></h2>\n  </div>\n\n  <div class=\"sr-carousel\">\n    <button type=\"button\" class=\"sr-nav sr-nav--prev\" aria-label=\"Vorherige Bewertung\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>\n    </button>\n    <button type=\"button\" class=\"sr-nav sr-nav--next\" aria-label=\"Nächste Bewertung\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg>\n    </button>\n\n  <div class=\"sr-track\" id=\"mvTrack\">\n\n    <!-- ===== AVIS 1 — CLAUDE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '01_claude_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Klaus\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Klaus</strong>, 71 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Nach einer langen Pause wollte ich die Freude am Radfahren wiederfinden, ohne die Schmerzen zu fürchten. Mit meinem alten Sattel kamen die Beschwerden schon nach einer halben Stunde, und am Ende wurde jede Ausfahrt kürzer, als mir lieb war. Ich habe den Sport Pro gewählt, um langsam wieder anzufangen – mit einer Haltung, die zu meinen Touren passt.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Sport Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Feb. 2026</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 2 — MARTINE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '02_martine_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Martina\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Martina</strong>, 62 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Auf meinem E-Bike kamen die Taubheitsgefühle nach dreißig Minuten bis einer Stunde, trotz gepolsterter Radhose. Mir ging es vor allem darum, den Druck auf die empfindlichen Zonen zu verringern und meine Touren wieder zu genießen. Der Entlastungskanal und die Erklärungen zur Modellwahl haben mich zum Komfort Pro geführt.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"2er-Pack Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">2er-Pack · Komfort Pro</p><p class=\"sr-price\">89,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kundin seit Jan. 2026</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 3 — FRANÇOISE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '03_francoise_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Franziska\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Franziska</strong>, 64 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Mein Originalsattel war zu hart geworden, und die Schmerzen im Gesäß kamen schon in den ersten Minuten. Ich hatte es mit einem Gel-Sattelbezug versucht, ohne den gewünschten Komfort zu bekommen. Ich wollte einen richtigen Sattel für meine ruhigen kleinen Touren: die Form, die Polsterung und die Möglichkeit, ihn 30 Tage zu testen, haben mich überzeugt.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Komfort Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kundin seit Dez. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 4 — MICHEL ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '04_michel_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Michael\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Michael</strong>, 69 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Ich fahre regelmäßig länger als eine Stunde, und die Schmerzen an den Sitzknochen haben mir am Ende die langen Touren verdorben. Ich hatte schon mehrere Einstellungen probiert, eine gepolsterte Radhose und andere Sättel – ohne den richtigen zu finden. Ich suchte einen sportlichen Sattel, der die Druckpunkte verringert, ohne mir meine Pedalierposition zu nehmen.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Sport Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Okt. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 5 — DANIELLE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '05_danielle_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Daniela\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}<svg viewBox=\"0 0 24 24\" fill=\"#DCDCE6\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M11.5245 3.46353C11.6741 3.00287 12.3259 3.00287 12.4755 3.46353L14.1329 8.56434C14.1998 8.77035 14.3918 8.90983 14.6084 8.90983H19.9717C20.4561 8.90983 20.6575 9.52964 20.2656 9.81434L15.9266 12.9668C15.7514 13.0941 15.678 13.3198 15.745 13.5258L17.4023 18.6266C17.552 19.0873 17.0248 19.4704 16.6329 19.1857L12.2939 16.0332C12.1186 15.9059 11.8814 15.9059 11.7061 16.0332L7.3671 19.1857C6.97524 19.4704 6.448 19.0873 6.59768 18.6266L8.25503 13.5258C8.32197 13.3198 8.24864 13.0941 8.07339 12.9668L3.73438 9.81434C3.34253 9.52964 3.54392 8.90983 4.02828 8.90983H9.39159C9.6082 8.90983 9.80018 8.77035 9.86712 8.56434L11.5245 3.46353Z\"/></svg></span><span class=\"sr-who\"><strong>Daniela</strong>, 58 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Ich nutze mein Rad für die täglichen Wege und wollte einfach bequemer sitzen. Mit meinem alten Sattel habe ich die Stöße und den Druck nach fünfzehn bis dreißig Minuten gespürt. Der Komfort Pro passt gut zu meinem Einsatz in der Stadt; vier Sterne, weil er mir etwas breit vorkommt, wenn ich sportlicher fahre.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Komfort Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kundin seit März 2026</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 6 — JEAN-PIERRE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '06_jean-pierre_original.jpg' | asset_url }}\" alt=\"Bewertung von Hans-Peter\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Hans-Peter</strong>, 67 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Nach dreißig Minuten fing ich an, wegen der Schmerzen im Gesäß und am Steißbein hin und her zu rutschen. Ich hatte Höhe und Neigung schon verändert, ohne das Problem zu lösen. Mein Ziel war einfach: länger auf dem Rad bleiben und meine Touren beenden, ohne ständig an mein Sitzen zu denken. Deshalb habe ich den Komfort Pro genommen.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Komfort Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Nov. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 7 — GÉRARD ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '07_gerard_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Gerhard\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Gerhard</strong>, 66 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Nach einer Prostata-Operation wollte ich auf meinem E-Bike bequemer sitzen und den Druck auf die empfindlichen Zonen begrenzen. Selbst mit einem Sattel mit Entlastungskanal kamen die Beschwerden während der Fahrt zurück. Ich habe den Komfort Pro wegen seiner einladenderen Form gewählt, um mit mehr Gelassenheit wieder aufs Rad zu steigen.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Komfort Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Sept. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 8 — MONIQUE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '08_monique_original.jpg' | asset_url }}\" alt=\"Bewertung von Monika\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Monika</strong>, 70 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Ich bin nach einer langen Unterbrechung langsam wieder aufs Rad gestiegen, aber die Sitzbeschwerden kamen schnell zurück und nahmen mir die Lust, überhaupt loszufahren. Ich suchte vor allem einen Sattel, der mir Sicherheit gibt, um in meinem Tempo wieder kleine Touren zu fahren. Die Polsterung des Komfort Pro und die 30 Tage zum Testen haben meine letzten Zweifel genommen.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Komfort Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kundin seit Jan. 2026</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 9 — ALAIN ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '09_alain_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Armin\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Armin</strong>, 57 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Ich wollte mehr Kilometer fahren, vielleicht sogar ein ganzes Wochenende mit dem Rad unterwegs sein. Bisher haben mich die Schmerzen und die Taubheit nach einer Stunde dazu gebracht, auf längere Touren zu verzichten. Ich habe den Sport Pro gewählt, um eine dynamische Haltung zu behalten und trotzdem die Druckpunkte zu verringern – vor allem auf meinem E-Bike.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Sport Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Dez. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 10 — BERNARD ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '10_bernard_original.jpg' | asset_url }}\" alt=\"Bewertung von Bernhard\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Bernhard</strong>, 68 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Wir bereiten eine mehrtägige Radtour vor, und Komfort ist entscheidend geworden – gerade mit Gepäcktaschen und den vielen Stunden im Sattel. Meine Frau und ich hatten schon Gel-Sattelbezüge getestet, aber der Druck kam immer wieder zurück. Mit dem Doppelpack Komfort Pro konnten wir beide Räder vor der Abfahrt gleich ausstatten.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_komfort_pro.jpg' | asset_url }}\" alt=\"2er-Pack Sorelya Komfort Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">2er-Pack · Komfort Pro</p><p class=\"sr-price\">89,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Aug. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 11 — PATRICK ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '11_patrick_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Patrick\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}<svg viewBox=\"0 0 24 24\" fill=\"#DCDCE6\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M11.5245 3.46353C11.6741 3.00287 12.3259 3.00287 12.4755 3.46353L14.1329 8.56434C14.1998 8.77035 14.3918 8.90983 14.6084 8.90983H19.9717C20.4561 8.90983 20.6575 9.52964 20.2656 9.81434L15.9266 12.9668C15.7514 13.0941 15.678 13.3198 15.745 13.5258L17.4023 18.6266C17.552 19.0873 17.0248 19.4704 16.6329 19.1857L12.2939 16.0332C12.1186 15.9059 11.8814 15.9059 11.7061 16.0332L7.3671 19.1857C6.97524 19.4704 6.448 19.0873 6.59768 18.6266L8.25503 13.5258C8.32197 13.3198 8.24864 13.0941 8.07339 12.9668L3.73438 9.81434C3.34253 9.52964 3.54392 8.90983 4.02828 8.90983H9.39159C9.6082 8.90983 9.80018 8.77035 9.86712 8.56434L11.5245 3.46353Z\"/></svg></span><span class=\"sr-who\"><strong>Patrick</strong>, 63 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Ich habe bereits einen guten Fizik-Sattel, suche aber trotzdem etwas Besseres für meine MTB-Touren. Nach einer Stunde sind die Schmerzen im Gesäß und die Druckpunkte trotz guter Radhose weiterhin da. Die Erklärungen zum Sport Pro haben mich neugierig auf den Vergleich gemacht. Vorerst vier Sterne, weil mir noch der längere Eindruck fehlt.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Sport Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Nov. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 12 — SERGE ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '12_serge_original.jpg' | asset_url }}\" alt=\"Bewertung von Siegfried\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Siegfried</strong>, 72 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Ich fahre hauptsächlich Rennrad und bin regelmäßig länger als eine Stunde unterwegs. Ich suchte einen Sattel, der meine sportliche Haltung respektiert und zugleich die Schmerzen und Druckpunkte verringert, wenn die Distanz wächst. Der Sport Pro war genau das, was ich gesucht habe, um lange weiterzufahren, ohne mein Fahrgefühl aufzugeben.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"2er-Pack Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">2er-Pack · Sport Pro</p><p class=\"sr-price\">89,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Juli 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 13 — ANDRÉ ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '13_andre_sorelya.jpg' | asset_url }}\" alt=\"Bewertung von Andreas\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Andreas</strong>, 74 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Mit dem Alter und meinen Rückenproblemen wurden Ausfahrten von vier oder fünf Stunden schwierig. Ich wollte das Rennrad nicht aufgeben, sondern nur einen Sattel finden, der besser zu meiner Haltung und zu langen Distanzen passt. Die deutsche Fertigung, die Bewertungen von Radfahrern mit denselben Schmerzen und die 30 Tage zum Testen haben den Ausschlag gegeben.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Sport Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Juni 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n    <!-- ===== AVIS 14 — ROLAND ===== -->\n    <div class=\"sr-card\">\n      <div class=\"sr-media\">\n        <img src=\"{{ '14_roland_original.jpg' | asset_url }}\" alt=\"Bewertung von Roland\" width=\"360\" height=\"300\" loading=\"lazy\">\n      </div>\n      <div class=\"sr-content\">\n        <div class=\"sr-head\"><span class=\"sr-stars\">{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}{{ sr_svg1 }}</span><span class=\"sr-who\"><strong>Roland</strong>, 73 Jahre <span class=\"sr-ok\">{{ sr_svg2 }} Verifizierter Kauf</span></span></div>\n        <p class=\"sr-text\">Seit ich 10 Kilo abgenommen habe, sind Schmerzen aufgetreten, die ich vorher nie hatte. Mit 73 will ich weiter MTB fahren, ohne wegen des Sitzens anhalten zu müssen. Ich suchte einen Sattel, der sportlich bleibt und trotzdem die empfindlichen Zonen entlastet: Das hat mich überzeugt, den Sport Pro zu probieren.</p>\n        <a class=\"sr-product\" href=\"/products/sorelya-comfortride-pro\">\n          <img src=\"{{ 'sorelya_sport_pro.jpg' | asset_url }}\" alt=\"Sorelya Sport Pro\" width=\"56\" height=\"56\" loading=\"lazy\">\n          <span class=\"sr-pinfo\"><p class=\"sr-pname\">Sorelya Sport Pro</p><p class=\"sr-price\">59,99 € <s>119,99 €</s></p><p class=\"sr-date\">{{ sr_svg3 }} Kunde seit Nov. 2025</p></span>\n        </a>\n      </div>\n    </div>\n\n  </div>\n  </div>\n\n  <div class=\"sr-cta-wrap\">\n    <button type=\"button\" class=\"sr-cta\" onclick=\"mvRemonterAchat()\">\n      <span>ICH WILL OHNE SCHMERZEN FAHREN</span>\n      <strong>30 TAGE ZUM TESTEN</strong>\n    </button>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var track = document.getElementById('mvTrack');\n    if (!track) return;\n\n    var originals = Array.prototype.slice.call(track.children);\n    var count = originals.length;\n    if (!count) return;\n\n    /* Boucle infinie : on clone la série complète avant et après.\n       Le carrousel avance donc toujours vers l'avant, sans retour visible. */\n    var avant = document.createDocumentFragment();\n    var apres = document.createDocumentFragment();\n    originals.forEach(function (c) { apres.appendChild(c.cloneNode(true)); });\n    originals.forEach(function (c) { avant.appendChild(c.cloneNode(true)); });\n    track.appendChild(apres);\n    track.insertBefore(avant, track.firstChild);\n\n    function ecart() {\n      var st = window.getComputedStyle(track);\n      return parseFloat(st.columnGap || st.gap) || 18;\n    }\n    function pas() {\n      var c = track.querySelector('.sr-card');\n      return c ? c.getBoundingClientRect().width + ecart() : 340;\n    }\n    function largeurSerie() { return pas() * count; }\n\n    /* Repositionnement silencieux.\n       On ne touche PAS à scroll-snap-type : le rebasculer forçait le\n       navigateur à recalculer l'ancrage et renvoyait au premier avis\n       (et provoquait le tremblement). Un drapeau évite que notre propre\n       correction relance le cycle. */\n    var enCorrection = false;\n    function recentrer(x) {\n      enCorrection = true;\n      var comportement = track.style.scrollBehavior;\n      track.style.scrollBehavior = 'auto';\n      track.scrollLeft = x;\n      track.style.scrollBehavior = comportement;\n      requestAnimationFrame(function () {\n        requestAnimationFrame(function () { enCorrection = false; });\n      });\n    }\n\n    /* On démarre sur la série du milieu */\n    recentrer(largeurSerie());\n\n    /* Flèches : un avis par clic. La boucle infinie s'occupe du reste. */\n    function defiler(sens) {\n      enCorrection = false;\n      track.scrollBy({ left: sens * pas(), behavior: 'smooth' });\n    }\n    var zoneNav = track.parentNode;\n    var btnPrev = zoneNav.querySelector('.sr-nav--prev');\n    var btnNext = zoneNav.querySelector('.sr-nav--next');\n    if (btnPrev) btnPrev.addEventListener('click', function () { defiler(-1); });\n    if (btnNext) btnNext.addEventListener('click', function () { defiler(1); });\n\n    /* On ramène la position dans la série du milieu seulement quand on\n       s'est vraiment éloigné : le contenu étant identique, c'est invisible. */\n    function normaliser() {\n      var w = largeurSerie();\n      var x = track.scrollLeft;\n      if (x < w * 0.5) recentrer(x + w);\n      else if (x > w * 1.5) recentrer(x - w);\n    }\n\n    /* Aide au swipe : une fois le doigt relâché et l'inertie terminée,\n       on termine le mouvement sur l'avis le plus proche pour ne jamais\n       rester bloqué entre deux cartes. */\n    var finCalage;\n    function caler() {\n      var zone = track.getBoundingClientRect();\n      var centreZone = zone.left + zone.width / 2;\n      var cartes = track.children;\n      var meilleure = null;\n      var ecartMin = Infinity;\n\n      for (var i = 0; i < cartes.length; i++) {\n        var c = cartes[i].getBoundingClientRect();\n        var d = (c.left + c.width / 2) - centreZone;\n        if (Math.abs(d) < Math.abs(ecartMin)) { ecartMin = d; meilleure = cartes[i]; }\n      }\n      if (!meilleure || Math.abs(ecartMin) < 2) return;\n\n      enCorrection = true;\n      track.scrollTo({ left: track.scrollLeft + ecartMin, behavior: 'smooth' });\n      clearTimeout(finCalage);\n      finCalage = setTimeout(function () { enCorrection = false; }, 500);\n    }\n\n    var minuteur;\n    track.addEventListener('scroll', function () {\n      if (enCorrection) return;\n      clearTimeout(minuteur);\n      minuteur = setTimeout(function () { normaliser(); caler(); }, 180);\n    }, { passive: true });\n\n    /* Rotation d'écran uniquement : on ignore les changements de hauteur\n       (barre d'adresse mobile) et on conserve l'avis affiché. */\n    var largeurFenetre = window.innerWidth;\n    var redim;\n    window.addEventListener('resize', function () {\n      if (window.innerWidth === largeurFenetre) return;\n      var index = Math.round(track.scrollLeft / pas());\n      largeurFenetre = window.innerWidth;\n      clearTimeout(redim);\n      redim = setTimeout(function () {\n        recentrer(index * pas());\n        normaliser();\n      }, 250);\n    });\n\n  })();\n\n  /* ============================================================\n     Remontée vers le bloc d'achat (badges 30J + Hergestellt in Deutschland)\n     Décalage sous un en-tête collant : modifier DECALAGE si besoin.\n     ============================================================ */\n  function mvRemonterAchat() {\n    var DECALAGE = 90; /* hauteur de l'en-tête collant — ajuster si besoin */\n\n    var cible =\n      document.querySelector('.sorelya-conversion-block') ||\n      document.getElementById('sr-achat') ||\n      document.querySelector('form[action*=\"/cart/add\"]');\n\n    if (!cible) { window.scrollTo({ top: 0, behavior: 'smooth' }); return; }\n\n    var y = cible.getBoundingClientRect().top + window.pageYOffset - DECALAGE;\n    window.scrollTo({ top: y < 0 ? 0 : y, behavior: 'smooth' });\n  }\n</script>\n  </div>\n</div>\n\n\n</section>",
