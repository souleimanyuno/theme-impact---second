g src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/pupbowl-brand3_430x.png?v=1782476806\" alt=\"Brand\" loading=\"lazy\">\n        </div>\n        <div class=\"logo-bar__item\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0992/0384/2370/files/pupbowl-akc_430x.png?v=1782476807\" alt=\"American Kennel Club\" loading=\"lazy\">\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>",
