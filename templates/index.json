            "liquid": "<style>\n  /* SORELYA — espacements mobiles (mesurés sur la page en 375 px) */\n  @media screen and (max-width: 999px) {\n    /* Impact met 48px sous la colonne produit avant les blocs du bas : on les retire (écart case verte → bundle = 12px) */\n    .shopify-section--main-product > .section { padding-bottom: 0 !important; }\n  }\n  @media screen and (max-width: 749px) {\n    .sorelya-social-proof { margin-inline: -16px !important; }                 /* 4px des bords */\n    .sorelya-rating-row { margin-inline: -17px !important; width: auto !important;  /* 3px des bords, une seule ligne */\n      flex-wrap: nowrap !important; white-space: nowrap !important; gap: 6px !important; justify-content: center !important; }\n    .sorelya-rating-group { gap: 5px !important; flex-wrap: nowrap !important; }\n    .sorelya-rating-excellent { font-size: clamp(11px, 3.55vw, 14px) !important; }\n    .sorelya-rating-stars-img { height: clamp(14px, 4.3vw, 18px) !important; width: auto !important; display: block; }\n    .sorelya-rating-text, .sorelya-rating-text strong, .sorelya-rating-sub { font-size: clamp(10.5px, 3.3vw, 13px) !important; }\n    .sorelya-best-badge { padding: 8px 16px !important; gap: 8px !important; font-size: clamp(9.5px, 2.95vw, 11.5px) !important; }\n  }\n  .sorelya-rating-stars-img { height: 18px; width: auto; display: block; }\n</style>\n<style>\n      /* ============================================================\n         BLOC CONVERSION — au-dessus du bouton d'ajout au panier\n\n         Largeurs vérifiées au pixel sur Poppins :\n         chaque argument tient sur UNE ligne jusqu'à un écran de\n         360 px. La ligne de preuve sociale tient sur DEUX lignes.\n         La ligne de note tient sur UNE ligne dès 320 px.\n         Lisibilité : rien sous 13 px, arguments à 14,5 px.\n         ============================================================ */\n\n      .sorelya-conversion-block {\n        width: 100%;\n        margin: 12px 0 10px;\n        font-family: Poppins, Arial, sans-serif;\n        color: #111111;\n      }\n\n      .sorelya-conversion-block *,\n      .sorelya-conversion-block *::before,\n      .sorelya-conversion-block *::after {\n        box-sizing: border-box;\n      }\n\n      /* ===== PREUVE SOCIALE ===== */\n      .sorelya-social-proof {\n        display: flex;\n        align-items: center;\n        gap: 11px;\n        margin-bottom: 12px;\n      }\n\n      .sorelya-cyclists-image-wrap {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        flex: 0 0 auto;\n        width: 86px;\n        min-width: 86px;\n      }\n\n      .sorelya-cyclists-image {\n        display: block;\n        width: 86px;\n        height: auto;\n        max-width: 100%;\n        object-fit: contain;\n      }\n\n      .sorelya-social-text {\n        flex: 1;\n        min-width: 0;\n        margin: 0;\n        color: #292929;\n        font-size: 14px;\n        line-height: 1.42;\n        font-weight: 500;\n      }\n\n      .sorelya-social-text strong {\n        color: #111111;\n        font-weight: 700;\n      }\n\n      /* ===== BADGE ===== */\n      .sorelya-best-badge-wrap {\n        display: flex;\n        justify-content: center;\n        margin: 0 0 12px;\n      }\n\n      .sorelya-best-badge {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        gap: 8px;\n        max-width: 100%;\n        padding: 8px 14px;\n        background: #f3f3f3;\n        border: 1px solid #e9e9e9;\n        border-radius: 999px;\n        color: #111111;\n        font-size: 11.5px;\n        line-height: 1;\n        font-weight: 700;\n        text-align: center;\n        text-transform: uppercase;\n        white-space: nowrap;\n      }\n\n      .sorelya-de-flag {\n        display: inline-flex;\n        flex-direction: column;\n        flex: 0 0 22px;\n        width: 22px;\n        height: 15px;\n        overflow: hidden;\n        border: 1px solid rgba(0,0,0,.08);\n        border-radius: 2px;\n      }\n\n      .sorelya-de-flag span { flex: 1; width: 100%; }\n      .sorelya-de-flag span:nth-child(1) { background:#000000; }\n      .sorelya-de-flag span:nth-child(2) { background:#DD0000; }\n      .sorelya-de-flag span:nth-child(3) { background:#FFCE00; }\n\n      /* ===== NOTE CLIENTS =====\n         Tout tient sur UNE ligne : nowrap sur la rangée et tailles\n         en clamp() pour que l'ensemble se réduise avec l'écran\n         au lieu de passer à la ligne. */\n      .sorelya-rating-row {\n        display: flex;\n        align-items: center;\n        align-content: center;\n        justify-content: center;\n        flex-wrap: nowrap;\n        gap: 7px;\n        margin-bottom: 14px;\n        width: 100%;\n        min-width: 0;\n        white-space: nowrap;\n        line-height: 1;\n      }\n\n      .sorelya-rating-group {\n        display: inline-flex;\n        align-items: center;\n        gap: 6px;\n        flex: 0 0 auto;\n        white-space: nowrap;\n        line-height: 1;\n      }\n\n      .sorelya-rating-excellent {\n        display: inline-flex;\n        align-items: center;\n        height: clamp(15px, 4.6vw, 20px);\n        color: #111111;\n        font-size: clamp(12.5px, 3.85vw, 16px);\n        line-height: 1;\n        font-weight: 700;\n      }\n\n      .sorelya-rating-stars {\n        display: inline-flex;\n        align-items: center;\n        gap: 3px;\n        flex: 0 0 auto;\n        line-height: 0;\n      }\n\n      .sorelya-rating-star {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        flex: 0 0 auto;\n        width: clamp(15px, 4.6vw, 20px);\n        height: clamp(15px, 4.6vw, 20px);\n        background: #00b67a;\n      }\n\n      .sorelya-rating-star svg {\n        display: block;\n        width: 62%;\n        height: 62%;\n        fill: #ffffff;\n      }\n\n      .sorelya-rating-text {\n        display: inline-flex;\n        align-items: center;\n        height: clamp(15px, 4.6vw, 20px);\n        color: #111111;\n        font-size: clamp(11.5px, 3.55vw, 14.5px);\n        line-height: 1;\n        font-weight: 500;\n        white-space: nowrap;\n        flex: 0 0 auto;\n      }\n\n      .sorelya-rating-text strong {\n        color: #111111;\n        font-weight: 700;\n      }\n\n      /* espace franc entre la note et le nombre d'avis */\n      .sorelya-rating-sub {\n        margin-left: 5px;\n      }\n\n      /* ===== ARGUMENTS ===== */\n      .sorelya-benefits-grid {\n        display: flex;\n        flex-direction: column;\n        gap: 11px;\n        width: 100%;\n      }\n\n      .sorelya-benefit-item {\n        display: flex;\n        align-items: center;\n        gap: 9px;\n        width: 100%;\n      }\n\n      .sorelya-benefit-check {\n        display: inline-flex;\n        align-items: center;\n        justify-content: center;\n        flex: 0 0 21px;\n        width: 21px;\n        height: 21px;\n        background: #08aaa3;\n        border-radius: 50%;\n      }\n\n      .sorelya-benefit-check svg {\n        display: block;\n        width: 11px;\n        height: 11px;\n        fill: none;\n        stroke: #ffffff;\n        stroke-width: 3.2;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n      }\n\n      .sorelya-benefit-flag {\n        display: inline-flex;\n        flex-direction: column;\n        flex: 0 0 21px;\n        width: 21px;\n        height: 21px;\n        overflow: hidden;\n        border: 1px solid rgba(0,0,0,.1);\n        border-radius: 50%;\n      }\n\n      .sorelya-benefit-flag span { flex: 1; width: 100%; }\n      .sorelya-benefit-flag span:nth-child(1) { background:#000000; }\n      .sorelya-benefit-flag span:nth-child(2) { background:#DD0000; }\n      .sorelya-benefit-flag span:nth-child(3) { background:#FFCE00; }\n\n      .sorelya-benefit-item p {\n        flex: 1;\n        min-width: 0;\n        margin: 0;\n        color: #111111;\n        font-size: 15px;\n        line-height: 1.34;\n        font-weight: 600;\n        letter-spacing: -0.1px;\n        text-align: left;\n      }\n\n      .sorelya-benefit-item strong { font-weight: 700; }\n\n      /* ===== MOBILE ===== */\n      @media screen and (max-width:749px) {\n\n        .sorelya-conversion-block { margin: 9px 0 7px; }\n\n        .sorelya-social-proof { gap: 10px; margin-bottom: 11px; }\n\n        .sorelya-cyclists-image-wrap { width: 76px; min-width: 76px; }\n        .sorelya-cyclists-image { width: 76px; }\n\n        .sorelya-social-text { font-size: 13.5px; }\n\n        .sorelya-best-badge-wrap { margin-bottom: 11px; }\n\n        .sorelya-best-badge {\n          gap: 7px;\n          padding: 8px 12px;\n          font-size: 11px;\n        }\n\n        .sorelya-de-flag { flex-basis: 20px; width: 20px; height: 14px; }\n\n        /* La rangée de note garde ses clamp() : aucune taille fixe\n           ici, sinon elle repasserait sur deux lignes. */\n        .sorelya-rating-row { gap: 6px; margin-bottom: 13px; }\n        .sorelya-rating-group { gap: 5px; }\n\n        .sorelya-benefits-grid { gap: 10px; }\n        .sorelya-benefit-item { gap: 8px; }\n\n        .sorelya-benefit-check,\n        .sorelya-benefit-flag {\n          flex: 0 0 19px;\n          width: 19px;\n          height: 19px;\n        }\n\n        .sorelya-benefit-check svg { width: 10px; height: 10px; }\n\n        .sorelya-benefit-item p {\n          font-size: 14.5px;\n          line-height: 1.32;\n        }\n\n        .sorelya-protection-card {\n          margin-top: 13px;\n          padding: 11px 7px;\n          border-radius: 12px;\n        }\n\n        .sorelya-protection-label {\n          gap: 6px;\n          margin-bottom: 9px;\n          font-size: 10px;\n          letter-spacing: 1.05px;\n        }\n\n        .sorelya-protection-label::before,\n        .sorelya-protection-label::after { width: 17px; }\n\n\n        .sorelya-protection-item { justify-content: flex-start; 