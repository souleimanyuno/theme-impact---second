            "liquid": "<style>\n  .tnx-v2-countdown {\n    display: grid;\n    grid-template-columns: minmax(58px, auto) auto minmax(58px, auto) auto minmax(58px, auto) auto minmax(58px, auto);\n    column-gap: 14px;\n    row-gap: 8px;\n    justify-items: center;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    margin: 16px 0;\n    background: transparent;\n    font-family: inherit;\n  }\n  .tnx-v2-countdown-number {\n    grid-row: 1;\n    font-size: 46px;\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: 3px;\n    color: #111111;\n  }\n  .tnx-v2-countdown-separator {\n    grid-row: 1;\n    font-size: 42px;\n    font-weight: 700;\n    line-height: 1;\n    color: #111111;\n  }\n  .tnx-v2-countdown-label {\n    grid-row: 2;\n    font-size: 14px;\n    font-weight: 600;\n    letter-spacing: 1.6px;\n    color: #6b7280;\n    text-transform: uppercase;\n  }\n  .tnx-v2-countdown .d1 { grid-column: 1; }\n  .tnx-v2-countdown .s1 { grid-column: 2; }\n  .tnx-v2-countdown .d2 { grid-column: 3; }\n  .tnx-v2-countdown .s2 { grid-column: 4; }\n  .tnx-v2-countdown .d3 { grid-column: 5; }\n  .tnx-v2-countdown .s3 { grid-column: 6; }\n  .tnx-v2-countdown .d4 { grid-column: 7; }\n  .tnx-v2-countdown .l1 { grid-column: 1; }\n  .tnx-v2-countdown .l2 { grid-column: 3; }\n  .tnx-v2-countdown .l3 { grid-column: 5; }\n  .tnx-v2-countdown .l4 { grid-column: 7; }\n  @media (max-width: 480px) {\n    .tnx-v2-countdown {\n      column-gap: 10px;\n      row-gap: 6px;\n    }\n    .tnx-v2-countdown-number {\n      font-size: 36px;\n      letter-spacing: 2px;\n    }\n    .tnx-v2-countdown-separator {\n      font-size: 34px;\n    }\n    .tnx-v2-countdown-label {\n      font-size: 12px;\n      letter-spacing: 1.1px;\n    }\n  }\n</style>\n<script>\n  (function() {\n    const daysEl = document.getElementById('tnx-v2-days');\n    const hoursEl = document.getElementById('tnx-v2-hours');\n    const minutesEl = document.getElementById('tnx-v2-minutes');\n    const secondsEl = document.getElementById('tnx-v2-seconds');\n    if (!daysEl || !hoursEl || !minutesEl || !secondsEl) return;\n    const TIMER_DURATION = 25 * 60 * 1000;\n    const STORAGE_KEY = 'bf_countdown_timer_end_time_fr';\n    function pad(num) {\n      return String(num).padStart(2, '0');\n    }\n    function getSavedEndTime() {\n      const now = Date.now();\n      let savedEndTime = localStorage.getItem(STORAGE_KEY);\n      if (!savedEndTime || Number(savedEndTime) <= now) {\n        savedEndTime = now + TIMER_DURATION;\n        localStorage.setItem(STORAGE_KEY, savedEndTime);\n      }\n      return Number(savedEndTime);\n    }\n    let endTime = getSavedEndTime();\n    function updateTimer() {\n      const now = Date.now();\n      let remaining = Math.floor((endTime - now) / 1000);\n      if (remaining <= 0) {\n        endTime = Date.now() + TIMER_DURATION;\n        localStorage.setItem(STORAGE_KEY, endTime);\n        remaining = Math.floor((endTime - Date.now()) / 1000);\n      }\n      const days = Math.floor(remaining / 86400);\n      const hours = Math.floor((remaining % 86400) / 3600);\n      const minutes = Math.floor((remaining % 3600) / 60);\n      const seconds = remaining % 60;\n      daysEl.textContent = pad(days);\n      hoursEl.textContent = pad(hours);\n      minutesEl.textContent = pad(minutes);\n      secondsEl.textContent = pad(seconds);\n    }\n    updateTimer();\n    setInterval(updateTimer, 1000);\n  })();\n</script>\n<div style=\"\n  position:relative;\n  margin:0 0 12px;\n  z-index:3;\n  display:flex;\n  justify-content:center;\n  align-items:center;\n  gap:5px;\n  width:100%;\n  flex-wrap:nowrap;\n  white-space:nowrap;\n\">\n\n  <!-- 30 T. Geld-zurück-Garantie -->\n  <div style=\"\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    min-height:20px;\n    background:#e0ffd8;\n    color:#004d00;\n    padding:2px 5px;\n    border-radius:3px;\n    font-size:9px;\n    line-height:1;\n    font-weight:700;\n    white-space:nowrap;\n    flex-shrink:1;\n  \">\n    <svg\n      viewBox=\"0 0 24 24\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      style=\"\n        width:11px;\n        height:11px;\n        margin-right:3px;\n        flex-shrink:0;\n      \"\n    >\n      <path\n        fill=\"#004d00\"\n        d=\"M12 2C9.24 2 7 4.24 7 7V10H5C3.9 10 3 10.9 3 12V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V12C21 10.9 20.1 10 19 10H17V7C17 4.24 14.76 2 12 2M12 4C13.66 4 15 5.34 15 7V10H9V7C9 5.34 10.34 4 12 4M12 12C13.1 12 14 12.9 14 14C14 15.1 13.1 16 12 16C10.9 16 10 15.1 10 14C10 12.9 10.9 12 12 12Z\"\n      ></path>\n    </svg>\n\n    30 T. Geld-zurück-Garantie\n  </div>\n\n  <!-- Hergestellt in Deutschland -->\n  <div style=\"\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    min-height:20px;\n    background:#eef4fb;\n    color:#052e57;\n    padding:2px 5px;\n    border:1px solid rgba(5,46,87,0.12);\n    border-radius:3px;\n    font-size:9px;\n    line-height:1;\n    font-weight:700;\n    white-space:nowrap;\n    flex-shrink:1;\n  \">\n\n    <span\n      aria-label=\"Deutsche Flagge\"\n      style=\"\n        width:14px;\n        height:10px;\n        margin-right:3px;\n        display:flex;\n        flex-direction:column;\n        overflow:hidden;\n        border-radius:2px;\n        box-shadow:0 0 0 1px rgba(0,0,0,0.10);\n        flex-shrink:0;\n      \"\n    >\n      <span style=\"width:100%; height:33.33%; background:#000000;\"></span>\n      <span style=\"width:100%; height:33.33%; background:#DD0000;\"></span>\n      <span style=\"width:100%; height:33.34%; background:#FFCE00;\"></span>\n    </span>\n\n    Hergestellt in Deutschland\n  </div>\n\n</div>"
