    [/^(?:processed|sorted|scanned)\s+(?:at|in)\s+(?:the\s+)?(.+)$/i, function (m) { return avec('Votre colis a été trié dans un centre de tri.', 'Votre colis a été trié {à L}.', m[1]); }],
    /* Arrivées et départs génériques */
    [/^(?:arrived|arrival)\s+(?:at|in)\s+(?:the\s+)?(.+)$/i, function (m) { return avec('Votre colis est arrivé à une nouvelle étape de son trajet.', 'Votre colis est arrivé {à L}.', m[1]); }],
    [/^(?:departed|departure|left)\s+(?:from\s+|in\s+|at\s+)?(?:the\s+)?(.+)$/i, function (m) { return avec('Votre colis poursuit sa route.', 'Votre colis a quitté {L} et poursuit sa route.', m[1]); }],
